          <mxGeometry height="1130" width="1080" as="geometry" />
        </mxCell>
        <mxCell id="x-lane-a" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fff0f0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="PŁYTKA A: master 00 (właściciel watcha, czyta zdalne urządzenie)" vertex="1">
          <mxGeometry height="290" width="890" x="10" y="60" as="geometry" />
        </mxCell>
        <mxCell id="x-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4fbe6;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="PŁYTKA B: slave 01 (uruchamia watch, ma urządzenie)" vertex="1">
          <mxGeometry height="380" width="890" x="10" y="400" as="geometry" />
        </mxCell>
        <mxCell id="x-alias" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="urządzenie zdalne&lt;br&gt;(sys_remote)&lt;br&gt;id 23 → płytka 01, id 7" vertex="1">
