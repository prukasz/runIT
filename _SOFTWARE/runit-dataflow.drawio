          <mxGeometry height="70" width="120" x="210" y="105" as="geometry" />
        </mxCell>
        <mxCell id="q-n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="ring routera&lt;br&gt;&lt;b&gt;KOLEJKA&lt;/b&gt;" vertex="1">
