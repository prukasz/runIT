        <mxCell id="o-router" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Router&lt;/b&gt;&lt;br&gt;klucz → moduł,&lt;br&gt;dwa taski" vertex="1"><mxGeometry height="80" width="150" x="840" y="170" as="geometry" /></mxCell>
        <mxCell id="o-mod" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Moduły&lt;/b&gt;&lt;br&gt;urządzenia, VM, system, I2C, …&lt;br&gt;wykonują komendę" vertex="1"><mxGeometry height="80" width="200" x="1080" y="170" as="geometry" /></mxCell>
        <mxCell id="o-bind" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Binding komend&lt;/b&gt;: klient bez sesji" vertex="1"><mxGeometry height="45" width="150" x="360" y="95" as="geometry" /></mxCell>
        <mxCell id="o-dead" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Dead-man, GONE&lt;/b&gt;&lt;br&gt;koniec sesji → stan&lt;br&gt;bezpieczny, sprzątanie" vertex="1"><mxGeometry height="80" width="180" x="360" y="320" as="geometry" /></mxCell>
        <mxCell id="o-watch" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Watch&lt;/b&gt;&lt;br&gt;odczyt robiony przez&lt;br&gt;płytkę według wyzwalacza" vertex="1"><mxGeometry height="80" width="150" x="840" y="320" as="geometry" /></mxCell>
        <mxCell id="o-stream" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Stream&lt;/b&gt;&lt;br&gt;dane w jedną stronę: logi, błędy,&lt;br&gt;telemetria, zdarzenia, mosty" vertex="1"><mxGeometry height="80" width="200" x="1080" y="320" as="geometry" /></mxCell>
        <mxCell id="o-call" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;Wywołanie płytki&lt;/b&gt;&lt;br&gt;sys_session_call:&lt;br&gt;komenda do innej płytki" vertex="1"><mxGeometry height="80" width="150" x="840" y="470" as="geometry" /></mxCell>
        <mxCell id="o-remote" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Urządzenie zdalne&lt;/b&gt;&lt;br&gt;alias urządzenia innej płytki&lt;br&gt;(sys_remote, klient watchy)" vertex="1"><mxGeometry height="80" width="200" x="1080" y="470" as="geometry" /></mxCell>
