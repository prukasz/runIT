        <mxCell id="o-lane-a" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fff8f0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="Przepływ: kto z kim rozmawia" vertex="1"><mxGeometry height="540" width="1300" x="10" y="60" as="geometry" /></mxCell>
