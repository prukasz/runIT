        <mxCell id="o-e9" edge="1" parent="1" source="o-bind" target="o-router" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="[key][dir][code] → [status][data]"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="117" /></Array></mxGeometry></mxCell>
        <mxCell id="o-e10" edge="1" parent="1" source="o-ses" target="o-dead" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="cisza, koniec sesji"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="594" y="285" /><mxPoint x="450" y="285" /></Array></mxGeometry></mxCell>
        <mxCell id="o-e11" edge="1" parent="1" source="o-watch" target="o-router" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="router_inject (odczyt)"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o-e12" edge="1" parent="1" source="o-watch" target="o-ses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.82;entryY=1;entryDx=0;entryDy=0;" value="kanał 0x80: wpis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="699" y="360" /></Array></mxGeometry></mxCell>
        <mxCell id="o-e13" edge="1" parent="1" source="o-mod" target="o-stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="sys_stream_send"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o-e14" edge="1" parent="1" source="o-stream" target="o-ses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.59;entryY=1;entryDx=0;entryDy=0;" value="PUSH [id][payload] do subskrybentów"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="430" /><mxPoint x="660" y="430" /></Array></mxGeometry></mxCell>
        <mxCell id="o-e15" edge="1" parent="1" source="o-remote" target="o-call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="zapis, odczyt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o-e16" edge="1" parent="1" source="o-call" target="o-ses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;" value="REQUEST / ANSWER"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="619" y="510" /></Array></mxGeometry></mxCell>
        <mxCell id="o-e17" edge="1" parent="1" source="o-flash" target="o-link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="BOOT, EN, UART łącza"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="510" /></Array></mxGeometry></mxCell>
        <mxCell id="o-legend" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;czarne&lt;/b&gt;: komenda od klienta i jej odpowiedź &amp;nbsp; &lt;b&gt;pomarańczowe&lt;/b&gt;: płytka wysyła sama (streamy, watche) &amp;nbsp; &lt;b&gt;niebieskie&lt;/b&gt;: płytka woła inną płytkę &amp;nbsp; &lt;b&gt;czerwone&lt;/b&gt;: koniec sesji" vertex="1"><mxGeometry height="24" width="1260" x="30" y="565" as="geometry" /></mxCell>
        <mxCell id="o-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fffdf0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="Cztery rodzaje ramek sesji (nagłówek 5 B: [frame][dst][src][seq u16])" vertex="1"><mxGeometry height="150" width="1300" x="10" y="620" as="geometry" /></mxCell>
        <mxCell id="o-k0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;REQUEST&lt;/b&gt;&lt;br&gt;komenda dla dst; odpowiedź wraca do src, z tym samym seq" vertex="1"><mxGeometry height="90" width="300" x="30" y="660" as="geometry" /></mxCell>
        <mxCell id="o-k1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;ANSWER&lt;/b&gt;&lt;br&gt;OK z danymi albo ERROR z rekordem błędu" vertex="1"><mxGeometry height="90" width="300" x="345" y="660" as="geometry" /></mxCell>
        <mxCell id="o-k2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;PUSH&lt;/b&gt; [id][…]: płytka wysyła sama, bez odpowiedzi&lt;br&gt;&amp;lt; 0x80 stream &amp;nbsp;·&amp;nbsp; 0x80 wpis watcha&lt;br&gt;0x81 zdarzenie urządzenia zdalnego &amp;nbsp;·&amp;nbsp; 0x82 dane dla providera" vertex="1"><mxGeometry height="90" width="300" x="660" y="660" as="geometry" /></mxCell>
        <mxCell id="o-k3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;CONTROL&lt;/b&gt;&lt;br&gt;HELLO, PING, NO_SESSION, GONE: obsługuje sama sesja, także przed otwarciem" vertex="1"><mxGeometry height="90" width="315" x="975" y="660" as="geometry" /></mxCell>
        <mxCell id="o-lane-c" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4fbe6;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="Elementy: czym są i za co odpowiadają" vertex="1"><mxGeometry height="660" width="1300" x="10" y="790" as="geometry" /></mxCell>
        <mxCell id="o-table" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px;width:1250px'&gt;&lt;tr&gt;&lt;th style='width:130px'&gt;element&lt;/th&gt;&lt;th style='width:260px'&gt;czym jest&lt;/th&gt;&lt;th&gt;za co odpowiada&lt;/th&gt;&lt;th style='width:250px'&gt;czego nie robi&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Provider&lt;/b&gt;&lt;/td&gt;&lt;td&gt;jedna droga bajtów: charakterystyka BLE, port UART; id 1 B&lt;/td&gt;&lt;td&gt;wysyła ramkę po id (driver kolejkuje, dzieli i skleja); to, co przyszło, oddaje jednemu odbiorcy: sesji, bindingowi streamu IN albo bindingowi komend&lt;/td&gt;&lt;td&gt;nie zna peerów, komend ani streamów&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Sesja&lt;/b&gt;&lt;/td&gt;&lt;td&gt;połączenie z sąsiadem na providerze: master, slave albo klient (APP)&lt;/td&gt;&lt;td&gt;HELLO i PING, timeout ciszy; nagłówek [frame][dst][src][seq]; trasa po dst w gwieździe (root przekazuje tylko między klientem a slave'em); REQUEST do routera, ANSWER do źródła, PUSH i kanały do peera; wywołania płytki; mówi, kto odszedł&lt;/td&gt;&lt;td&gt;nie ma tasku ani kolejki; nie wykonuje komend; rola nie jest z builda: HELLO płytki na drodze klienta robi z niej mastera&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Router&lt;/b&gt;&lt;/td&gt;&lt;td&gt;rozdzielnik komend [key][dir][code][args]&lt;/td&gt;&lt;td&gt;kolejkuje do taska pilnego albo zwykłego, wybiera moduł po kluczu, oddaje odpowiedź przez done; tap widzi każdą komendę&lt;/td&gt;&lt;td&gt;nie zna nadawcy ani łącza&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Moduł, urządzenie&lt;/b&gt;&lt;/td&gt;&lt;td&gt;sys_*, urządzenia (sys_device), VM&lt;/td&gt;&lt;td&gt;wykonuje komendę i odpowiada raz; publikuje dane do streamów&lt;/td&gt;&lt;td&gt;nie wysyła ramek sam&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Stream&lt;/b&gt;&lt;/td&gt;&lt;td&gt;nazwany strumień danych w jedną stronę: id 1 B, OUT albo IN&lt;/td&gt;&lt;td&gt;jedna lista celów: provider, peer (subskrybent), callback, output, remote; kolejka i task, wysyłanie NOWAIT, zgubione liczy dropped&lt;/td&gt;&lt;td&gt;nic nie przechowuje; nie niesie komend ani odpowiedzi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Kanał sesji&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ramka PUSH z pierwszym bajtem od 0x80&lt;/td&gt;&lt;td&gt;jeden nadawca do jednego peera: 0x80 wpisy watchy, 0x81 zdarzenia i błędy urządzeń zdalnych, 0x82 dane dla providera&lt;/td&gt;&lt;td&gt;nie ma kolejki, subskrybentów ani komend streamu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Watch&lt;/b&gt;&lt;/td&gt;&lt;td&gt;odczyt, który płytka robi sama&lt;/td&gt;&lt;td&gt;wyzwalacz PERIODIC, ON_CHANGE albo ON_EVENT; odczyt przez router_inject; wpis idzie do właściciela kanałem 0x80; znika, gdy właściciel odchodzi&lt;/td&gt;&lt;td&gt;nie trzyma historii: niewysłany wpis przepada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Wywołanie płytki&lt;/b&gt;&lt;/td&gt;&lt;td&gt;komenda płytki do innej płytki albo do siebie (sys_session_call)&lt;/td&gt;&lt;td&gt;slot do odpowiedzi, timeout (50 ms po kablu, 1 s inaczej), ERR_SESSION_PEER_DOWN, limit wywołań w locie; wersja czekająca call_wait&lt;/td&gt;&lt;td&gt;nie ponawia zapisu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Urządzenie zdalne&lt;/b&gt;&lt;/td&gt;&lt;td&gt;lokalny alias urządzenia innej płytki (sys_remote)&lt;/td&gt;&lt;td&gt;ta sama komenda z podmienionym id: po kablu czeka na odpowiedź, przez radio zapis bez czekania i odczyt z kopii watcha; zdarzenia i błędy przez subskrypcję (klucz 0x10, kanał 0x81)&lt;/td&gt;&lt;td&gt;nie trzyma stanu urządzenia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Binding komend&lt;/b&gt;&lt;/td&gt;&lt;td&gt;provider bez sesji, dla klienta spoza runIT (skrypt, Node-RED)&lt;/td&gt;&lt;td&gt;komenda [key][dir][code][args], odpowiedź [status][data] na tym samym providerze&lt;/td&gt;&lt;td&gt;nic nie przekazuje dalej; bez watchy i subskrypcji&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Flasher&lt;/b&gt;&lt;/td&gt;&lt;td&gt;programowanie płytki na łączu przez jej bootloader ROM (sys_flasher)&lt;/td&gt;&lt;td&gt;pożycza UART łącza, steruje BOOT i EN; kopiuje bootloader, tablicę partycji i firmware tej płytki, czyści nvs i otadata, sprawdza MD5, restartuje; nowa płytka startuje z id 0 i jest slave'em&lt;/td&gt;&lt;td&gt;nie wgrywa obrazu z APP: kopiuje firmware tej płytki&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Dead-man, GONE&lt;/b&gt;&lt;/td&gt;&lt;td&gt;reakcja płytki na koniec sesji&lt;/td&gt;&lt;td&gt;cisza sesji mastera albo klienta: stan bezpieczny (gdy uzbrojony); root wysyła GONE do slave'ów; słuchacze usuwają subskrypcje i watche peera&lt;/td&gt;&lt;td&gt;nie ma własnego timera: to timeout sesji&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="610" width="1270" x="25" y="830" as="geometry" /></mxCell>
        <mxCell id="o-lane-d" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f0f6ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="Przykłady ramek w bajtach (tak, jak idą po łączu)" vertex="1"><mxGeometry height="1330" width="1300" x="10" y="1470" as="geometry" /></mxCell>
        <mxCell id="o-frames-intro" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;padding-right:8px&#x27;&gt;&lt;b&gt;Bajt frame&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;border:1px solid #888;text-align:center;font-family:Consolas,monospace;padding:2px 6px&#x27;&gt;bit 7-6&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;border:1px solid #888;text-align:center;font-family:Consolas,monospace;padding:2px 6px&#x27;&gt;bit 5-3&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;border:1px solid #888;text-align:center;font-family:Consolas,monospace;padding:2px 6px&#x27;&gt;bit 2&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;border:1px solid #888;text-align:center;font-family:Consolas,monospace;padding:2px 6px&#x27;&gt;bit 1&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;border:1px solid #888;text-align:center;font-family:Consolas,monospace;padding:2px 6px&#x27;&gt;bit 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;border:1px solid #ccc;padding:2px 6px&#x27;&gt;rodzaj: 00 REQUEST, 01 ANSWER, 10 PUSH, 11 CONTROL&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;border:1px solid #ccc;padding:2px 6px&#x27;&gt;zero&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;border:1px solid #ccc;padding:2px 6px&#x27;&gt;status odpowiedzi: 0 OK, 1 ERROR&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;border:1px solid #ccc;padding:2px 6px&#x27;&gt;NOREPLY&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;border:1px solid #ccc;padding:2px 6px&#x27;&gt;URGENT&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#x27;margin-top:4px&#x27;&gt;Więc: &lt;code&gt;00&lt;/code&gt; REQUEST, &lt;code&gt;40&lt;/code&gt; ANSWER OK, &lt;code&gt;44&lt;/code&gt; ANSWER ERROR, &lt;code&gt;80&lt;/code&gt; PUSH, &lt;code&gt;c0&lt;/code&gt; CONTROL; flagi dodają się (&lt;code&gt;03&lt;/code&gt; = REQUEST + URGENT + NOREPLY). &lt;b&gt;Id&lt;/b&gt;: płytki 00..ef, APP f0, inni klienci f1..fc, ff broadcast. Liczby little-endian (&lt;code&gt;07 00&lt;/code&gt; = 7). Źródło: &lt;i&gt;sys_session_frame.h&lt;/i&gt;, &lt;i&gt;sys_session_config.h&lt;/i&gt;, &lt;i&gt;cmd.h&lt;/i&gt;, &lt;i&gt;router_ids.h&lt;/i&gt;, ERRORS.MD.&lt;/div&gt;" vertex="1"><mxGeometry height="80" width="1270" x="25" y="1505" as="geometry" /></mxCell>
        <mxCell id="o-frames" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="&lt;table border=&#x27;1&#x27; cellpadding=&#x27;4&#x27; style=&#x27;border-collapse:collapse;font-size:12px;width:1250px&#x27;&gt;&lt;tr&gt;&lt;th style=&#x27;width:150px&#x27;&gt;przykład&lt;/th&gt;&lt;th&gt;ramka: &lt;span style=&#x27;background:#f8cecc&#x27;&gt;&amp;nbsp;nagłówek 5 B&amp;nbsp;&lt;/span&gt; &lt;span style=&#x27;background:#dae8fc&#x27;&gt;&amp;nbsp;treść&amp;nbsp;&lt;/span&gt;, pod każdym polem jego znaczenie&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&#x27;2&#x27; style=&#x27;vertical-align:top&#x27;&gt;&lt;b&gt;PING płytki&lt;br&gt;APP → płytka 0&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;00&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;00&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;f0&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;07 00&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;01&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;00&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;REQUEST&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;dst płytka 0&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;src f0 APP&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;seq 7&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;key SYS&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;dir odczyt&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;code PING&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;40&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;f0&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;00&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;07 00&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;e8 03 00 00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;ANSWER OK&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;dst f0 APP&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;src płytka 0&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;seq 7 (z żądania)&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;uptime_ms u32 = 1000&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&#x27;2&#x27; style=&#x27;vertical-align:top&#x27;&gt;&lt;b&gt;Odczyt urządzenia&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;00&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;00&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;f0&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;08 00&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;05&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;00&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;03 00&lt;/td&gt;&lt;td style=&#x27;background:#dae8fc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;01 00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;REQUEST&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;dst płytka 0&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;src f0 APP&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;seq 8&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;key DEVICE&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;dir odczyt&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;id u16 = 3&lt;/td&gt;&lt;td style=&#x27;font-size:10px;text-align:center;vertical-align:top;border:1px solid #ccc;color:#333&#x27;&gt;op u16 = 1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#x27;font-size:11px;color:#555;margin-top:2px&#x27;&gt;op: operacja z deskryptora urządzenia&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;40&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&gt;f0&lt;/td&gt;&lt;td style=&#x27;background:#f8cecc;font-family:Consolas,monospace;font-size:12px;white-space:nowrap;text-align:center;border:1px solid #888&#x27;&