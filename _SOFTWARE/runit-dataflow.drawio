        <mxCell id="r-req" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;cmd_req_t&lt;/b&gt; (robi ją sesja z ramki)&lt;br&gt;&lt;br&gt;req, req_len ← request&lt;br&gt;seq ← hdr.seq&lt;br&gt;src ← hdr.src&lt;br&gt;flags ← bity 1-0 ramki:&lt;br&gt;URGENT (bit 0), NOREPLY (bit 1)" vertex="1">
