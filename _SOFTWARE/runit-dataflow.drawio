        <mxCell id="o-link" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;Łącze&lt;/b&gt;&lt;br&gt;BLE, UART" vertex="1"><mxGeometry height="80" width="110" x="210" y="170" as="geometry" /></mxCell>
        <mxCell id="o-prov" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Provider&lt;/b&gt;&lt;br&gt;jedna droga bajtów,&lt;br&gt;jeden odbiorca" vertex="1"><mxGeometry height="80" width="150" x="360" y="170" as="geometry" /></mxCell>
