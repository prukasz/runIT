        <mxCell id="r-n-a" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="dwa taski, równolegle: routery modułów muszą być thread-safe" vertex="1">
