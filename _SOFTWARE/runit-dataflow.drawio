          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-e13" edge="1" parent="1" source="w-router" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.7000;entryX=0.0000;entryY=0.2500;" target="w-mod" value="odczyt&lt;br&gt;(key)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-e14" edge="1" parent="1" source="w-mod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.0000;exitY=0.7500;entryX=1.0000;entryY=0.9000;" target="w-router" value="wynik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-e15" edge="1" parent="1" source="w-watch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=0.0000;entryX=0.5000;entryY=0.0000;" target="w-ses" value="wpis: sys_session_push&lt;br&gt;PUSH [0x80][owner][id][status][data]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="112" />
              <mxPoint x="690" y="112" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w-legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;czarne&lt;/b&gt;: ustawienie watcha (ADD i jego odpowiedź)&lt;br&gt;&lt;b style=&#39;color:#B07800&#39;&gt;pomarańczowe&lt;/b&gt;: działanie watcha, gdy już jest; APP o nic nie prosi" vertex="1">
          <mxGeometry height="70" width="360" x="30" y="340" as="geometry" />
        </mxCell>
        <mxCell id="w-note-hello" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="HELLO i PING idą tym samym łączem; obsługuje je sama sesja. Wpisu nie przekazuje router, watch wysyła go sam przez sesję." vertex="1">
          <mxGeometry height="60" width="360" x="30" y="420" as="geometry" />
        </mxCell>
        <mxCell id="w-desc" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;strokeColor=#E07A5F;rounded=1;spacing=8;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Jak działa watch APP - master&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. ADD.&lt;/b&gt; APP wysyła REQUEST: [dst 00][src F0][seq] i body [0x0F WATCH][WRITE][ADD][head 11 B][odczyt]. Head: id, trigger (PERIODIC / ON_CHANGE / ON_EVENT), period i max_silence w tickach, filtr. Właścicielem jest src komendy (F0); watch jest znany jako (owner, id), a ADD tego samego id zastępuje poprzedni.&lt;br&gt;&lt;b&gt;2. Odpowiedź.&lt;/b&gt; Master odpowiada ANSWER (OK albo błąd: ERR_WATCH_NOT_READ, _BAD_ARG, _FULL). Odtąd APP o nic już nie prosi.&lt;br&gt;&lt;b&gt;3. Odczyt.&lt;/b&gt; Watch nie ma własnego taska. Timer (SYS_WATCH_TICK_MS) wyznacza watche, którym minął period (ON_EVENT: gdy zdarzenie pasuje do filtru). Watch wstrzykuje swój odczyt do routera (router_inject) jak każdą komendę płytki, a moduł wybrany po key go wykonuje.&lt;br&gt;&lt;b&gt;4. Decyzja.&lt;/b&gt; W done ON_CHANGE porównuje CRC32 odpowiedzi z ostatnim wysłanym wpisem; wpis idzie, gdy się różni albo minął max_silence. PERIODIC wysyła co period.&lt;br&gt;&lt;b&gt;5. Wpis.&lt;/b&gt; [owner][id][status][data] idzie jedną ramką PUSH [0x80 kanał WATCHES][wpis] (sys_session_push, NOWAIT); seq to licznik wpisów tego watcha, dziura znaczy zgubione wpisy. Wpisy dostaje tylko właściciel. 0x80 to kanał sesji, nie strumień: nie ma kolejki ani subskrybentów. Wpis, którego nie przyjęła droga, nie jest zapamiętany, a ON_CHANGE wyśle wartość przy następnym odczycie.&lt;br&gt;&lt;b&gt;6. Kolejność.&lt;/b&gt; Wpisy wychodzą z taska routera zaraz po odczycie, do tej samej kolejki providera co odpowiedzi, więc wpis po ANSWER na zapis nie jest starszy niż ten zapis.&lt;br&gt;&lt;b&gt;7. Koniec.&lt;/b&gt; Sesja z APP się kończy: master usuwa watche tego właściciela. APP po powrocie dodaje je od nowa." vertex="1">
          <mxGeometry height="210" width="1260" x="30" y="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="watchboardpage5x01" name="5 Watch: płytka i płytka">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
