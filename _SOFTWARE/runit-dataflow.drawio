        <mxCell id="q-n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="sys_device_router&lt;br&gt;rozbiera [dir][id][op][args]" vertex="1">
