        <mxCell id="q-n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="task routera&lt;br&gt;&lt;b&gt;PRZEŁĄCZENIE TASKU&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="130" x="470" y="105" as="geometry" />
        </mxCell>
        <mxCell id="q-n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="tap, root,&lt;br&gt;klucz 0x05" vertex="1">
          <mxGeometry height="70" width="130" x="620" y="105" as="geometry" />
