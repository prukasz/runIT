        <mxCell id="y-e23" edge="1" parent="1" source="y-s-mod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.0000;exitY=0.7917;entryX=1.0000;entryY=0.9038;" target="y-s-router" value="wynik">
