        <mxCell id="q-leg" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b style=&#39;color:#B35C00&#39;&gt;pomarańczowe&lt;/b&gt;: kolejka albo przełączenie tasku &amp;nbsp;&amp;nbsp; &lt;b style=&#39;color:#10739e&#39;&gt;niebieskie&lt;/b&gt;: blokada (mutex)" vertex="1">
          <mxGeometry height="24" width="950" x="30" y="385" as="geometry" />
        </mxCell>
        <mxCell id="q-table" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;font-size:11px;width:940px&#39;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;z sieci (przez router)&lt;/th&gt;&lt;th&gt;z C i z VM (wprost)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;kolejka&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ring routera (pilny 1 KB, zwykły 4 KB)&lt;/td&gt;&lt;td&gt;brak&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;przełączenie tasku&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tak: task RX providera → task routera&lt;/td&gt;&lt;td&gt;nie: wszystko na tasku wołającego (np. VM)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;kopia&lt;/b&gt;&lt;/td&gt;&lt;td&gt;komenda, callback i ctx kopiowane do ringu; request najwyżej CMD_DATA_MAX&lt;/td&gt;&lt;td&gt;nie: args w miejscu, bez limitu rozmiaru&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;wynik&lt;/b&gt;&lt;/td&gt;&lt;td&gt;done(ctx, cmd, status, data) na tasku routera, potem ramka ANSWER&lt;/td&gt;&lt;td&gt;wartość zwrotna; wołający czeka na koniec&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;tap, akcje&lt;/b&gt;&lt;/td&gt;&lt;td&gt;widzi komendę (można ją nagrać)&lt;/td&gt;&lt;td&gt;nie widzi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;łańcuch błędu&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ERR_ROUTER_KEY → ERR_DEV_ID → ERR_DEV_OP → przyczyna&lt;/td&gt;&lt;td&gt;ERR_DEV_ID → ERR_DEV_OP → przyczyna&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;blokady&lt;/b&gt;&lt;/td&gt;&lt;td&gt;mutex rejestru, na tasku routera&lt;/td&gt;&lt;td&gt;mutex rejestru, na tasku wołającego&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="235" width="960" x="30" y="415" as="geometry" />
        </mxCell>
