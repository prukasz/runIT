        <mxCell id="v-e22" edge="1" parent="1" source="v-r3-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="v-r3-2" value="">
