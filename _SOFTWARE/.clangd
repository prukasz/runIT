CompileFlags:
    CompilationDatabase: build
    Add:
        [
            -std=gnu23,
            -ferror-limit=99999,
            -Wno-implicit-function-declaration,
        ]
    Remove:
        - -mlongcalls
        - -mdisable-hardware-atomics
        - -mno-target-align
        - -fno-shrink-wrap
        - -fstrict-volatile-bitfields
        - -fno-tree-switch-conversion
        - -fzero-init-padding-bits=all
        - -fno-malloc-dce
Diagnostics:
    Suppress:
        - pp_file_not_found
        - unused-includes
---
# components/codecs is header-only (no SRCS), so every file under decoders/ and
# encoders/ has zero entries of its own in compile_commands.json. clangd's
# fallback for such a file doesn't trace the real #include graph back to an
# owning .c (sys_interface.c, runit.c, sys_actions.c) - it grabs an arbitrary
# unrelated compile command from the database instead (observed: it borrowed
# device_ads7128/adapter_ads7128.c's flags for dec_sys_device_install.h, which
# obviously lacks the other 7 devices' include dirs). This block force-injects
# the flags those files actually need, bypassing that fallback guess entirely.
If:
    PathMatch: [components/codecs/decoders/.*, components/codecs/encoders/.*]
CompileFlags:
    Add:
        [
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_gpio_esp/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_pca9685/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_tca6424a/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_tps55289/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_ina3221/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_ap33772s/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_dac53202/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/devices/device_ads7128/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/sys_device/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/sys_io/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/sys_power/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/sys_i2c/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/ble/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/sys_interface/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/sys_buffers/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/sys_actions/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/system/callbacks/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/sys_errors/include,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/sys_errors/codes,
            -IC:/Users/krolp/Documents/runIT_main/_SOFTWARE/components/sys_errors/codes/base,
        ]