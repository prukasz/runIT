        <mxCell id="x-b-watch" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="sys_watch (key 0x0F)&lt;br&gt;owner 00, id, trigger, CRC&lt;br&gt;timer" vertex="1">
