        <mxCell id="v-e4" edge="1" parent="1" source="v-p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.2838;exitY=1.0000;entryX=0.2838;entryY=0.0000;" target="v-d" value="TX ↓ send(flags)">
