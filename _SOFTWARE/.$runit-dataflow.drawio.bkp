        <mxCell id="q-leg" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b style=&#39;color:#B35C00&#39;&gt;pomarańczowe&lt;/b&gt;: kolejka albo przełączenie tasku &amp;nbsp;&amp;nbsp; &lt;b style=&#39;color:#10739e&#39;&gt;niebieskie&lt;/b&gt;: blokada (mutex)" vertex="1">
          <mxGeometry height="24" width="950" x="30" y="385" as="geometry" />
        </mxCell>
        <mxCell id="q-table" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;font-size:11px;width:940px&#39;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;z sieci (przez router)&lt;/th&gt;&lt;th&gt;z C i z VM (wprost)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;kolejka&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ring routera (pilny 1 KB, zwykły 4 KB)&lt;/td&gt;&lt;td&gt;brak&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;przełączenie tasku&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tak: task RX providera → task routera&lt;/td&gt;&lt;td&gt;nie: wszystko na tasku wołającego (np. VM)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;kopia&lt;/b&gt;&lt;/td&gt;&lt;td&gt;komenda, callback i ctx kopiowane do ringu; request najwyżej CMD_DATA_MAX&lt;/td&gt;&lt;td&gt;nie: args w miejscu, bez limitu rozmiaru&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;wynik&lt;/b&gt;&lt;/td&gt;&lt;td&gt;done(ctx, cmd, status, data) na tasku routera, potem ramka ANSWER&lt;/td&gt;&lt;td&gt;wartość zwrotna; wołający czeka na koniec&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;tap, akcje&lt;/b&gt;&lt;/td&gt;&lt;td&gt;widzi komendę (można ją nagrać)&lt;/td&gt;&lt;td&gt;nie widzi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;łańcuch błędu&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ERR_ROUTER_KEY → ERR_DEV_ID → ERR_DEV_OP → przyczyna&lt;/td&gt;&lt;td&gt;ERR_DEV_ID → ERR_DEV_OP → przyczyna&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;blokady&lt;/b&gt;&lt;/td&gt;&lt;td&gt;mutex rejestru, na tasku routera&lt;/td&gt;&lt;td&gt;mutex rejestru, na tasku wołającego&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="235" width="960" x="30" y="415" as="geometry" />
        </mxCell>
        <mxCell id="q-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4f8ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="Serwo z programu VM: kolejne kroki i gdzie task może się zatrzymać" vertex="1">
          <mxGeometry height="270" width="1300" x="10" y="680" as="geometry" />
        </mxCell>
        <mxCell id="q-p1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="1. VM: przebieg, blok SERVO" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="725" as="geometry" />
        </mxCell>
        <mxCell id="q-p1-c" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="task supervisora VM; bloki idą w kolejności wgrania. Tu nie ma kolejki." vertex="1">
          <mxGeometry height="135" width="160" x="30" y="805" as="geometry" />
        </mxCell>
        <mxCell id="q-p2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="2. vm_device_run" vertex="1">
          <mxGeometry height="70" width="160" x="210" y="725" as="geometry" />
        </mxCell>
        <mxCell id="q-p2-c" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="sprawdza wejścia, nasyca wartość do limitu, pakuje args (tenths, i16). Bez czekania." vertex="1">
          <mxGeometry height="135" width="160" x="210" y="805" as="geometry" />
        </mxCell>
        <mxCell id="q-p3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;" value="3. sys_device_call" vertex="1">
          <mxGeometry height="70" width="160" x="390" y="725" as="geometry" />
        </mxCell>
        <mxCell id="q-p3-c" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="bierze mutex rejestru. Czeka tylko, gdy trzyma go inny task: router, zdarzenia, timer, ADC (dziedziczenie priorytetu)." vertex="1">
          <mxGeometry height="135" width="160" x="390" y="805" as="geometry" />
        </mxCell>
        <mxCell id="q-p4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="4. handler serwa → sys_io_set_pwm_duty" vertex="1">
          <mxGeometry height="70" width="160" x="570" y="725" as="geometry" />
        </mxCell>
        <mxCell id="q-p4-c" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="zagnieżdżone wywołanie na tym samym tasku: mutex rekurencyjny, bez przełączenia." vertex="1">
          <mxGeometry height="135" width="160" x="570" y="805" as="geometry" />
        </mxCell>
        <mxCell id="q-p5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="5. sprzęt" vertex="1">
          <mxGeometry height="70" width="160" x="750" y="725" as="geometry" />
        </mxCell>
        <mxCell id="q-p5-c" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="GPIO ESP32 (LEDC / MCPWM): zapis rejestru, bez czekania. PCA9685: task blokuje się do końca transferu I2C (ISR)." vertex="1">
          <mxGeometry height="135" width="160" x="750" y="805" as="geometry" />
        </mxCell>
        <mxCell id="q-p6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="6. powrót do bloku" vertex="1">
          <mxGeometry height="70" width="160" x="930" y="725" as="geometry" />
        </mxCell>
        <mxCell id="q-p6-c" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="błąd: blok pada (eno spada), VM zgłasza błąd. BUSY (serwo na innej płytce) znaczy później: ten sam zapis w następnym przebiegu." vertex="1">
          <mxGeometry height="135" width="160" x="930" y="805" as="geometry" />
        </mxCell>
        <mxCell id="q-p7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="7. koniec przebiegu" vertex="1">
          <mxGeometry height="70" width="160" x="1110" y="725" as="geometry" />
        </mxCell>
        <mxCell id="q-p7-c" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="VM oddaje procesor między przebiegami." vertex="1">
          <mxGeometry height="135" width="160" x="1110" y="805" as="geometry" />
        </mxCell>
        <mxCell id="q-e13" edge="1" parent="1" source="q-p1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="q-p2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q-e14" edge="1" parent="1" source="q-p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="q-p3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q-e15" edge="1" parent="1" source="q-p3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="q-p4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q-e16" edge="1" parent="1" source="q-p4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="q-p5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q-e17" edge="1" parent="1" source="q-p5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="q-p6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q-e18" edge="1" parent="1" source="q-p6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="q-p7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q-desc" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;strokeColor=#E07A5F;rounded=1;spacing=8;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Co jest po drodze&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Z C i z VM nie ma kolejki ani przełączenia tasku.&lt;/b&gt; sys_device_call wykonuje się na tasku wołającego: serwo z programu to wywołanie funkcji z tasku VM. Zagnieżdżone wywołania (sterownik woła urządzenie swojego pinu) też są na tym samym tasku, bo mutex rejestru jest rekurencyjny.&lt;br&gt;&lt;b&gt;2. Zatrzymać task mogą tylko dwie rzeczy:&lt;/b&gt; mutex rejestru, gdy trzyma go inny task (router, zdarzenia, timer, ADC), i blokujący transfer I2C, gdy pin jest na PCA9685. Zapis rejestru LEDC lub MCPWM nie czeka. Dlatego operacja urządzenia nie może spać ani czekać na nic poza własnym I/O.&lt;br&gt;&lt;b&gt;3. Z sieci idzie przez ring routera i task routera:&lt;/b&gt; dwa przełączenia (task RX providera, task routera) i kopia komendy, a wynik wraca przez done i ramkę ANSWER. To ta sama funkcja na końcu, więc serwo zachowuje się tak samo, kto je woła; obie drogi szereguje ten sam mutex, wygrywa ostatni zapis.&lt;br&gt;&lt;b&gt;4. Router przy VM jest tylko do sterowania programem&lt;/b&gt; (klucz 0x0B: wgranie, EXEC, STATUS) i do akcji (vm_exec_request_action kolejkuje na tasku routera, nigdy w środku przebiegu). Telemetria idzie streamem." vertex="1">
          <mxGeometry height="170" width="1260" x="30" y="975" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
