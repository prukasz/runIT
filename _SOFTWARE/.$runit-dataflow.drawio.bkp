        </mxCell>
        <mxCell id="z-r-hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="sesja czyta nagłówek: &lt;b&gt;kind&lt;/b&gt; (bity 7-6) i &lt;b&gt;dst&lt;/b&gt;&lt;br&gt;(sesja otwarta, src zgodne z peerem)" vertex="1">
