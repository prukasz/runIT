        <mxCell id="v-e5" edge="1" parent="1" source="v-d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.7162;exitY=0.0000;entryX=0.7162;entryY=1.0000;" target="v-p" value="RX ↑ deliver (woła driver)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-e6" edge="1" parent="1" source="v-d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;startArrow=classic;startFill=1;" target="v-v" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-e7" edge="1" parent="1" source="v-v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;startArrow=classic;startFill=1;" target="v-l1" value="bajty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-e8" edge="1" parent="1" source="v-v2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;startArrow=classic;startFill=1;" target="v-l2" value="bajty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-t1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;Użytkownik&lt;/b&gt; otwiera provider (open), wysyła na nim i dostaje to, co przychodzi (rx). Provider nie wie, kim on jest: decyduje kontekst. Do open podaje własny rx (funkcję i ctx): to jego kod, który provider woła po każdym deliver z drivera, na tasku RX drivera. Nie ma własnego tasku: wysyła z tasku, który go woła. Drugi open to ERR_PROV_IN_USE." vertex="1">
          <mxGeometry height="120" width="490" x="800" y="105" as="geometry" />
        </mxCell>
        <mxCell id="v-t2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;Provider&lt;/b&gt; to jedyne, co widzi kod nad driverami: id, wysyłanie, max_frame i stan. Sam niczego nie wysyła ani nie odbiera: przekazuje send do drivera, a przechowuje rx i ctx użytkownika z open i woła je, gdy driver zrobi deliver. Nigdy nie rozgałęzia się po rodzaju łącza. Każde wywołanie szuka po id, więc id po usunięciu daje ERR_PROV_NOT_FOUND, a nie zwolniony provider." vertex="1">
          <mxGeometry height="170" width="490" x="800" y="265" as="geometry" />
        </mxCell>
        <mxCell id="v-t3" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;Driver implementuje TX.&lt;/b&gt; Provider woła send drivera, który wkłada ramkę do swojej kolejki, a jego task TX ją wysyła. &lt;b&gt;RX to hook wyższej warstwy:&lt;/b&gt; użytkownik dodaje go w open, a driver tylko woła deliver, gdy coś przyszło z łącza; provider woła wtedy hook. Jak driver zbiera dane (składanie fragmentów, COBS) to jego szczegół. Użytkownik i provider nie mają tu własnych tasków." vertex="1">
          <mxGeometry height="110" width="490" x="800" y="475" as="geometry" />
        </mxCell>
        <mxCell id="v-t4" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="Driver &lt;b&gt;dzieli&lt;/b&gt; ramkę na to, co niesie łącze, i &lt;b&gt;skleja&lt;/b&gt; ją po drodze w górę. Nikt nad nim nie tnie ramki: za długa to ERR_PROV_TOO_LONG, nigdy nie jest obcinana." vertex="1">
          <mxGeometry height="105" width="490" x="800" y="625" as="geometry" />
        </mxCell>
        <mxCell id="v-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4f8ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="TX i RX po stronie drivera: taski i kolejki" vertex="1">
          <mxGeometry height="430" width="1300" x="10" y="825" as="geometry" />
        </mxCell>
