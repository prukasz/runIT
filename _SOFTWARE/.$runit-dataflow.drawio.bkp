        <mxCell id="v-e2" edge="1" parent="1" source="v-u" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;" target="v-p" value="open(id, rx, ctx) ↓">
