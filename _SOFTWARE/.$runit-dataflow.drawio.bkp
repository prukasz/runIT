        <mxCell id="ses-09" parent="AyPxklh--HKeSmsL95Hl-2" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="CONTROL · HELLO  (to samo w drugą stronę)" vertex="1">
          <mxGeometry height="24" width="450" x="495" y="203" as="geometry" />
        </mxCell>
        <mxCell id="ses-10" edge="1" parent="AyPxklh--HKeSmsL95Hl-2" style="endArrow=classic;html=1;strokeColor=#E07A5F;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="231" as="sourcePoint" />
            <mxPoint x="480" y="231" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ses-11" parent="AyPxklh--HKeSmsL95Hl-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#393C56;fillColor=#FFFFFF;dashed=1;fontSize=11;" value="obie strony sprawdzają: ta sama wersja? (inaczej ERR_SESSION_VERSION, zostaje zamknięta)&lt;br&gt;id wolne? (inaczej ERR_SESSION_ID_TAKEN)" vertex="1">
          <mxGeometry height="44" width="640" x="400" y="256" as="geometry" />
        </mxCell>
        <mxCell id="ses-12" parent="AyPxklh--HKeSmsL95Hl-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#393C56;fontStyle=1;fontSize=14;" value="SESJA OTWARTA" vertex="1">
          <mxGeometry height="34" width="640" x="400" y="318" as="geometry" />
        </mxCell>
        <mxCell id="ses-13" parent="AyPxklh--HKeSmsL95Hl-2" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="REQUEST / STREAM  (dst = B)" vertex="1">
