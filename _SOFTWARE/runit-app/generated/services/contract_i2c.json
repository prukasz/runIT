{
  "$schema": "../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "I2C",
  "router_key": 2,
  "alias": "I2C bus diagnostics (I2C Bus Diagnostics)",
  "description": "Scanning addresses on the I2C buses, resetting a bus, and direct access to the registers of chips (raw read / write).",
  "category": "system",
  "commands": [
    {
      "id": "INFO",
      "op": 1,
      "symbol": "SYS_I2C_OP_INFO",
      "label": "Information about the I2C buses",
      "description": "Returns whether each I2C bus is enabled, its SDA / SCL pins and the mask of addresses in use, for every I2C bus on the board.",
      "read": {
        "returns": {
          "struct": "sys_i2c_info_t",
          "array": true,
          "description": "State of the I2C buses: one entry per bus, in index order",
          "fields": [
            {
              "id": "flags",
              "label": "Flags",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "Bit 0 enabled, bit 1 ready, bit 2 pull-ups on"
            },
            {
              "id": "sda",
              "label": "Pin SDA",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "scl",
              "label": "Pin SCL",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2
            },
            {
              "id": "used",
              "label": "Addresses in use",
              "type": "bitmask",
              "raw_type": "u32",
              "size": 16,
              "offset": 3,
              "description": "Bit n = a device was added at address n (4 u32 words)"
            }
          ]
        }
      }
    },
    {
      "id": "SCAN",
      "op": 2,
      "symbol": "SYS_I2C_OP_SCAN",
      "label": "Scan an I2C bus",
      "description": "Scans the addresses 0x08..0x77 on the given bus and returns a 128-bit mask of the addresses that answered ACK.",
      "read": {
        "args": {
          "struct": "sys_i2c_bus_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus index",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "Number of the I2C bus (0 or 1)"
            }
          ]
        },
        "returns": {
          "struct": "sys_i2c_scan_t",
          "description": "Mask of the addresses found",
          "fields": [
            {
              "id": "found_0",
              "label": "Addresses 0x00..0x1F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            },
            {
              "id": "found_1",
              "label": "Addresses 0x20..0x3F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 4
            },
            {
              "id": "found_2",
              "label": "Addresses 0x40..0x5F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 8
            },
            {
              "id": "found_3",
              "label": "Addresses 0x60..0x7F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 12
            }
          ]
        }
      }
    },
    {
      "id": "RESET",
      "op": 3,
      "symbol": "SYS_I2C_OP_RESET",
      "label": "Reset an I2C bus",
      "description": "Resets the bus (SCL clock pulses) to free a chip that holds the SDA line.",
      "write": {
        "args": {
          "struct": "sys_i2c_bus_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus index",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            }
          ]
        }
      }
    },
    {
      "id": "RAW",
      "op": 4,
      "symbol": "SYS_I2C_OP_RAW",
      "label": "Raw register",
      "description": "Bytes of a register of the device at a 7-bit address: the write writes them, the read reads `len` of them and answers the address with the bytes.",
      "read": {
        "description": "Reads a number of bytes from a register of the device at the given 7-bit I2C address.",
        "args": {
          "struct": "sys_i2c_raw_read_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "addr",
              "label": "7-bit address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "reg",
              "label": "Register address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2
            },
            {
              "id": "len",
              "label": "Number of bytes",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 3
            }
          ]
        },
        "returns": {
          "struct": "sys_i2c_raw_write_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "addr",
              "label": "7-bit address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "reg",
              "label": "Register address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2
            },
            {
              "id": "data",
              "label": "Data to write",
              "type": "string",
              "raw_type": "bytes",
              "description": "Bytes to write (runs to the end of the frame)"
            }
          ],
          "description": "Bytes read from the register"
        }
      },
      "write": {
        "description": "Writes data to the given register of the device at a 7-bit I2C address.",
        "args": {
          "struct": "sys_i2c_raw_write_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "addr",
              "label": "7-bit address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "reg",
              "label": "Register address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2
            },
            {
              "id": "data",
              "label": "Data to write",
              "type": "string",
              "raw_type": "bytes",
              "description": "Bytes to write (runs to the end of the frame)"
            }
          ]
        }
      }
    }
  ]
}
