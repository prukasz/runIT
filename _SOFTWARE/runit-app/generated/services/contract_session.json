{
  "$schema": "../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "SESSION",
  "router_key": 14,
  "alias": "Sessions",
  "description": "This board's id and its sessions: the providers attached to a peer.",
  "category": "system",
  "commands": [
    {
      "id": "ID",
      "op": 1,
      "symbol": "SYS_SESSION_OP_ID",
      "label": "Board id",
      "description": "This board's place in the project, kept in NVS; a new one takes effect at the next start.",
      "read": {
        "returns": {
          "struct": "sys_session_id_args_t",
          "description": "The board id",
          "fields": [
            {
              "id": "board_id",
              "label": "Board id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0..0xEF",
              "min": 0,
              "max": 239
            }
          ]
        }
      },
      "write": {
        "args": {
          "struct": "sys_session_id_args_t",
          "fields": [
            {
              "id": "board_id",
              "label": "Board id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0..0xEF, from the next start",
              "min": 0,
              "max": 239
            }
          ]
        }
      }
    },
    {
      "id": "ATTACH",
      "op": 2,
      "symbol": "SYS_SESSION_OP_ATTACH",
      "label": "Attach a provider",
      "description": "Makes a provider the way to a peer.",
      "write": {
        "args": {
          "struct": "sys_session_attach_args_t",
          "fields": [
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The provider's id"
            },
            {
              "id": "peer",
              "label": "Peer",
              "type": "enum",
              "enum": "sys_session_peer_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Where it leads: CLIENT"
            }
          ]
        }
      }
    },
    {
      "id": "DETACH",
      "op": 3,
      "symbol": "SYS_SESSION_OP_DETACH",
      "label": "Detach a provider",
      "description": "Ends the session on a provider and closes it.",
      "write": {
        "args": {
          "struct": "sys_session_detach_args_t",
          "fields": [
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The provider's id"
            }
          ]
        }
      }
    },
    {
      "id": "PEERS",
      "op": 4,
      "symbol": "SYS_SESSION_OP_PEERS",
      "label": "List the sessions",
      "description": "Returns every session.",
      "read": {
        "returns": {
          "type": "u8",
          "label": "Number of sessions",
          "description": "Then per session: provider u8, peer u8, open u8, peer id u8, timeout_ms u16."
        }
      }
    }
  ]
}
