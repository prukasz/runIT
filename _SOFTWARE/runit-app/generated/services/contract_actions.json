{
  "$schema": "../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "ACTIONS",
  "router_key": 6,
  "alias": "Action management (Actions & Macros)",
  "description": "Storing, replaying and reading back command lists (macros) in Flash, and managing them.",
  "category": "system",
  "commands": [
    {
      "id": "RUN",
      "op": 1,
      "symbol": "SYS_ACTIONS_OP_RUN",
      "label": "Run an action",
      "description": "Replays the recorded command list of the given record ID (stops at the first error).",
      "write": {
        "args": {
          "struct": "id_args_t",
          "fields": [
            {
              "id": "id",
              "label": "Record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0,
              "description": "ID of the action record"
            }
          ]
        }
      }
    },
    {
      "id": "RECORD_START",
      "op": 2,
      "symbol": "SYS_ACTIONS_OP_RECORD_START",
      "label": "Start recording",
      "description": "Captures the commands the client sends next and stores them in the action record with the given ID.",
      "write": {
        "args": {
          "struct": "record_start_t",
          "fields": [
            {
              "id": "id",
              "label": "Record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0,
              "description": "ID of the action record"
            },
            {
              "id": "execute",
              "label": "Run while recording",
              "type": "boolean",
              "raw_type": "u8",
              "size": 1,
              "offset": 4,
              "description": "1 = run the recorded commands as they arrive, 0 = only record them"
            }
          ]
        }
      }
    },
    {
      "id": "RECORD_STOP",
      "op": 3,
      "symbol": "SYS_ACTIONS_OP_RECORD_STOP",
      "label": "Stop recording",
      "description": "Stops the recording in progress, closes the action record and returns what was stored.",
      "write": {
        "returns": {
          "struct": "sys_actions_info_t",
          "description": "Metadata of the stored action record",
          "fields": [
            {
              "id": "bytes",
              "label": "Size",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 0,
              "unit": "B"
            },
            {
              "id": "count",
              "label": "Number of frames",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 2
            },
            {
              "id": "crc32",
              "label": "CRC-32",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 4
            }
          ]
        }
      }
    },
    {
      "id": "BEGIN",
      "op": 4,
      "symbol": "SYS_ACTIONS_OP_BEGIN",
      "label": "Start uploading",
      "description": "Opens an upload session for a ready-made action record image of the given length in bytes.",
      "write": {
        "args": {
          "struct": "begin_t",
          "fields": [
            {
              "id": "id",
              "label": "Record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            },
            {
              "id": "len",
              "label": "Length",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 4,
              "unit": "B"
            }
          ]
        }
      }
    },
    {
      "id": "WRITE",
      "op": 5,
      "symbol": "SYS_ACTIONS_OP_WRITE",
      "label": "Write a chunk",
      "description": "Uploads a chunk of the record being uploaded at the given offset.",
      "write": {
        "args": {
          "struct": "write_t",
          "fields": [
            {
              "id": "offset",
              "label": "Offset",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 0,
              "unit": "B"
            },
            {
              "id": "data",
              "label": "Chunk data",
              "type": "string",
              "raw_type": "bytes",
              "description": "Bytes of the record image chunk (runs to the end of the frame)"
            }
          ]
        }
      }
    },
    {
      "id": "COMMIT",
      "op": 6,
      "symbol": "SYS_ACTIONS_OP_COMMIT",
      "label": "Commit the upload",
      "description": "Checks the CRC-32 and stores the uploaded action record in Flash.",
      "write": {
        "args": {
          "struct": "commit_t",
          "fields": [
            {
              "id": "crc32",
              "label": "CRC-32",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            }
          ]
        }
      }
    },
    {
      "id": "READ",
      "op": 7,
      "symbol": "SYS_ACTIONS_OP_READ",
      "label": "Read the action's frames",
      "description": "Sends back the stored frames of the action (one answer frame per recorded command).",
      "read": {
        "args": {
          "struct": "id_args_t",
          "fields": [
            {
              "id": "id",
              "label": "Record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            }
          ]
        }
      }
    },
    {
      "id": "INFO",
      "op": 8,
      "symbol": "SYS_ACTIONS_OP_INFO",
      "label": "Read the action's metadata",
      "description": "Returns the size, the number of stored frames and the CRC-32 of the given record.",
      "read": {
        "args": {
          "struct": "id_args_t",
          "fields": [
            {
              "id": "id",
              "label": "Record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            }
          ]
        },
        "returns": {
          "struct": "sys_actions_info_t",
          "description": "Information about the action record",
          "fields": [
            {
              "id": "bytes",
              "label": "Size",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 0,
              "unit": "B"
            },
            {
              "id": "count",
              "label": "Number of frames",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 2
            },
            {
              "id": "crc32",
              "label": "CRC-32",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 4
            }
          ]
        }
      }
    },
    {
      "id": "LIST",
      "op": 9,
      "symbol": "SYS_ACTIONS_OP_LIST",
      "label": "List of action records",
      "description": "Returns the IDs of the action records stored in Flash, starting from the given ID.",
      "read": {
        "args": {
          "struct": "list_args_t",
          "fields": [
            {
              "id": "start",
              "label": "First record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            }
          ]
        },
        "returns": {
          "type": "u16",
          "label": "Total number of records",
          "description": "Then the u32 record IDs in ascending order from the given start: up to 48, as many as fit."
        }
      }
    },
    {
      "id": "REMOVE",
      "op": 10,
      "symbol": "SYS_ACTIONS_OP_REMOVE",
      "label": "Remove an action record",
      "description": "Removes the given action record from Flash.",
      "write": {
        "args": {
          "struct": "id_args_t",
          "fields": [
            {
              "id": "id",
              "label": "Record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            }
          ]
        }
      }
    },
    {
      "id": "ABORT",
      "op": 11,
      "symbol": "SYS_ACTIONS_OP_ABORT",
      "label": "Abort the upload or recording",
      "description": "Cancels the open upload or recording session and drops the data not stored yet.",
      "write": {}
    },
    {
      "id": "RUN_ALL",
      "op": 13,
      "symbol": "SYS_ACTIONS_OP_RUN_ALL",
      "label": "Run every frame of an action",
      "description": "Replays every frame of the action record without stopping at an error (the first error is returned).",
      "write": {
        "args": {
          "struct": "id_args_t",
          "fields": [
            {
              "id": "id",
              "label": "Record ID",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            }
          ]
        }
      }
    },
    {
      "id": "REMOVE_ALL",
      "op": 14,
      "symbol": "SYS_ACTIONS_OP_REMOVE_ALL",
      "label": "Remove all action records",
      "description": "Removes every stored record (settings, devices, the project and the user's actions). Refused while a recording or an upload is open.",
      "write": {}
    }
  ]
}
