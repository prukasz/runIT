{
  "$schema": "../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "contract-definition",
  "scope": "system",
  "id": "POWER_MANAGER",
  "contract_id": 6,
  "router_key": 10,
  "alias": "Power manager",
  "description": "Manages the power budget, the power sources (USB-PD, bench supply, battery), the response matrix for power faults, and the power events.",
  "category": "power",
  "commands": [
    {
      "id": "CONFIG",
      "op": 1,
      "symbol": "SYS_PWRM_OP_CONFIG",
      "record": "SYS_ACTIONS_ID_POWER_CFG",
      "label": "Power manager configuration",
      "description": "Sets how the power budget works: on / off, strict or with a soft margin, and the power source on a board without source pins.",
      "read": {
        "description": "Returns what SET_CONFIG sets.",
        "returns": {
          "struct": "sys_power_manager_cfg_t",
          "fields": [
            {
              "id": "enabled",
              "label": "Enabled",
              "type": "boolean",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "1 = budget control active, 0 = measure only"
            },
            {
              "id": "strict",
              "label": "Strict",
              "type": "boolean",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "1 = the rails are held to the budget, 0 = with the soft margin"
            },
            {
              "id": "soft_margin_pct",
              "label": "Soft margin",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "unit": "%",
              "description": "Allowed budget overrun when not strict, in percent (0..100)"
            },
            {
              "id": "source",
              "label": "Power source",
              "type": "enum",
              "raw_type": "u8",
              "size": 1,
              "offset": 3,
              "enum": "sys_power_source_e",
              "description": "The source on a board without source pins; a board with them detects it (ignored)"
            }
          ],
          "description": "Current power manager configuration"
        }
      },
      "write": {
        "description": "Sets how the power budget works: on / off, strict or with a soft margin, and the power source on a board without source pins.",
        "args": {
          "struct": "sys_power_manager_cfg_t",
          "fields": [
            {
              "id": "enabled",
              "label": "Enabled",
              "type": "boolean",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "1 = budget control active, 0 = measure only"
            },
            {
              "id": "strict",
              "label": "Strict",
              "type": "boolean",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "1 = the rails are held to the budget, 0 = with the soft margin"
            },
            {
              "id": "soft_margin_pct",
              "label": "Soft margin",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "unit": "%",
              "description": "Allowed budget overrun when not strict, in percent (0..100)"
            },
            {
              "id": "source",
              "label": "Power source",
              "type": "enum",
              "raw_type": "u8",
              "size": 1,
              "offset": 3,
              "enum": "sys_power_source_e",
              "description": "The source on a board without source pins; a board with them detects it (ignored)"
            }
          ]
        }
      }
    },
    {
      "id": "PSU",
      "op": 3,
      "symbol": "SYS_PWRM_OP_PSU",
      "record": "SYS_ACTIONS_ID_POWER_PSU",
      "label": "Set external supply limits",
      "description": "Sets the maximum voltage and current of an external power supply.",
      "read": {
        "description": "Returns the external supply limits as set (0 / 0: no supply entered).",
        "returns": {
          "struct": "sys_power_psu_t",
          "fields": [
            {
              "id": "max_mV",
              "label": "Maximum voltage",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0,
              "unit": "mV"
            },
            {
              "id": "max_mA",
              "label": "Maximum current",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 4,
              "unit": "mA"
            }
          ],
          "description": "External supply limits"
        }
      },
      "write": {
        "description": "Sets the maximum voltage and current of an external power supply.",
        "args": {
          "struct": "sys_power_psu_t",
          "fields": [
            {
              "id": "max_mV",
              "label": "Maximum voltage",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0,
              "unit": "mV"
            },
            {
              "id": "max_mA",
              "label": "Maximum current",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 4,
              "unit": "mA"
            }
          ]
        }
      }
    },
    {
      "id": "BATTERY",
      "op": 4,
      "symbol": "SYS_PWRM_OP_BATTERY",
      "record": "SYS_ACTIONS_ID_POWER_BATTERY",
      "label": "Set battery parameters",
      "description": "Sets the cell chemistry, the number of cells in series and the low and critical charge thresholds.",
      "read": {
        "description": "Returns the battery as set (chemistry None: no battery entered).",
        "returns": {
          "struct": "sys_power_battery_t",
          "fields": [
            {
              "id": "chemistry",
              "label": "Cell chemistry",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "options": [
                {
                  "label": "None",
                  "value": 0
                },
                {
                  "label": "LiPo (4.2 V per cell)",
                  "value": 1
                }
              ]
            },
            {
              "id": "cells",
              "label": "Number of cells",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "low_pct",
              "label": "Low threshold",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "unit": "%"
            },
            {
              "id": "critical_pct",
              "label": "Critical threshold",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 3,
              "unit": "%"
            }
          ],
          "description": "Battery parameters"
        }
      },
      "write": {
        "description": "Sets the cell chemistry, the number of cells in series and the low and critical charge thresholds.",
        "args": {
          "struct": "sys_power_battery_t",
          "fields": [
            {
              "id": "chemistry",
              "label": "Cell chemistry",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "options": [
                {
                  "label": "None",
                  "value": 0
                },
                {
                  "label": "LiPo (4.2 V per cell)",
                  "value": 1
                }
              ]
            },
            {
              "id": "cells",
              "label": "Number of cells",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "low_pct",
              "label": "Low threshold",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "unit": "%"
            },
            {
              "id": "critical_pct",
              "label": "Critical threshold",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 3,
              "unit": "%"
            }
          ]
        }
      }
    },
    {
      "id": "STATUS",
      "op": 7,
      "symbol": "SYS_PWRM_OP_STATUS",
      "label": "Read power status",
      "description": "Returns the active source, the power budget state, the input voltage readings and the battery state.",
      "read": {
        "returns": {
          "struct": "sys_power_status_t",
          "description": "Board power status",
          "fields": [
            {
              "id": "source",
              "label": "Active source",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0 unknown, 1 USB, 2 PSU, 3 battery"
            },
            {
              "id": "input_mV",
              "label": "Input voltage",
              "type": "integer",
              "raw_type": "i32",
              "size": 4,
              "offset": 1,
              "unit": "mV"
            },
            {
              "id": "input_mA",
              "label": "Input current",
              "type": "integer",
              "raw_type": "i32",
              "size": 4,
              "offset": 5,
              "unit": "mA"
            },
            {
              "id": "source_mV",
              "label": "Source voltage limit",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 9,
              "unit": "mV"
            },
            {
              "id": "source_mA",
              "label": "Source current limit",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 13,
              "unit": "mA"
            },
            {
              "id": "budget_mW",
              "label": "Budget",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 17,
              "unit": "mW",
              "description": "Without the soft margin"
            },
            {
              "id": "limit_mW",
              "label": "Limit",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 21,
              "unit": "mW",
              "description": "With the soft margin"
            },
            {
              "id": "allocated_mW",
              "label": "Allocated",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 25,
              "unit": "mW"
            },
            {
              "id": "battery_pct",
              "label": "Battery charge",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 29,
              "unit": "%",
              "description": "0xFF = unknown"
            },
            {
              "id": "flags",
              "label": "Flags",
              "type": "bitmask",
              "raw_type": "u8",
              "size": 1,
              "offset": 30,
              "description": "1 enabled, 2 strict, 4 over budget, 8 input seen"
            },
            {
              "id": "pd_mV",
              "label": "USB-PD voltage",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 31,
              "unit": "mV",
              "description": "The voltage of the USB-PD profile in use (0 = none)"
            },
            {
              "id": "pd_mA",
              "label": "USB-PD current",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 35,
              "unit": "mA",
              "description": "The most current that profile offers"
            },
            {
              "id": "pd_type",
              "label": "USB-PD profile",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 39,
              "description": "0 fixed, 1 PPS, 2 AVS (USB-PD option type), 255 none"
            }
          ]
        }
      }
    },
    {
      "id": "PD",
      "op": 8,
      "symbol": "SYS_PWRM_OP_PD",
      "record": "SYS_ACTIONS_ID_POWER_PD",
      "label": "USB-PD request",
      "description": "What to ask the USB-PD charger for on a USB source: its highest offer, or a set voltage at the most current offered there. A fixed profile below the set voltage raises PD_FIXED.",
      "read": {
        "description": "Returns what SET_PD sets.",
        "returns": {
          "struct": "sys_power_pd_t",
          "fields": [
            {
              "id": "mode",
              "label": "Request",
              "type": "enum",
              "enum": "sys_power_pd_mode_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "Off (the charger's 5 V), the highest offer, or the set voltage"
            },
            {
              "id": "voltage_mV",
              "label": "Voltage",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 1,
              "unit": "mV",
              "description": "The voltage of the Set voltage request; the current is the most offered there"
            }
          ],
          "description": "The USB-PD request"
        }
      },
      "write": {
        "description": "What to ask the USB-PD charger for on a USB source: its highest offer, or a set voltage at the most current offered there. A fixed profile below the set voltage raises PD_FIXED.",
        "args": {
          "struct": "sys_power_pd_t",
          "fields": [
            {
              "id": "mode",
              "label": "Request",
              "type": "enum",
              "enum": "sys_power_pd_mode_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "Off (the charger's 5 V), the highest offer, or the set voltage"
            },
            {
              "id": "voltage_mV",
              "label": "Voltage",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 1,
              "unit": "mV",
              "description": "The voltage of the Set voltage request; the current is the most offered there"
            }
          ]
        }
      }
    },
    {
      "id": "MATRIX",
      "op": 9,
      "symbol": "SYS_PWRM_OP_MATRIX",
      "record": "SYS_ACTIONS_ID_POWER_RESPONSES",
      "label": "Response matrix",
      "description": "The response to each power event, for the board and for each rail: a row per target (0xFFFF the board, else the rail's device ID). The write matches the rows by target; a target left out keeps its row.",
      "read": {
        "description": "Returns every row of the response matrix with its target: the board first, then the regulator rails in the order SET_RESPONSES takes them.",
        "returns": {
          "struct": "sys_power_response_row_t",
          "array": true,
          "description": "One row per target",
          "fields": [
            {
              "id": "target",
              "label": "Target",
              "type": "device",
              "raw_type": "u16",
              "size": 2,
              "offset": 0,
              "description": "0xFFFF for the board, or the device ID of a regulator rail"
            },
            {
              "id": "responses",
              "label": "Responses",
              "type": "enum",
              "enum": "sys_power_response_e",
              "index_enum": "sys_power_kind_e",
              "raw_type": "u8",
              "size": 11,
              "offset": 2,
              "description": "The response to each power event kind (sys_power_kind_e order)"
            }
          ]
        }
      },
      "write": {
        "description": "Saves the whole response matrix for the board and every regulator rail.",
        "args": {
          "struct": "sys_power_response_row_t",
          "array": true,
          "fields": [
            {
              "id": "target",
              "label": "Target",
              "type": "device",
              "raw_type": "u16",
              "size": 2,
              "offset": 0,
              "description": "0xFFFF for the board, or the device ID of a regulator rail"
            },
            {
              "id": "responses",
              "label": "Responses",
              "type": "enum",
              "enum": "sys_power_response_e",
              "index_enum": "sys_power_kind_e",
              "raw_type": "u8",
              "size": 11,
              "offset": 2,
              "description": "The response to each power event kind (sys_power_kind_e order)"
            }
          ]
        }
      }
    }
  ],
  "events": [
    {
      "id": "SOURCE_CHANGED",
      "event": 0,
      "code": 1536,
      "label": "Source changed",
      "description": "The board is now fed from another source",
      "notify": true,
      "symbol": "PWRM_EV_SOURCE_CHANGED",
      "value": {
        "description": "The new source (power source list)"
      }
    },
    {
      "id": "BATTERY_LOW",
      "event": 1,
      "code": 1537,
      "label": "Battery low",
      "description": "The battery charge passed the low threshold",
      "notify": true,
      "symbol": "PWRM_EV_BATTERY_LOW",
      "value": {
        "description": "The charge",
        "unit": "%"
      }
    },
    {
      "id": "BATTERY_CRITICAL",
      "event": 2,
      "code": 1538,
      "label": "Battery critical",
      "description": "The battery charge passed the critical threshold",
      "notify": true,
      "symbol": "PWRM_EV_BATTERY_CRITICAL",
      "value": {
        "description": "The charge",
        "unit": "%"
      }
    },
    {
      "id": "BUDGET_EXCEEDED",
      "event": 3,
      "code": 1539,
      "label": "Budget exceeded",
      "description": "The rails ask for more than the budget",
      "notify": true,
      "symbol": "PWRM_EV_BUDGET_EXCEEDED",
      "value": {
        "description": "The budget with the margin",
        "unit": "mW"
      }
    },
    {
      "id": "INPUT_OVP",
      "event": 4,
      "code": 1540,
      "label": "Input over-voltage",
      "description": "The input is above the board's maximum",
      "notify": true,
      "symbol": "PWRM_EV_INPUT_OVP",
      "value": {
        "description": "The input voltage",
        "unit": "mV"
      }
    },
    {
      "id": "PD_FIXED",
      "event": 5,
      "code": 1541,
      "label": "USB-PD fixed profile",
      "description": "The charger has no adjustable profile for the set voltage: a lower fixed one is in use",
      "notify": true,
      "symbol": "PWRM_EV_PD_FIXED",
      "value": {
        "description": "The voltage in use",
        "unit": "mV"
      }
    }
  ]
}
