{
  "$schema": "../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "CONNECTOR",
  "router_key": 4,
  "alias": "Data stream connectors (Data Connectors)",
  "description": "Managing the outgoing data streams (telemetry, logs, errors, events, user streams) and their bindings to transports (UART, BLE).",
  "category": "system",
  "record": "SYS_ACTIONS_ID_CONN",
  "commands": [
    {
      "id": "CREATE",
      "op": 1,
      "symbol": "OP_CREATE",
      "label": "Create a stream",
      "description": "Creates a user connector: a stream of frames that start with its byte.",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "connector",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The new connector: a byte that is not a system connector's or the router's answer byte; it starts each of its frames"
            }
          ]
        }
      }
    },
    {
      "id": "REMOVE",
      "op": 2,
      "symbol": "OP_REMOVE",
      "label": "Remove a stream",
      "description": "Removes a user stream and its bindings to transports.",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "connector",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector to remove"
            }
          ]
        }
      }
    },
    {
      "id": "BIND",
      "op": 3,
      "symbol": "OP_BIND",
      "label": "Bind to a transport",
      "description": "Binds a stream to a transport (UART, BLE) at the given endpoint.",
      "write": {
        "args": {
          "struct": "bind_t",
          "fields": [
            {
              "id": "connector",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector"
            },
            {
              "id": "provider",
              "label": "Transport",
              "type": "enum",
              "enum": "transport_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Provider (transport ID)"
            },
            {
              "id": "endpoint",
              "label": "Endpoint",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 2,
              "description": "The provider's endpoint (for BLE the 16-bit UUID of the characteristic, for UART 0)"
            }
          ]
        }
      }
    },
    {
      "id": "UNBIND",
      "op": 4,
      "symbol": "OP_UNBIND",
      "label": "Remove a binding",
      "description": "Removes the binding of a stream to the given transport.",
      "write": {
        "args": {
          "struct": "unbind_t",
          "fields": [
            {
              "id": "connector",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector"
            },
            {
              "id": "provider",
              "label": "Transport",
              "type": "enum",
              "enum": "transport_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Provider (transport ID)"
            }
          ]
        }
      }
    },
    {
      "id": "SUSPEND",
      "op": 5,
      "symbol": "OP_SUSPEND",
      "label": "Suspend a stream",
      "description": "Stops sending frames on a stream (they are dropped without blocking the sender).",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "connector",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector to suspend"
            }
          ]
        }
      }
    },
    {
      "id": "RESUME",
      "op": 6,
      "symbol": "OP_RESUME",
      "label": "Resume a stream",
      "description": "Resumes normal sending on a suspended stream.",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "connector",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector to resume"
            }
          ]
        }
      }
    },
    {
      "id": "INFO",
      "op": 7,
      "symbol": "OP_INFO",
      "label": "List the streams",
      "description": "Returns every active connector, its state (system, suspended) and its transport bindings.",
      "read": {
        "returns": {
          "type": "u8",
          "label": "Number of connectors",
          "description": "Then, for each connector: the connector, flags (bit 0 system, bit 1 suspended), number of bindings and the bindings (provider, endpoint)."
        }
      }
    }
  ]
}
