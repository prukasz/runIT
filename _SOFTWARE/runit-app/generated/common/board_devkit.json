{
  "$schema": "../../../templates/board.schema.json",
  "schemaVersion": 3,
  "kind": "board",
  "name": "runIT devkit",
  "revision": 1,
  "description": "A plain ESP32-S3 devkit running the runIT firmware: only the ESP32-S3's own pins as device 0, no onboard chips, powered from USB.",
  "source_files": [
    "boards/runit_r1_defs.h",
    "boards/runit_r1_power.c",
    "components/app/runit/Kconfig"
  ],
  "power": {
    "limits": {
      "max_mV": 5000,
      "max_mA": 1500,
      "reserve_mW": 1000,
      "unknown_source_mA": 1500,
      "vreg_efficiency_pct": 90
    },
    "rails": [],
    "muxes": [],
    "responses": {
      "ovp": "disable",
      "uvp": "notify",
      "spc": "disable",
      "ocp_warning": "notify",
      "ocp_critical": "notify",
      "otp": "safe_state",
      "battery_low": "notify",
      "battery_critical": "safe_state",
      "budget_exceeded": "disable",
      "source_changed": "notify"
    }
  },
  "devices": [
    {
      "id": 0,
      "symbol": "DEVICE_ID_ESP32S3_GPIO",
      "name": "ESP32-S3 GPIO",
      "alias": "ESP32-S3 GPIO",
      "type": "SYS_DEVICE_TYPE_ESP32S3_GPIO",
      "descriptor": "device_esp32s3_gpio",
      "description": "The ESP32-S3's own pins",
      "role": "mcu_gpio"
    },
    {
      "id": 1,
      "name": "Internal I2C",
      "description": "I2C bus 0 (the PCB's internal bus; on a devkit free for the user's chips)",
      "descriptor": "device_esp32s3_i2c",
      "pins": [
        {
          "use": "sda",
          "device": 0,
          "pin": 15
        },
        {
          "use": "scl",
          "device": 0,
          "pin": 16
        }
      ],
      "config": {
        "port": 0,
        "pullup": 1
      }
    },
    {
      "id": 2,
      "name": "User I2C",
      "description": "External user I2C bus for sensors and breakouts",
      "descriptor": "device_esp32s3_i2c",
      "pins": [
        {
          "use": "sda",
          "device": 0,
          "pin": 40
        },
        {
          "use": "scl",
          "device": 0,
          "pin": 41
        }
      ],
      "config": {
        "port": 1,
        "pullup": 1
      }
    }
  ],
  "pin_setup": [],
  "reserved_pins": [
    {
      "device": 0,
      "pin": 19,
      "label": "USB D-",
      "reason": "ESP32-S3 USB-Serial-JTAG data minus"
    },
    {
      "device": 0,
      "pin": 20,
      "label": "USB D+",
      "reason": "ESP32-S3 USB-Serial-JTAG data plus"
    },
    {
      "device": 0,
      "pin": 0,
      "label": "BOOT Strapping",
      "reason": "ESP32-S3 boot strap pin"
    },
    {
      "device": 0,
      "pin": 45,
      "label": "VDD_SPI Strapping",
      "reason": "ESP32-S3 SPI voltage strap pin"
    },
    {
      "device": 0,
      "pin": 46,
      "label": "ROM Strapping",
      "reason": "ESP32-S3 ROM boot log strap pin"
    }
  ],
  "terminals": []
}
