{
  "$schema": "../../../templates/vm-block.schema.json",
  "schemaVersion": 3,
  "kind": "vm-block",
  "id": "expr",
  "wire_id": 1,
  "alias": "Expression",
  "description": "Computes a number from its inputs with a formula that you write as an ordinary expression. The result goes to the output.",
  "category": "data",
  "order": 10,
  "tags": [
    "formula",
    "math",
    "calculate",
    "compute",
    "function",
    "equation",
    "logic",
    "compare",
    "select"
  ],
  "integration": "core",
  "state_len": 4,
  "state_variable": true,
  "editor": "expression",
  "opcodes": {
    "enum": "vm_expr_op_e",
    "constant": "f32"
  },
  "editor_values": [
    "expression"
  ],
  "activation": {
    "kind": "enabled",
    "text": "Computes on every pass while enabled, so the result always follows the inputs. Its enable-out is on every pass the result was written."
  },
  "header": {
    "subtitle": "{result} = {expression}"
  },
  "body": [
    "{expression}"
  ],
  "inputs": [
    {
      "group": {
        "alias": "Input",
        "description": "Read by the formula by position; only the inputs it names are read, and every input it names must be wired.",
        "value": "float",
        "min": 0,
        "max": 16,
        "label": "hidden"
      }
    }
  ],
  "outputs": [
    {
      "id": "result",
      "alias": "Result",
      "description": "The value of the formula.",
      "value": "float",
      "required": true
    }
  ]
}
