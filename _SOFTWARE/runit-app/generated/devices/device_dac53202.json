{
  "$schema": "../../../templates/device.schema.json",
  "schemaVersion": 3,
  "kind": "device-definition",
  "id": "dac53202",
  "alias": "DAC53202 dual DAC",
  "description": "Two-channel I2C digital-to-analog converter: outputs a steady voltage on each channel.",
  "type_id": 70,
  "type": {
    "symbol": "SYS_DEVICE_TYPE_DAC53202",
    "id": 70
  },
  "protocols": [
    "i2c"
  ],
  "tags": [
    "i2c",
    "dac",
    "voltage"
  ],
  "datasheet": "https://www.ti.com/lit/ds/symlink/dac53202.pdf",
  "config": {
    "struct": "dac53202_cfg_t",
    "size": 2,
    "fields": [
      {
        "id": "i2c_bus",
        "label": "I2C bus",
        "description": "The I2C bus the chip is on",
        "offset": 0,
        "size": 1,
        "type": "enum",
        "enum": "sys_i2c_bus_e",
        "raw_type": "u8"
      },
      {
        "id": "i2c_addr",
        "label": "I2C address",
        "description": "The A0 pin selects one of four addresses",
        "offset": 1,
        "size": 1,
        "type": "choice",
        "raw_type": "u8",
        "default": 72,
        "options": [
          {
            "label": "0x48 (A0 to GND)",
            "value": 72
          },
          {
            "label": "0x49 (A0 to VDD)",
            "value": 73
          },
          {
            "label": "0x4A (A0 to SDA)",
            "value": 74
          },
          {
            "label": "0x4B (A0 to SCL)",
            "value": 75
          }
        ]
      }
    ]
  },
  "ranges": {
    "VOLTAGE.voltage_mV": {
      "min": 0,
      "max": 3300,
      "step": 10
    }
  },
  "contracts": [
    "DEVICE",
    "IO"
  ],
  "bus": {
    "type": "i2c",
    "i2c": {
      "default_addr": 72,
      "address_range": {
        "min": 72,
        "max": 75
      },
      "max_speed_khz": 1000
    }
  },
  "provides": {
    "pins": {
      "count": 2,
      "modes": [
        "dac"
      ],
      "fixed_modes": true,
      "labels": [
        "OUT0",
        "OUT1"
      ]
    }
  },
  "power_pins": [
    {
      "name": "VDD",
      "kind": "vcc",
      "voltage_mV": {
        "min": 1800,
        "max": 5500,
        "nominal": 3300
      }
    },
    {
      "name": "GND",
      "kind": "gnd"
    }
  ],
  "electrical": {
    "supply_voltage_mV": {
      "min": 1800,
      "max": 5500,
      "nominal": 3300
    },
    "logic_voltage_mV": 3300,
    "max_current_mA": 5
  }
}
