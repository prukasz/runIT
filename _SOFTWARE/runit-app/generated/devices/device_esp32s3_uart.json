{
  "$schema": "../../../templates/device.schema.json",
  "schemaVersion": 3,
  "kind": "device-definition",
  "id": "esp32s3_uart",
  "alias": "ESP32-S3 UART Port",
  "description": "Hardware UART serial port controller on the ESP32-S3 SoC (ports 0, 1, and 2), supporting framed binary messages or raw byte streams.",
  "protocols": [
    "native",
    "uart"
  ],
  "tags": [
    "soc",
    "uart",
    "serial"
  ],
  "type_id": 77,
  "type": {
    "symbol": "ESP32S3_UART_TYPE",
    "id": 77
  },
  "config": {
    "struct": "esp32s3_uart_cfg_t",
    "size": 16,
    "fields": [
      {
        "id": "uart_num",
        "label": "UART port",
        "type": "choice",
        "raw_type": "u8",
        "size": 1,
        "offset": 0,
        "options": [
          {
            "label": "UART0",
            "value": 0
          },
          {
            "label": "UART1",
            "value": 1
          },
          {
            "label": "UART2",
            "value": 2
          }
        ],
        "default": 1,
        "description": "ESP32-S3 hardware UART peripheral number (0..2)"
      },
      {
        "id": "mode",
        "label": "Line mode",
        "type": "enum",
        "enum": "sys_uart_mode_e",
        "raw_type": "u8",
        "size": 1,
        "offset": 1,
        "default": "SYS_UART_MODE_FRAMED",
        "description": "Framing mode on the serial line (framed packets, raw bytes, or line-delimited)"
      },
      {
        "id": "baud",
        "label": "Baud rate",
        "type": "number",
        "raw_type": "u32",
        "size": 4,
        "offset": 2,
        "min": 1200,
        "max": 5000000,
        "default": 115200,
        "unit": "baud"
      },
      {
        "id": "parity",
        "label": "Parity",
        "type": "enum",
        "enum": "sys_uart_parity_e",
        "raw_type": "u8",
        "size": 1,
        "offset": 6,
        "default": "SYS_UART_PARITY_NONE"
      },
      {
        "id": "stop_bits",
        "label": "Stop bits",
        "type": "choice",
        "raw_type": "u8",
        "size": 1,
        "offset": 7,
        "options": [
          {
            "label": "1 stop bit",
            "value": 1
          },
          {
            "label": "2 stop bits",
            "value": 2
          }
        ],
        "default": 1,
        "description": "Number of stop bits (8 data bits)"
      },
      {
        "id": "tx_pin",
        "label": "TX pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 8,
        "pin_ref": true,
        "requires": "output",
        "optional": true,
        "description": "ESP32-S3 GPIO pin for UART TX (optional if RX only)"
      },
      {
        "id": "rx_pin",
        "label": "RX pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 10,
        "pin_ref": true,
        "requires": "input",
        "optional": true,
        "description": "ESP32-S3 GPIO pin for UART RX (optional if TX only)"
      },
      {
        "id": "rts_pin",
        "label": "RTS pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 12,
        "pin_ref": true,
        "requires": "output",
        "optional": true,
        "description": "Optional GPIO pin for hardware RTS flow control"
      },
      {
        "id": "cts_pin",
        "label": "CTS pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 14,
        "pin_ref": true,
        "requires": "input",
        "optional": true,
        "description": "Optional GPIO pin for hardware CTS flow control"
      }
    ]
  },
  "contracts": [
    "DEVICE",
    "UART"
  ]
}
