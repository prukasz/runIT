{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "STREAM",
  "router_key": 41,
  "alias": "Data streams",
  "description": "The board's data streams (telemetry, logs, errors, events, user streams): each carries messages to one list of targets (SOURCE reads a local provider, SINK writes a provider on this board or another peer, PEER is a subscribed peer, CALLBACK is the board's code).",
  "category": "system",
  "record": "SYS_ACTIONS_ID_STREAM",
  "commands": [
    {
      "id": "CREATE",
      "op": 1,
      "symbol": "SYS_STREAM_OP_CREATE",
      "label": "Create a stream",
      "description": "Creates a user stream with its byte id and flags.",
      "write": {
        "args": {
          "struct": "sys_stream_cfg_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The new stream: 0x01..0x7F, not one that exists (0x80 and more are the session's channels)"
            },
            {
              "id": "flags",
              "label": "Flags",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "SYS_STREAM_FLAG_URGENT: its frames go first on every way out"
            }
          ]
        }
      }
    },
    {
      "id": "REMOVE",
      "op": 2,
      "symbol": "SYS_STREAM_OP_REMOVE",
      "label": "Remove a stream",
      "description": "Removes a user stream and its targets; its SOURCE providers are free again.",
      "write": {
        "args": {
          "struct": "sys_stream_ref_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The stream"
            }
          ]
        }
      }
    },
    {
      "id": "SOURCE",
      "op": 3,
      "symbol": "SYS_STREAM_OP_SOURCE",
      "label": "Bind a source provider",
      "description": "Takes a local provider's RX hook so everything arriving there enters the stream (the stream then refuses direct sends).",
      "write": {
        "args": {
          "struct": "sys_stream_source_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The stream"
            },
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "The local provider's id"
            }
          ]
        }
      }
    },
    {
      "id": "SINK",
      "op": 4,
      "symbol": "SYS_STREAM_OP_SINK",
      "label": "Add a sink provider",
      "description": "Sends each message payload as is to a provider of this board (its id or 0xFE) or of another peer (in a session DATA frame).",
      "write": {
        "args": {
          "struct": "sys_stream_sink_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The stream"
            },
            {
              "id": "board",
              "label": "Board",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "The board or client id (this board's id or 0xFE SYS_SESSION_ID_SELF for local)"
            },
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "description": "The provider's id on that board"
            }
          ]
        }
      }
    },
    {
      "id": "UNBIND",
      "op": 5,
      "symbol": "SYS_STREAM_OP_UNBIND",
      "label": "Unbind from a provider",
      "description": "Removes every SOURCE and SINK target of this provider (on any board); a SOURCE closes its provider RX hook.",
      "write": {
        "args": {
          "struct": "sys_stream_source_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The stream"
            },
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "The provider's id"
            }
          ]
        }
      }
    },
    {
      "id": "UNBIND_ALL",
      "op": 6,
      "symbol": "SYS_STREAM_OP_UNBIND_ALL",
      "label": "Unbind everything",
      "description": "Removes every SOURCE and SINK target of the stream.",
      "write": {
        "args": {
          "struct": "sys_stream_ref_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The stream"
            }
          ]
        }
      }
    },
    {
      "id": "LIST",
      "op": 7,
      "symbol": "SYS_STREAM_OP_LIST",
      "label": "List the streams",
      "description": "Returns every stream, its state and its targets.",
      "read": {
        "returns": {
          "type": "u8",
          "label": "Number of streams",
          "description": "Then, per stream: its head (id, flags, state, target count), then its targets (type u8, peer u8, provider u8, dropped u16)."
        }
      }
    },
    {
      "id": "SUBSCRIBE",
      "op": 8,
      "symbol": "SYS_STREAM_OP_SUBSCRIBE",
      "label": "Subscribe to a stream",
      "description": "The peer that sends it gets the stream's messages, [stream id][payload] in a PUSH frame, until UNSUBSCRIBE or its session ends.",
      "write": {
        "args": {
          "struct": "sys_stream_ref_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The stream"
            }
          ]
        }
      }
    },
    {
      "id": "UNSUBSCRIBE",
      "op": 9,
      "symbol": "SYS_STREAM_OP_UNSUBSCRIBE",
      "label": "Unsubscribe from a stream",
      "description": "Ends the sender's subscription to the stream.",
      "write": {
        "args": {
          "struct": "sys_stream_ref_t",
          "fields": [
            {
              "id": "id",
              "label": "Stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The stream"
            }
          ]
        }
      }
    }
  ]
}
