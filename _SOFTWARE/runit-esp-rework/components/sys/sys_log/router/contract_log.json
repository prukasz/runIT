{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "LOG",
  "router_key": 42,
  "alias": "Logs and errors",
  "description": "What ESP_LOG prints, where lines go, whether reported error chains are traced and sent, and the board's ring buffer of latest error records.",
  "category": "system",
  "record": "SYS_ACTIONS_ID_LOG",
  "commands": [
    {
      "id": "CONFIG",
      "op": 1,
      "symbol": "LOG_OP_CONFIG",
      "label": "Log and error output options",
      "description": "Read or update the five log and error output options: level, serial console mirror, error log tracing, error stream sending, and log stream sending.",
      "read": {
        "returns": {
          "struct": "sys_log_cfg_t",
          "fields": [
            {
              "id": "level",
              "label": "Log level",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0=None, 1=Error, 2=Warn, 3=Info, 4=Debug, 5=Verbose (capped by CONFIG_LOG_MAXIMUM_LEVEL)"
            },
            {
              "id": "mirror_serial",
              "label": "Mirror to serial",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "1 = also print ESP_LOG lines to the console UART / USB-Serial-JTAG, 0 = stream only"
            },
            {
              "id": "trace_errors",
              "label": "Trace errors to logs",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "description": "1 = print reported error chains as log lines, 0 = error record only"
            },
            {
              "id": "send_errors",
              "label": "Send errors on stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 3,
              "description": "1 = send error records on SYS_STREAM_ERRORS (still kept in history), 0 = disabled"
            },
            {
              "id": "send_logs",
              "label": "Send logs on stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 4,
              "description": "1 = send cleaned ESP_LOG lines on SYS_STREAM_LOGS, 0 = disabled"
            }
          ]
        }
      },
      "write": {
        "args": {
          "struct": "sys_log_cfg_t",
          "fields": [
            {
              "id": "level",
              "label": "Log level",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0=None .. CONFIG_LOG_MAXIMUM_LEVEL"
            },
            {
              "id": "mirror_serial",
              "label": "Mirror to serial",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "0 or 1"
            },
            {
              "id": "trace_errors",
              "label": "Trace errors to logs",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "description": "0 or 1"
            },
            {
              "id": "send_errors",
              "label": "Send errors on stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 3,
              "description": "0 or 1"
            },
            {
              "id": "send_logs",
              "label": "Send logs on stream",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 4,
              "description": "0 or 1"
            }
          ]
        }
      }
    },
    {
      "id": "ERRORS",
      "op": 3,
      "symbol": "LOG_OP_ERRORS",
      "label": "Read error history",
      "description": "Returns [u8 total][error record] for the kept error record at index (0 = oldest); returns only [u8 total] when index >= total.",
      "read": {
        "args": {
          "struct": "sys_log_errors_args_t",
          "fields": [
            {
              "id": "index",
              "label": "Index",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0 = the oldest kept error record"
            }
          ]
        },
        "returns": {
          "type": "bytes",
          "label": "Total count and error record",
          "description": "u8 total kept count followed by the packed error record (up to SYS_LOG_RECORD_MAX bytes), or just u8 total if index is past the end."
        }
      }
    }
  ]
}
