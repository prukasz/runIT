menu "sys_log"

    config SYS_LOG_LINE_MAX
        int "Max log line (bytes)"
        default 160
        range 64 512
        help
          Longest cleaned ESP_LOG line queued to SYS_STREAM_LOGS; longer lines
          are truncated before sending.

    config SYS_LOG_ERRORS_KEPT
        int "Error history capacity"
        default 16
        range 1 64
        help
          How many recent error records (up to SYS_LOG_RECORD_MAX bytes each)
          are kept in memory for LOG_OP_ERRORS; older ones are overwritten.

endmenu
