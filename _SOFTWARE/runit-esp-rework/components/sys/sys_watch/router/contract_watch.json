{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "WATCH",
  "router_key": 43,
  "alias": "Watches",
  "description": "Reads this board runs by a trigger (a period, a change of the answer, an event) and pushes as entries [0x80][id][status][data] to the caller that added them.",
  "category": "system",
  "commands": [
    {
      "id": "ADD",
      "op": 1,
      "symbol": "WATCH_OP_ADD",
      "label": "Add a watch",
      "description": "Adds or replaces a watch identified by (owner, id); payload is sys_watch_head_t (14 B) followed by the read command (2..48 B).",
      "write": {
        "args": {
          "struct": "sys_watch_head_t",
          "tail": "read",
          "fields": [
            {
              "id": "id",
              "label": "Id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "Caller's watch id (1..255); adding an existing id replaces it"
            },
            {
              "id": "trigger",
              "label": "Trigger",
              "type": "enum",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "enum": "sys_watch_trigger_e",
              "description": "PERIODIC (0), ON_CHANGE (1), ON_EVENT (2)"
            },
            {
              "id": "period",
              "label": "Period",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 2,
              "description": "Ticks of 10 ms (>= 1). PERIODIC/ON_CHANGE cadence; ON_EVENT minimum gap"
            },
            {
              "id": "max_silence",
              "label": "Max silence",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 4,
              "description": "Ticks of 10 ms. ON_CHANGE sends unchanged value after this many silent ticks (0 = never)"
            },
            {
              "id": "tag",
              "label": "Filter tag",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 6,
              "description": "sys_event_key_t.tag for ON_EVENT (SYS_EVENT_ANY_TAG = 0)"
            },
            {
              "id": "source",
              "label": "Filter source",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 10,
              "description": "sys_event_key_t.source for ON_EVENT (SYS_EVENT_ANY_SOURCE = 0xFFFF)"
            },
            {
              "id": "channel",
              "label": "Filter channel",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 12,
              "description": "sys_event_key_t.channel for ON_EVENT (SYS_EVENT_ANY_CHANNEL = 0xFFFF)"
            }
          ]
        }
      }
    },
    {
      "id": "REMOVE",
      "op": 2,
      "symbol": "WATCH_OP_REMOVE",
      "label": "Remove a watch",
      "description": "Removes the watch identified by (origin->src, id).",
      "write": {
        "args": {
          "struct": "sys_watch_ref_t",
          "fields": [
            {
              "id": "id",
              "label": "Id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "Watch id to remove"
            }
          ]
        }
      }
    },
    {
      "id": "LIST",
      "op": 3,
      "symbol": "WATCH_OP_LIST",
      "label": "List watches",
      "description": "Returns u8 count followed by count sys_watch_info_t records (16 B each).",
      "read": {
        "reply": {
          "variable": true,
          "struct": "sys_watch_info_t"
        }
      }
    }
  ]
}
