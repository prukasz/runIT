{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit -p .)",
      "Bash(npx tsc -p tsconfig.app.json --noEmit)",
      "Bash(npx tsc --noEmit -p tsconfig.app.json)",
      "Bash(npx vitest run)",
      "Bash(npm test)"
    ]
  },
  "env": {
    "ECC_GATEGUARD": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/graphify_hint.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/skills/runit-root/SKILL.md"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'DESIGN IN PROGRESS: runIT is not released or deployed. Firmware, app and wire format change together, in one change. No backward compatibility: never keep old formats, aliases or fallbacks, never bump SYS_SESSION_VERSION or other version numbers for a format change, never warn about old firmware or old app builds.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node runit-app/tools/check-ui.mjs --hook"
          }
        ]
      }
    ]
  }
}
