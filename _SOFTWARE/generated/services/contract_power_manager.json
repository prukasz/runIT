{
  "$schema": "../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "contract-definition",
  "scope": "system",
  "id": "POWER_MANAGER",
  "contract_id": 6,
  "router_key": 10,
  "alias": "Power manager",
  "description": "Manages the power budget, the power sources (USB-PD, bench supply, battery), the response matrix for power faults, and the power events.",
  "category": "power",
  "commands": [
    {
      "id": "SET_CONFIG",
      "op": 1,
      "symbol": "SYS_PWRM_OP_SET_CONFIG",
      "label": "Power manager configuration",
      "description": "Sets the operating mode of the power manager (strict budget, margin, USB-PD auto-negotiation).",
      "args": {
        "struct": "sys_power_manager_cfg_t",
        "fields": [
          {
            "id": "enabled",
            "label": "Enabled",
            "type": "boolean",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "1 = budget control active, 0 = measure only"
          },
          {
            "id": "strict",
            "label": "Strict",
            "type": "boolean",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "description": "1 = reject overruns outright, 0 = soft margin"
          },
          {
            "id": "soft_margin_pct",
            "label": "Soft margin",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 2,
            "unit": "%",
            "description": "Allowed budget overrun, in percent"
          },
          {
            "id": "source_device",
            "label": "Source pin device",
            "type": "device",
            "raw_type": "u16",
            "size": 2,
            "offset": 3,
            "description": "Device of the pin that tells a battery from a USB input"
          },
          {
            "id": "source_pin",
            "label": "Source pin",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 5,
            "description": "Pin number on that device"
          },
          {
            "id": "battery_level",
            "label": "Battery pin level",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 6
          },
          {
            "id": "pd_max_auto",
            "label": "USB-PD auto-negotiation",
            "type": "boolean",
            "raw_type": "u8",
            "size": 1,
            "offset": 7,
            "description": "1 = automatically request the offer with the highest power"
          },
          {
            "id": "ext_input",
            "label": "External input type",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 8,
            "options": [
              {
                "label": "Bench supply",
                "value": 0
              },
              {
                "label": "Battery pack",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": "GET_CONFIG",
      "op": 2,
      "symbol": "SYS_PWRM_OP_GET_CONFIG",
      "label": "Read power manager configuration",
      "description": "Returns the operating mode of the power manager.",
      "returns": {
        "struct": "sys_power_manager_cfg_t",
        "description": "Current power manager configuration",
        "fields": [
          {
            "id": "enabled",
            "label": "Enabled",
            "type": "boolean",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "1 = budget control active, 0 = measure only"
          },
          {
            "id": "strict",
            "label": "Strict",
            "type": "boolean",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "description": "1 = reject overruns outright, 0 = soft margin"
          },
          {
            "id": "soft_margin_pct",
            "label": "Soft margin",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 2,
            "unit": "%",
            "description": "Allowed budget overrun, in percent"
          },
          {
            "id": "source_device",
            "label": "Source pin device",
            "type": "device",
            "raw_type": "u16",
            "size": 2,
            "offset": 3,
            "description": "Device of the pin that tells a battery from a USB input"
          },
          {
            "id": "source_pin",
            "label": "Source pin",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 5,
            "description": "Pin number on that device"
          },
          {
            "id": "battery_level",
            "label": "Battery pin level",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 6
          },
          {
            "id": "pd_max_auto",
            "label": "USB-PD auto-negotiation",
            "type": "boolean",
            "raw_type": "u8",
            "size": 1,
            "offset": 7,
            "description": "1 = automatically request the offer with the highest power"
          },
          {
            "id": "ext_input",
            "label": "External input type",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 8,
            "options": [
              {
                "label": "Bench supply",
                "value": 0
              },
              {
                "label": "Battery pack",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SET_PSU",
      "op": 3,
      "symbol": "SYS_PWRM_OP_SET_PSU",
      "label": "Set external supply limits",
      "description": "Sets the maximum voltage and current of an external power supply.",
      "args": {
        "struct": "sys_power_psu_t",
        "fields": [
          {
            "id": "max_mV",
            "label": "Maximum voltage",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 0,
            "unit": "mV"
          },
          {
            "id": "max_mA",
            "label": "Maximum current",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 4,
            "unit": "mA"
          }
        ]
      }
    },
    {
      "id": "SET_BATTERY",
      "op": 4,
      "symbol": "SYS_PWRM_OP_SET_BATTERY",
      "label": "Set battery parameters",
      "description": "Sets the cell chemistry, the number of cells in series and the low and critical charge thresholds.",
      "args": {
        "struct": "sys_power_battery_t",
        "fields": [
          {
            "id": "chemistry",
            "label": "Cell chemistry",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "options": [
              {
                "label": "None",
                "value": 0
              },
              {
                "label": "LiPo (4.2 V per cell)",
                "value": 1
              }
            ]
          },
          {
            "id": "cells",
            "label": "Number of cells",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 1
          },
          {
            "id": "low_pct",
            "label": "Low threshold",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 2,
            "unit": "%"
          },
          {
            "id": "critical_pct",
            "label": "Critical threshold",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 3,
            "unit": "%"
          }
        ]
      }
    },
    {
      "id": "SET_RESPONSE",
      "op": 5,
      "symbol": "SYS_PWRM_OP_SET_RESPONSE",
      "label": "Set power event response",
      "description": "Sets the response (notify, disable, reset, safe state) to a power event, for one rail or for the whole board.",
      "args": {
        "struct": "response_args_t",
        "fields": [
          {
            "id": "target",
            "label": "Target (board or rail ID)",
            "type": "integer",
            "raw_type": "u16",
            "size": 2,
            "offset": 0,
            "description": "0xFFFF for the board, or the device ID of a regulator"
          },
          {
            "id": "kind",
            "label": "Power event type",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 2,
            "options": [
              {
                "label": "OVP",
                "value": 1
              },
              {
                "label": "UVP",
                "value": 2
              },
              {
                "label": "SPC",
                "value": 3
              },
              {
                "label": "OCP warning",
                "value": 4
              },
              {
                "label": "OCP critical",
                "value": 5
              },
              {
                "label": "OTP",
                "value": 6
              },
              {
                "label": "Battery low",
                "value": 7
              },
              {
                "label": "Battery critical",
                "value": 8
              },
              {
                "label": "Budget exceeded",
                "value": 9
              },
              {
                "label": "Source changed",
                "value": 10
              }
            ]
          },
          {
            "id": "response",
            "label": "Required response",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 3,
            "options": [
              {
                "label": "Notify only",
                "value": 0
              },
              {
                "label": "Disable output",
                "value": 1
              },
              {
                "label": "Reset device",
                "value": 2
              },
              {
                "label": "Safe state",
                "value": 3
              }
            ]
          }
        ]
      }
    },
    {
      "id": "GET_RESPONSES",
      "op": 6,
      "symbol": "SYS_PWRM_OP_GET_RESPONSES",
      "label": "Read power event responses of a target",
      "description": "Returns the response to every event type for the given target.",
      "args": {
        "struct": "target_args_t",
        "fields": [
          {
            "id": "target",
            "label": "Target",
            "type": "integer",
            "raw_type": "u16",
            "size": 2,
            "offset": 0
          }
        ]
      },
      "returns": {
        "type": "bytes",
        "description": "Array of response codes"
      }
    },
    {
      "id": "GET_STATUS",
      "op": 7,
      "symbol": "SYS_PWRM_OP_GET_STATUS",
      "label": "Read power status",
      "description": "Returns the active source, the power budget state, the input voltage readings and the battery state.",
      "returns": {
        "struct": "sys_power_status_t",
        "description": "Board power status",
        "fields": [
          {
            "id": "source",
            "label": "Active source",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "0 unknown, 1 USB, 2 PSU, 3 battery"
          },
          {
            "id": "input_mV",
            "label": "Input voltage",
            "type": "integer",
            "raw_type": "i32",
            "size": 4,
            "offset": 1,
            "unit": "mV"
          },
          {
            "id": "input_mA",
            "label": "Input current",
            "type": "integer",
            "raw_type": "i32",
            "size": 4,
            "offset": 5,
            "unit": "mA"
          },
          {
            "id": "source_mV",
            "label": "Source voltage limit",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 9,
            "unit": "mV"
          },
          {
            "id": "source_mA",
            "label": "Source current limit",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 13,
            "unit": "mA"
          },
          {
            "id": "budget_mW",
            "label": "Budget",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 17,
            "unit": "mW",
            "description": "Without the soft margin"
          },
          {
            "id": "limit_mW",
            "label": "Limit",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 21,
            "unit": "mW",
            "description": "With the soft margin"
          },
          {
            "id": "allocated_mW",
            "label": "Allocated",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 25,
            "unit": "mW"
          },
          {
            "id": "battery_pct",
            "label": "Battery charge",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 29,
            "unit": "%",
            "description": "0xFF = unknown"
          },
          {
            "id": "flags",
            "label": "Flags",
            "type": "bitmask",
            "raw_type": "u8",
            "size": 1,
            "offset": 30,
            "description": "1 enabled, 2 strict, 4 over budget, 8 input seen"
          }
        ]
      }
    },
    {
      "id": "NEGOTIATE_MAX",
      "op": 8,
      "symbol": "SYS_PWRM_OP_NEGOTIATE_MAX",
      "label": "Negotiate maximum USB-PD power",
      "description": "Asks the USB-PD charger for its highest-power offer."
    },
    {
      "id": "SET_RESPONSES",
      "op": 9,
      "symbol": "SYS_PWRM_OP_SET_RESPONSES",
      "label": "Set the full response matrix",
      "description": "Saves the whole response matrix for the board and every regulator rail.",
      "args": {
        "fields": [
          {
            "id": "matrix",
            "label": "Response matrix",
            "type": "string",
            "raw_type": "bytes",
            "description": "All response rows (the rest of the frame)"
          }
        ]
      }
    }
  ],
  "events": [
    {
      "id": "SOURCE_CHANGED",
      "event": 0,
      "code": 1536,
      "label": "Source changed",
      "description": "The board is now fed from another source",
      "notify": true,
      "symbol": "PWRM_EV_SOURCE_CHANGED",
      "value": {
        "description": "The new source (power source list)"
      }
    },
    {
      "id": "BATTERY_LOW",
      "event": 1,
      "code": 1537,
      "label": "Battery low",
      "description": "The battery charge passed the low threshold",
      "notify": true,
      "symbol": "PWRM_EV_BATTERY_LOW",
      "value": {
        "description": "The charge",
        "unit": "%"
      }
    },
    {
      "id": "BATTERY_CRITICAL",
      "event": 2,
      "code": 1538,
      "label": "Battery critical",
      "description": "The battery charge passed the critical threshold",
      "notify": true,
      "symbol": "PWRM_EV_BATTERY_CRITICAL",
      "value": {
        "description": "The charge",
        "unit": "%"
      }
    },
    {
      "id": "BUDGET_EXCEEDED",
      "event": 3,
      "code": 1539,
      "label": "Budget exceeded",
      "description": "The rails ask for more than the budget",
      "notify": true,
      "symbol": "PWRM_EV_BUDGET_EXCEEDED",
      "value": {
        "description": "The budget with the margin",
        "unit": "mW"
      }
    },
    {
      "id": "INPUT_OVP",
      "event": 4,
      "code": 1540,
      "label": "Input over-voltage",
      "description": "The input is above the board's maximum",
      "notify": true,
      "symbol": "PWRM_EV_INPUT_OVP",
      "value": {
        "description": "The input voltage",
        "unit": "mV"
      }
    }
  ]
}
