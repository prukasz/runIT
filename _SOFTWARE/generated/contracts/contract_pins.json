{
  "$schema": "../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "contract-definition",
  "id": "PINS",
  "contract_id": 2,
  "alias": "Pin locks",
  "description": "Claiming a pin of a device for another device",
  "category": "gpio",
  "commands": [
    {
      "id": "AVAILABLE",
      "op": 0,
      "label": "Available pins",
      "description": "The pins the device has.",
      "symbol": "PINS_OP_AVAILABLE",
      "returns": {
        "type": "u64",
        "label": "Pins"
      }
    },
    {
      "id": "LOCKED",
      "op": 1,
      "label": "Locked pins",
      "description": "The pins that are locked.",
      "symbol": "PINS_OP_LOCKED",
      "returns": {
        "type": "u64",
        "label": "Pins"
      }
    },
    {
      "id": "LOCK",
      "op": 2,
      "invasive": true,
      "label": "Lock pin",
      "description": "Claims a pin for another device (refused if it is locked).",
      "symbol": "PINS_OP_LOCK",
      "args": {
        "fields": [
          {
            "id": "pin",
            "label": "Pin",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "The pin of the device"
          }
        ],
        "struct": "pins_pin_args_t"
      }
    },
    {
      "id": "UNLOCK",
      "op": 3,
      "invasive": true,
      "label": "Unlock pin",
      "description": "Releases a claimed pin.",
      "symbol": "PINS_OP_UNLOCK",
      "args": {
        "fields": [
          {
            "id": "pin",
            "label": "Pin",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "The pin of the device"
          }
        ],
        "struct": "pins_pin_args_t"
      }
    },
    {
      "id": "SET_LOCKED_LEVEL",
      "op": 4,
      "invasive": true,
      "label": "Set locked level",
      "description": "The owner of a locked pin drives it.",
      "symbol": "PINS_OP_SET_LOCKED_LEVEL",
      "args": {
        "fields": [
          {
            "id": "pin",
            "label": "Pin",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "The locked pin"
          },
          {
            "id": "level",
            "label": "Level",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "options": [
              {
                "label": "Low",
                "value": 0
              },
              {
                "label": "High",
                "value": 1
              }
            ]
          }
        ],
        "struct": "pins_level_args_t"
      }
    }
  ]
}
