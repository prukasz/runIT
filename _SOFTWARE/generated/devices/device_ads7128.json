{
  "$schema": "../../templates/device.schema.json",
  "schemaVersion": 3,
  "kind": "device-definition",
  "id": "ads7128",
  "alias": "ADS7128 ADC",
  "description": "Eight-channel ADC with I2C control and an on-chip window comparator.",
  "type_id": 71,
  "type": {
    "symbol": "SYS_DEVICE_TYPE_ADS7128",
    "id": 71
  },
  "protocols": [
    "i2c"
  ],
  "tags": [
    "i2c",
    "adc",
    "io",
    "voltage",
    "ic"
  ],
  "datasheet": "https://www.ti.com/lit/ds/symlink/ads7128.pdf",
  "config": {
    "struct": "ads7128_cfg_t",
    "size": 7,
    "fields": [
      {
        "id": "i2c_bus",
        "label": "I2C bus",
        "description": "The I2C bus the chip is on",
        "offset": 0,
        "size": 1,
        "type": "enum",
        "enum": "sys_i2c_bus_e",
        "raw_type": "u8"
      },
      {
        "id": "i2c_addr",
        "label": "I2C address",
        "description": "The resistor on the ADDR pin selects the address at power-up",
        "offset": 1,
        "size": 1,
        "type": "number",
        "raw_type": "u8"
      },
      {
        "id": "intr_pin",
        "label": "ALERT",
        "description": "Open-drain, active-low; the device reads its falling edge",
        "offset": 2,
        "size": 3,
        "type": "pin",
        "raw_type": "bytes",
        "pin_ref": true,
        "requires": "output",
        "optional": true
      },
      {
        "id": "full_scale_mV",
        "label": "ADC reference voltage",
        "description": "The input voltage that reads full scale: the chip's AVDD on a bare chip (2350 to 5500 mV), 20000 on the runIT board (its front end scales the inputs to 20 V)",
        "offset": 5,
        "size": 2,
        "type": "number",
        "raw_type": "u16",
        "default": 20000,
        "unit": "mV",
        "min": 1
      }
    ]
  },
  "contracts": [
    "DEVICE",
    "IO"
  ],
  "bus": {
    "type": "i2c",
    "i2c": {
      "default_addr": 16,
      "address_range": {
        "min": 16,
        "max": 23
      },
      "max_speed_khz": 1000
    }
  },
  "provides": {
    "pins": {
      "count": 8,
      "modes": [
        "adc"
      ],
      "labels": [
        "AIN0",
        "AIN1",
        "AIN2",
        "AIN3",
        "AIN4",
        "AIN5",
        "AIN6",
        "AIN7"
      ]
    }
  },
  "power_pins": [
    {
      "name": "AVDD",
      "kind": "vcc",
      "voltage_mV": {
        "min": 2350,
        "max": 5500,
        "nominal": 3300
      }
    },
    {
      "name": "GND",
      "kind": "gnd"
    }
  ],
  "electrical": {
    "supply_voltage_mV": {
      "min": 2350,
      "max": 5500,
      "nominal": 3300
    },
    "logic_voltage_mV": 3300,
    "max_current_mA": 2
  }
}
