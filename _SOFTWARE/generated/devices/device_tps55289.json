{
  "$schema": "../../templates/device.schema.json",
  "schemaVersion": 3,
  "kind": "device-definition",
  "id": "tps55289",
  "alias": "TPS55289 buck-boost regulator",
  "description": "Adjustable I2C buck-boost voltage regulator: a programmable power output with a current limit and enable control.",
  "type_id": 67,
  "type": {
    "symbol": "SYS_DEVICE_TYPE_TPS55289",
    "id": 67
  },
  "protocols": [
    "i2c"
  ],
  "tags": [
    "i2c",
    "power",
    "voltage",
    "current",
    "regulator"
  ],
  "datasheet": "https://www.ti.com/lit/ds/symlink/tps55289.pdf",
  "config": {
    "struct": "tps55289_cfg_t",
    "size": 8,
    "fields": [
      {
        "id": "i2c_bus",
        "label": "I2C bus",
        "description": "The I2C bus the chip is on",
        "offset": 0,
        "size": 1,
        "type": "enum",
        "enum": "sys_i2c_bus_e",
        "raw_type": "u8"
      },
      {
        "id": "i2c_addr",
        "label": "I2C address",
        "description": "The MODE pin selects one of two addresses",
        "offset": 1,
        "size": 1,
        "type": "choice",
        "raw_type": "u8",
        "default": 116,
        "options": [
          {
            "label": "0x74 (MODE pin low)",
            "value": 116
          },
          {
            "label": "0x75 (MODE pin high)",
            "value": 117
          }
        ]
      },
      {
        "id": "intr_pin",
        "label": "FB/INT",
        "description": "Open-drain, active-low: faults; needs CONFIGURE_INTR on its device",
        "offset": 2,
        "size": 3,
        "type": "pin",
        "raw_type": "bytes",
        "pin_ref": true,
        "requires": "output",
        "optional": true
      },
      {
        "id": "en_pin",
        "label": "EN",
        "description": "The hardware switch of the rail; the chip forgets its registers while it is low",
        "offset": 5,
        "size": 3,
        "type": "pin",
        "raw_type": "bytes",
        "pin_ref": true,
        "requires": "output",
        "optional": true
      }
    ]
  },
  "contracts": [
    "DEVICE",
    "POWER_VREG"
  ],
  "commands": [
    {
      "id": "set_protection",
      "op": 1,
      "symbol": "TPS55289_OP_SET_PROTECTION",
      "label": "Set protection",
      "description": "Sets hardware protection register settings (OCP delay, hiccup mode, fault mask, active discharge)",
      "args": {
        "struct": "tps55289_protection_t",
        "fields": [
          {
            "id": "ocp_delay",
            "label": "OCP delay",
            "description": "Overcurrent protection response delay",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "options": [
              {
                "label": "128 us",
                "value": 0
              },
              {
                "label": "3.072 ms",
                "value": 1
              },
              {
                "label": "6.144 ms",
                "value": 2
              },
              {
                "label": "12.288 ms",
                "value": 3
              }
            ],
            "default": 1
          },
          {
            "id": "hiccup",
            "label": "Hiccup mode",
            "description": "Restart automatically on short-circuit after 76ms vs latch off",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "options": [
              {
                "label": "Latch off",
                "value": 0
              },
              {
                "label": "Hiccup restart",
                "value": 1
              }
            ],
            "default": 1
          },
          {
            "id": "fault_mask",
            "label": "Fault mask",
            "description": "Mask of faults pulling FB/INT low: bit 0 OVP, bit 1 OCP, bit 2 SCP",
            "type": "number",
            "raw_type": "u8",
            "size": 1,
            "offset": 2,
            "min": 0,
            "max": 7,
            "default": 7
          },
          {
            "id": "discharge",
            "label": "Active discharge",
            "description": "Enable active discharge resistor on disable",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 3,
            "options": [
              {
                "label": "Off",
                "value": 0
              },
              {
                "label": "On",
                "value": 1
              }
            ],
            "default": 1
          }
        ]
      }
    },
    {
      "id": "get_protection",
      "op": 2,
      "symbol": "TPS55289_OP_GET_PROTECTION",
      "label": "Get protection",
      "description": "Reads current protection register settings",
      "returns": {
        "struct": "tps55289_protection_t",
        "label": "Protection settings",
        "description": "Current protection settings register state",
        "fields": [
          {
            "id": "ocp_delay",
            "label": "OCP delay",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "options": [
              {
                "label": "128 us",
                "value": 0
              },
              {
                "label": "3.072 ms",
                "value": 1
              },
              {
                "label": "6.144 ms",
                "value": 2
              },
              {
                "label": "12.288 ms",
                "value": 3
              }
            ]
          },
          {
            "id": "hiccup",
            "label": "Hiccup mode",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "options": [
              {
                "label": "Latch off",
                "value": 0
              },
              {
                "label": "Hiccup restart",
                "value": 1
              }
            ]
          },
          {
            "id": "fault_mask",
            "label": "Fault mask",
            "type": "number",
            "raw_type": "u8",
            "size": 1,
            "offset": 2
          },
          {
            "id": "discharge",
            "label": "Active discharge",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 3,
            "options": [
              {
                "label": "Off",
                "value": 0
              },
              {
                "label": "On",
                "value": 1
              }
            ]
          }
        ]
      }
    }
  ],
  "bus": {
    "type": "i2c",
    "i2c": {
      "default_addr": 116,
      "address_range": {
        "min": 116,
        "max": 117
      },
      "address_pins": [
        "MODE"
      ],
      "max_speed_khz": 1000
    }
  },
  "provides": {
    "power": [
      {
        "rail": "VOUT",
        "voltage_mV": 20000,
        "max_current_mA": 5500
      }
    ]
  },
  "power_pins": [
    {
      "name": "VIN",
      "kind": "vin",
      "voltage_mV": {
        "min": 2700,
        "max": 36000,
        "nominal": 12000
      }
    },
    {
      "name": "GND",
      "kind": "gnd"
    }
  ],
  "electrical": {
    "supply_voltage_mV": {
      "min": 2700,
      "max": 36000,
      "nominal": 12000
    },
    "max_current_mA": 5500
  }
}
