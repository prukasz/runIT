{
  "$schema": "../../../templates/part.schema.json",
  "kind": "part",
  "id": "pca9685_breakout",
  "name": "PWM expander breakout (PCA9685)",
  "category": "module",
  "description": "16 PWM channels on I2C, each with a servo header (PWM, V+, GND). Logic from VCC (3.3-5 V); the servos from V+ (the terminal or the V+ pin), which only runs to the headers.",
  "tags": [
    "pwm",
    "servo",
    "i2c",
    "devkit"
  ],
  "size_mm": {
    "w": 62.5,
    "h": 25.4
  },
  "device": {
    "type": "pca9685",
    "preset": "servo_50hz"
  },
