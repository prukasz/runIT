      "id": "vcc",
      "label": "VCC (logic)",
      "role": "sink",
      "voltage_mV": {
        "min": 2300,
        "max": 5500,
        "nominal": 3300
      },
      "current_mA": {
        "typical": 10,
        "peak": 15
      }
    },
    {
      "id": "vplus",
      "label": "V+ (servos)",
      "role": "through",
      "max_mA": 5000
    }
  ],
