        </mxCell>
        <mxCell id="k-e11" edge="1" parent="1" source="k-da" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.2838;exitY=1.0000;entryX=0.2838;entryY=0.0000;" target="k-ba" value="okno + piksele ↓">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e12" edge="1" parent="1" source="k-ba" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.7162;exitY=0.0000;entryX=0.7162;entryY=1.0000;" target="k-da" value="↑ transfer gotowy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e13" edge="1" parent="1" source="k-ba" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;startArrow=classic;startFill=1;" target="k-pa" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-na1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#5f8ea3;fontSize=11;" value="&lt;b&gt;LVGL&lt;/b&gt; renderuje do bufora częściowego i woła flush_cb. sys_screen i adapter VM edytują ekran tylko pod blokadą adaptera." vertex="1">
          <mxGeometry height="95" width="490" x="800" y="230" as="geometry" />
        </mxCell>
        <mxCell id="k-na2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#a38668;fontSize=11;" value="&lt;b&gt;Adapter&lt;/b&gt; zna tylko kontrakt DISPLAY, nie układ. Wzorce: ADAPTER + FASADA + MEDIATOR (po device id) + podwójne buforowanie + OBSERWATOR + automat stanów (start, stop). INSTALL czyta GEOMETRY, alokuje bufory (sterownik ich nie zna) i subskrybuje FLUSH_DONE na device id. FLUSH idzie asynchronicznie, a błąd transferu wraca przy następnym cyklu. Jeden FLUSH w locie. Moduł ma własną rodzinę błędów (err_h)." vertex="1">
          <mxGeometry height="225" width="490" x="800" y="365" as="geometry" />
        </mxCell>
        <mxCell id="k-na3" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;Kontrakt&lt;/b&gt; to ops device [contract u8][op u8], ten sam sens na każdym sterowniku. FLUSH niesie wskaźnik na bufor, więc jest tylko w C (nie idzie po drucie). Zdalnie czyta się GEOMETRY i ustawia BACKLIGHT." vertex="1">
          <mxGeometry height="130" width="490" x="800" y="645" as="geometry" />
        </mxCell>
        <mxCell id="k-na4" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;Sterownik&lt;/b&gt; jest urządzeniem wybieranym w create (kilka wkompilowanych naraz: Hardware Proxy). Nie zna bufora: dostaje wskaźnik w każdym FLUSH i zawsze publikuje FLUSH_DONE, także po nieudanym transferze." vertex="1">
          <mxGeometry height="140" width="490" x="800" y="830" as="geometry" />
        </mxCell>
        <mxCell id="k-na5" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="Magistrala to transport bajtów bez znajomości układu. Skupiamy się tylko na SPI i I2C (I2C głównie dla OLED-ów i dotyku)." vertex="1">
          <mxGeometry height="110" width="490" x="800" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="k-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4f8ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="DOTYK: od LVGL do panelu dotykowego (oddzielnie od wyświetlacza)" vertex="1">
          <mxGeometry height="910" width="1300" x="10" y="1165" as="geometry" />
        </mxCell>
        <mxCell id="k-ub" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fafafa;strokeColor=#c8c8c8;fontColor=#8c8c8c;fontStyle=1;" value="WYŻEJ: LVGL oraz sys_screen i adapter VM" vertex="1">
          <mxGeometry height="95" width="740" x="40" y="1210" as="geometry" />
