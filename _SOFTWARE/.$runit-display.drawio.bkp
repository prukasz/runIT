        <mxCell id="n-se2" edge="1" parent="1" source="n-sl1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c8c8c8;fontColor=#a0a0a0;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="n-sl2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n-se3" edge="1" parent="1" source="n-sl2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c8c8c8;fontColor=#a0a0a0;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="n-sl3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n-l1" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fffdf0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;roundedPerimeter=1;" value="Zakres: co adapter ma, co bierze z kontraktów i czego nie zna" vertex="1">
          <mxGeometry height="195" width="1300" x="10" y="185" as="geometry" />
        </mxCell>
        <mxCell id="n-s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;roundedPerimeter=1;" value="&lt;b&gt;Adapter ma i alokuje&lt;/b&gt;&lt;br&gt;• bufory rysowania: własne, alokowane raz, w INSTALL&lt;br&gt;• budżet puli obiektów (obiekty alokuje własny alokator LVGL)&lt;br&gt;• lv_display i lv_indev&lt;br&gt;• subskrypcja FLUSH_DONE&lt;br&gt;• wątek LVGL i blokada&lt;br&gt;• tick z zegara płytki" vertex="1">
          <mxGeometry height="140" width="410" x="30" y="225" as="geometry" />
        </mxCell>
        <mxCell id="n-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7d9;strokeColor=#c9dcab;fontColor=#8a9a6b;roundedPerimeter=1;" value="&lt;b&gt;Adapter bierze z kontraktów&lt;/b&gt;&lt;br&gt;• DISPLAY: GEOMETRY (w, h, format koloru, flaga DMA, align_y), FLUSH, BACKLIGHT, zdarzenie FLUSH_DONE&lt;br&gt;• TOUCH: POINT&lt;br&gt;• nigdy z układu: sterownik jest za kontraktem" vertex="1">
          <mxGeometry height="140" width="410" x="455" y="225" as="geometry" />
        </mxCell>
        <mxCell id="n-s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;fontColor=#000000;roundedPerimeter=1;" value="&lt;b&gt;Adapter nie zna&lt;/b&gt;&lt;br&gt;• układu panelu ani magistrali&lt;br&gt;• widgetów i słownika (sys_screen)&lt;br&gt;• programu VM (adapter VM)&lt;br&gt;• Moduł nie jest urządzeniem: ma własny klucz routera" vertex="1">
          <mxGeometry height="140" width="410" x="880" y="225" as="geometry" />
        </mxCell>
        <mxCell id="n-l2" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4f8ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;roundedPerimeter=1;" value="INSTALL: sekwencja i wycofanie" vertex="1">
          <mxGeometry height="210" width="1300" x="10" y="400" as="geometry" />
