        <mxCell id="k-ub1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e4f3f9;strokeColor=#a9d0e2;fontColor=#5f8ea3;" value="LVGL: lv_indev (pointer), gesty liczy sam" vertex="1">
