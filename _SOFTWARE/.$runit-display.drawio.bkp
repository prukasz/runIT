        <mxCell id="k-e10" edge="1" parent="1" source="k-da" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.7162;exitY=0.0000;entryX=0.7162;entryY=1.0000;" target="k-ca" value="↑ zdarzenie sterownika">
