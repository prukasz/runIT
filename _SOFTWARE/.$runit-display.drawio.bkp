          <mxGeometry height="80" width="190" x="878" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="m-b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fc;strokeColor=#b7cbe8;fontColor=#6a82a6;roundedPerimeter=1;" value="widget odświeżony przy następnym renderze" vertex="1">
