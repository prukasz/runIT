        <mxCell id="m-e7" edge="1" parent="1" source="m-vm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.7778;exitY=0.0000;entryX=0.3784;entryY=1.0000;" target="m-aa" value="↑ zmiana obiektu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-e8" edge="1" parent="1" source="m-aa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5946;exitY=1.0000;entryX=0.1667;entryY=0.0000;" target="m-sc" value="↓ SET, SHOW">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-e9" edge="1" parent="1" source="m-sc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.7778;exitY=0.0000;entryX=0.8919;entryY=1.0000;" target="m-aa" value="↑ zdarzenia widgetu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-na1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="Ekran &lt;b&gt;należy do programu VM&lt;/b&gt;: aplikacja wgrywa go razem z projektem (ramki ekranu i powiązania), a on wygasa razem z programem." vertex="1">
          <mxGeometry height="95" width="460" x="830" y="230" as="geometry" />
        </mxCell>
        <mxCell id="m-na2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;Powiązania&lt;/b&gt; zakładają komendy VM_OP_: BIND_OBJECT (obiekt → widget), BIND_EVENT (zdarzenie widgetu → akcja), CLEAR, STATUS. Każde jest sprawdzane, zanim trafi do tablicy." vertex="1">
          <mxGeometry height="120" width="460" x="830" y="365" as="geometry" />
        </mxCell>
        <mxCell id="m-na3" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;Adapter&lt;/b&gt; to obserwator + mediator: łączy świat VM (obiekty, zdarzenia) ze światem ekranu (ID widgetów), żaden nie zna drugiego. Tablice są statyczne i indeksowane po ID, więc w czasie pracy niczego się nie alokuje.&lt;br&gt;&lt;br&gt;&lt;b&gt;Do rozstrzygnięcia&lt;/b&gt;: skąd adapter wie o zmianie obiektu. Jedyny hook końca przebiegu (vm_exec_set_sample_hook) zajmuje dziś telemetria; potrzebny drugi albo lokalny subskrybent telemetrii." vertex="1">
          <mxGeometry height="260" width="460" x="830" y="535" as="geometry" />
        </mxCell>
        <mxCell id="m-na4" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;Po stronie VM&lt;/b&gt; adapter nie pisze w obiekty wprost z innego tasku: zapis idzie przez vm_override_post (walidowany, stosowany na początku następnego przebiegu). &lt;b&gt;Zdarzenia widgetów nie idą przez sys_event&lt;/b&gt; (rozmiary payloadu): mają własną kolejkę i task zdarzeń, osobne od niego. &lt;b&gt;Po stronie ekranu&lt;/b&gt; zmiany idą operacjami sys_screen, pod blokadą LVGL." vertex="1">
          <mxGeometry height="170" width="460" x="830" y="845" as="geometry" />
        </mxCell>
        <mxCell id="m-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4f8ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;roundedPerimeter=1;" value="Obiekt VM → widget: wyświetlanie i odświeżanie przy zmianie" vertex="1">
          <mxGeometry height="150" width="1300" x="10" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="m-b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7dc;strokeColor=#e9dba8;fontColor=#9a8b55;roundedPerimeter=1;" value="program zmienia obiekt VM" vertex="1">
          <mxGeometry height="80" width="190" x="30" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="m-b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6c1be;strokeColor=#b85450;fontColor=#000000;roundedPerimeter=1;" value="obserwator wykrywa zmianę" vertex="1">
          <mxGeometry height="80" width="190" x="242" y="1100" as="geometry" />
