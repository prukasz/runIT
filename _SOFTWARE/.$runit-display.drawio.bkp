          <mxGeometry height="85" width="225" x="300" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="k-db3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#82b366;fontColor=#000000;dashed=1;" value="linia IRQ (GPIO, opcjonalna): bez ruchu na magistrali, gdy nikt nie dotyka" vertex="1">
          <mxGeometry height="85" width="220" x="540" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="k-bb" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#e1d5e7;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="MAGISTRALA" vertex="1">
