          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-e16" edge="1" parent="1" source="m-c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="m-c3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-e17" edge="1" parent="1" source="m-c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c8c8c8;fontColor=#a0a0a0;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="m-c4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-e18" edge="1" parent="1" source="m-c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c8c8c8;fontColor=#a0a0a0;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="m-c5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-desc" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;strokeColor=#E07A5F;rounded=1;spacing=8;roundedPerimeter=1;" value="&lt;b style=&#39;font-size:16px&#39;&gt;sys_screen: co robi&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Fasada i fabryka nad LVGL.&lt;/b&gt; Z bytestreamu i statycznego słownika buduje ekran dynamicznie, bez kompilacji: wszystko jest danymi wgrywanymi w czasie działania. Reszta firmware widzi tylko operacje sys_screen, nie LVGL.&lt;br&gt;&lt;b&gt;2. Słownik statyczny, ekran dynamiczny.&lt;/b&gt; Widgety, właściwości i zdarzenia mają stałe numery, razem z zasobami (fonty, ikony, style). Strumień jest weryfikowany ze słownikiem, więc zły typ albo rozmiar kończy się błędem, a nie obiektem LVGL.&lt;br&gt;&lt;b&gt;3. Pula i ID.&lt;/b&gt; Obiekty powstają w puli alokatora LVGL (budżet z INSTALL), a statyczna tablica nadaje im ID z góry. Po tych ID zdarzenia wracają do VM.&lt;br&gt;&lt;b&gt;4. Zdarzenia.&lt;/b&gt; Callback podpięty przez EVENT tłumaczy zdarzenie na ustaloną formę (id widgetu, typ, payload) i wkłada je do własnej kolejki (osobnej od sys_event ze względu na rozmiary payloadu), obsługiwanej przez task zdarzeń; adapter VM zapisuje wynik do obiektu VM.&lt;br&gt;&lt;b&gt;5. Edycja pod blokadą.&lt;/b&gt; Zmiany ekranu idą pod blokadą adaptera, a RESET adaptera usuwa ekrany razem z obiektami, a sys_screen czyści tablicę ID." vertex="1">
          <mxGeometry height="130" width="1260" x="30" y="1445" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
