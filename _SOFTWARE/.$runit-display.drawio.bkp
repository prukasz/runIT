        </mxCell>
        <mxCell id="k-ab4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbeedb;strokeColor=#ecd0b6;fontColor=#a38668;" value="ROTATION: LVGL tylko zamienia rozdzielczość, obrót robi sprzęt panelu albo flush_cb; orientacja dotyku = panelu (create)" vertex="1">
