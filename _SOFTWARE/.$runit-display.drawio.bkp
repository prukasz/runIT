        </mxCell>
        <mxCell id="k-e14" edge="1" parent="1" source="k-ub1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c8c8c8;fontColor=#a0a0a0;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.3000;exitY=1.0000;entryX=0.1689;entryY=0.0000;" target="k-ab" value="LVGL woła read_cb ↓">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e15" edge="1" parent="1" source="k-ab" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c8c8c8;fontColor=#a0a0a0;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.3581;exitY=0.0000;entryX=0.7000;entryY=1.0000;" target="k-ub1" value="↑ lv_indev_data_t">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e16" edge="1" parent="1" source="k-ab" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.1757;exitY=1.0000;entryX=0.1757;entryY=0.0000;" target="k-cb" value="① INSTALL ↓ (device_touch)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e17" edge="1" parent="1" source="k-ab" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;" target="k-cb" value="② POINT(get) ↓">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e18" edge="1" parent="1" source="k-cb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.8108;exitY=0.0000;entryX=0.8108;entryY=1.0000;" target="k-ab" value="touch_point_t ↑">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e19" edge="1" parent="1" source="k-cb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.2838;exitY=1.0000;entryX=0.2838;entryY=0.0000;" target="k-db" value="sys_device_call ↓">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e20" edge="1" parent="1" source="k-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.7162;exitY=0.0000;entryX=0.7162;entryY=1.0000;" target="k-cb" value="↑ wynik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e21" edge="1" parent="1" source="k-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.2838;exitY=1.0000;entryX=0.2838;entryY=0.0000;" target="k-bb" value="odczyt ↓">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-e22" edge="1" parent="1" source="k-bb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.7162;exitY=0.0000;entryX=0.7162;entryY=1.0000;" target="k-db" value="↑ dane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-nb1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#5f8ea3;fontSize=11;" value="&lt;b&gt;LVGL&lt;/b&gt; ma jeden indev typu pointer: jeden punkt, gesty liczy z niego sam. Dlatego kontrakt nie ma wielu palców, nacisku ani gestów." vertex="1">
          <mxGeometry height="95" width="490" x="800" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="k-nb2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#a38668;fontSize=11;" value="&lt;b&gt;Adapter&lt;/b&gt; tworzy lv_indev przy INSTALL i rejestruje dotyk po kontrakcie device_touch (zapis INSTALL niesie id obu urządzeń, dotyk może być NONE). read_cb odpytuje POINT synchronicznie i tłumaczy odpowiedź na dane LVGL. Wyświetlacz i dotyk to dwa osobne urządzenia (dotyk bywa na innej magistrali i w innym układzie), a łączy je dopiero adapter." vertex="1">
          <mxGeometry height="190" width="490" x="800" y="1345" as="geometry" />
        </mxCell>
        <mxCell id="k-nb3" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;Kontrakt&lt;/b&gt; ma jeden odczyt POINT w pikselach panelu. CALIBRATION jest tylko dla rezystancyjnych, pojemnościowy zwraca ERR_DEV_BAD_ARG. Brak zdarzeń: adapter odpytuje." vertex="1">
          <mxGeometry height="125" width="490" x="800" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="k-nb4" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="&lt;b&gt;Sterownik dotyku&lt;/b&gt; skaluje natywny zakres układu do max_x i max_y z create, więc adapter nie potrzebuje geometrii dotyku. Orientacja jest ta sama co w panelu, żeby (0,0) dotyku było tam, gdzie (0,0) panelu." vertex="1">
          <mxGeometry height="140" width="490" x="800" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="k-nb5" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;" value="Magistrala dotyku bywa inna niż panelu: I2C przy pojemnościowych, SPI przy rezystancyjnych." vertex="1">
          <mxGeometry height="75" width="490" x="800" y="1965" as="geometry" />
        </mxCell>
        <mxCell id="k-desc" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;strokeColor=#E07A5F;rounded=1;spacing=8;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Sprzęt wyświetlacza i dotyku: co jest na tej stronie&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Kontrakty.&lt;/b&gt; sys_display (GEOMETRY, FLUSH, BACKLIGHT, zdarzenie FLUSH_DONE) i sys_touch (POINT, CALIBRATION) to ops device [contract u8][op u8], ten sam sens na każdym sterowniku. FLUSH niesie wskaźnik na bufor, więc jest tylko w C; zdalnie czyta się GEOMETRY i ustawia BACKLIGHT.&lt;br&gt;&lt;b&gt;2. Sterowniki.&lt;/b&gt; Panel i dotyk wybiera się przy create (kilka wkompilowanych naraz: Hardware Proxy). Sterownik wyświetlacza nie zna bufora: dostaje wskaźnik w każdym FLUSH i zawsze publikuje FLUSH_DONE, także po nieudanym transferze. Sterownik dotyku skaluje odczyt do max_x i max_y panelu.&lt;br&gt;&lt;b&gt;3. Magistrala.&lt;/b&gt; Transport bajtów bez znajomości układu: SPI (DMA, jeszcze brak sys_spi) albo I2C (sys_i2c). Dotyk bywa na innej magistrali niż panel.&lt;br&gt;&lt;b&gt;4. Wyświetlacz i dotyk to dwa osobne urządzenia.&lt;/b&gt; Łączy je dopiero adapter LVGL (sys_lvgl): bufory, INSTALL, flush_cb, read_cb i stany są na stronie 3. Tu adapter jest szary, bo widzi tylko kontrakty." vertex="1">
          <mxGeometry height="150" width="1260" x="30" y="2105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
