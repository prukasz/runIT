        <mxCell id="k-ab1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbeedb;strokeColor=#ecd0b6;fontColor=#a38668;" value="&lt;b&gt;INSTALL&lt;/b&gt;: rejestracja dotyku po kontrakcie device_touch (touch może być NONE) → lv_indev_create, POINTER" vertex="1">
