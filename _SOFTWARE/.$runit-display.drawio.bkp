        <mxCell id="m-na1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="Ekran jest &lt;b&gt;narysowany w aplikacji&lt;/b&gt; i wgrywany jako dane, tak jak program VM. Adapter VM wiąże obiekty VM z widgetami i zdarzenia widgetów z akcjami." vertex="1">
          <mxGeometry height="95" width="420" x="870" y="230" as="geometry" />
        </mxCell>
        <mxCell id="m-na2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;Operacje&lt;/b&gt; (SYS_SCREEN_OP_) przychodzą przez router jak każda komenda. Każdy bajt strumienia jest sprawdzany ze słownikiem, zanim LVGL cokolwiek dostanie. Moduł ma własną rodzinę błędów (err_h)." vertex="1">
          <mxGeometry height="120" width="420" x="870" y="365" as="geometry" />
        </mxCell>
        <mxCell id="m-na3" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;sys_screen&lt;/b&gt; to fabryka i fasada: słownik jest &lt;b&gt;statyczny&lt;/b&gt;, a ekran powstaje &lt;b&gt;dynamicznie&lt;/b&gt; z jego elementów (pseudo dynamiczna alokacja z puli). Obiekty powstają w puli, którą LVGL alokuje własnym alokatorem w budżecie z INSTALL, więc moduł nie alokuje niczego sam. Tablica statyczna daje obiektom ID, po których zdarzenia wracają do VM. Edycja i render są rozdzielone blokadą." vertex="1">
          <mxGeometry height="250" width="420" x="870" y="535" as="geometry" />
        </mxCell>
        <mxCell id="m-na4" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;Adapter LVGL&lt;/b&gt; daje tej warstwie blokadę, pulę obiektów (alokuje ją LVGL) i sygnał RESET. Warstwa nie zna panelu ani dotyku: oglądają je tylko kontrakty." vertex="1">
          <mxGeometry height="130" width="420" x="870" y="835" as="geometry" />
        </mxCell>
        <mxCell id="m-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4f8ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;roundedPerimeter=1;" value="Budowa ekranu z ramek: przepływ" vertex="1">
          <mxGeometry height="150" width="1300" x="10" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="m-b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9d3f7;strokeColor=#6c8ebf;fontColor=#000000;roundedPerimeter=1;" value="ramka CREATE: widget ze słownika i jego ID" vertex="1">
          <mxGeometry height="80" width="190" x="30" y="1155" as="geometry" />
        </mxCell>
        <mxCell id="m-b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9d3f7;strokeColor=#6c8ebf;fontColor=#000000;roundedPerimeter=1;" value="weryfikacja: typ w słowniku, struktura, wolne ID" vertex="1">
          <mxGeometry height="80" width="190" x="242" y="1155" as="geometry" />
        </mxCell>
        <mxCell id="m-b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9d3f7;strokeColor=#6c8ebf;fontColor=#000000;roundedPerimeter=1;" value="alokacja lv_obj_t z puli, pod blokadą adaptera" vertex="1">
          <mxGeometry height="80" width="190" x="454" y="1155" as="geometry" />
