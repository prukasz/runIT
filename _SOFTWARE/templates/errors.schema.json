{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runit.local/schema/errors.schema.json",
  "title": "runIT Error Catalog Definition",
  "description": "Katalog błędów systemu runIT, generowany z map ERR_*_MAP firmware (generate_errors.py) i z plików errors_<moduł>.json (szablony komunikatów, znaczenie pól). Pozwala aplikacji odkodować rekord błędu (router_err_record), złożyć komunikat dla użytkownika i przypisać błąd do urządzeń, pinów, kanałów, zmiennych, akcesorów i bloków.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "severities",
    "id_kinds",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Ścieżka do schematu walidacji JSON."
    },
    "schemaVersion": {
      "type": "integer",
      "default": 4,
      "description": "Wersja schematu deskryptora błędów."
    },
    "kind": {
      "type": "string",
      "const": "errors",
      "default": "errors",
      "description": "Typ dokumentu w systemie runIT: 'errors'."
    },
    "severities": {
      "type": "object",
      "description": "Słownik wag błędów (severities) zdefiniowanych w errors.h.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "id_kinds": {
      "type": "object",
      "description": "Rodzaje identyfikatorów (id_kind pól): co znaczy liczba w polu. Rodzaj ze `scope` jest numerowany w obrębie instancji innego rodzaju (pin urządzenia).",
      "propertyNames": {
        "$ref": "#/$defs/idKind"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "alias"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "description": "Nazwa rodzaju dla użytkownika."
          },
          "description": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/$defs/idKind",
            "description": "Rodzaj instancji, w której obrębie numerowany jest ten identyfikator."
          },
          "format": {
            "type": "string",
            "enum": [
              "hex"
            ],
            "description": "Jak pokazać liczbę, gdy nie ma nazwy instancji: hex = szesnastkowo."
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "description": "Lista modułów systemowych zgłaszających błędy.",
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "symbol",
        "tags"
      ],
      "description": "Definicja modułu błędów (ERR_MOD_* w err_modules.h).",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Numeryczny identyfikator modułu w firmware (starsze 16 bitów tagu błędu)."
        },
        "name": {
          "type": "string",
          "description": "Czytelna nazwa modułu (np. 'sys_device', 'sys_io', 'router')."
        },
        "symbol": {
          "type": "string",
          "pattern": "^ERR_MOD_[A-Z0-9_]+$",
          "description": "Symbol stałej C modułu w firmware (np. 'ERR_MOD_SYS_DEVICE')."
        },
        "source_file": {
          "type": "string",
          "description": "Względna ścieżka do pliku nagłówkowego C z definicją mapy błędów."
        },
        "tags": {
          "type": "array",
          "description": "Lista kodów błędów zarejestrowanych w tym module.",
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "texts_file": {
          "type": "string",
          "description": "Względna ścieżka do errors_<moduł>.json: szablony komunikatów i znaczenie pól."
        }
      },
      "additionalProperties": false
    },
    "tag": {
      "type": "object",
      "required": [
        "code",
        "tag",
        "name",
        "severity",
        "size",
        "fields",
        "message"
      ],
      "description": "Pojedynczy kod błędu w module.",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Lokalny kod błędu w module (młodsze 16 bitów tagu błędu)."
        },
        "tag": {
          "type": "integer",
          "minimum": 1,
          "description": "Pełny 32-bitowy tag błędu na magistrali: (module.id << 16) | code."
        },
        "name": {
          "type": "string",
          "pattern": "^ERR_[A-Z0-9_]+$",
          "description": "Nazwa symboliczna błędu w C (np. 'ERR_DEV_NOT_FOUND', 'ERR_IO_PIN_IN_USE')."
        },
        "severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Waga błędu: 0=NONE (kontekst trasy), 1=LOW, 2=MEDIUM, 3=HIGH, 4=CRITICAL."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Całkowity rozmiar w bajtach upakowanej struktury danych dołączonej do błędu."
        },
        "description": {
          "type": "string",
          "description": "Opis przyczyny błędu zaczerpnięty z komentarza w kodzie C."
        },
        "fields": {
          "type": "array",
          "description": "Pola danych diagnostycznych przesyłanych wraz z tym błędem.",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Szablon komunikatu dla użytkownika (errors_<moduł>.json). {pole} wstawia wartość pola: nazwę instancji dla pola z id_kind, alias członka dla pola z enum_ref, liczbę z jednostką dla reszty."
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "description": "Co użytkownik może zrobić (errors_<moduł>.json), z {pole} jak w message."
        },
        "context": {
          "type": "boolean",
          "const": true,
          "description": "Węzeł kontekstu (waga NONE): mówi, gdzie w łańcuchu jest błąd (krok trasy, urządzenie, akcja), nie co poszło źle."
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "type",
        "offset",
        "size"
      ],
      "description": "Pole binarne w strukturze błędu.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nazwa pola w strukturze C (np. 'id', 'pin', 'bus', 'len', 'code')."
        },
        "type": {
          "type": "string",
          "enum": [
            "u8",
            "i8",
            "u16",
            "i16",
            "u32",
            "i32",
            "f32",
            "chars"
          ],
          "description": "Niski binarny typ danych."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Offset bajtowy pola od początku bufora payloadu błędu."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Rozmiar pola w bajtach."
        },
        "enum_ref": {
          "type": "string",
          "description": "Opcjonalna nazwa powiązanego typu wyliczeniowego w firmware."
        },
        "id_kind": {
          "$ref": "#/$defs/idKind",
          "description": "Co znaczy liczba w polu: kluczowe dla UI, aby przypisać błąd do urządzenia, pinu, zmiennej, bloku."
        },
        "unit": {
          "type": "string",
          "description": "Opcjonalna jednostka fizyczna wartości (np. 'Hz', 'mV', 'mA', 'B')."
        },
        "of": {
          "type": "string",
          "description": "Dla rodzaju ze `scope`: pole tego błędu z instancją, w której obrębie liczy się ten identyfikator (pin `pin` urządzenia `id`)."
        },
        "id_kind_by": {
          "type": "object",
          "description": "Rodzaj identyfikatora zależny od wartości innego pola (z enum_ref): `kinds` wg wartości tego pola.",
          "required": [
            "field",
            "kinds"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "kinds": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[0-9]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/idKind"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "idKind": {
      "type": "string",
      "enum": [
        "device",
        "device_type",
        "device_op",
        "pin",
        "channel",
        "i2c_bus",
        "i2c_address",
        "vm_object",
        "vm_accessor",
        "vm_block",
        "vm_block_input",
        "vm_block_output",
        "vm_block_enable",
        "vm_block_type",
        "vm_op",
        "action",
        "project_section",
        "router_key",
        "link",
        "connector",
        "transport",
        "ble_uuid",
        "stream",
        "contract",
        "error_tag",
        "esp_err"
      ],
      "description": "Rodzaj identyfikatora (id_kinds)."
    }
  }
}
