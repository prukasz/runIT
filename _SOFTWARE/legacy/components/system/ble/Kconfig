menu "BLE Manager Options"
    config SYS_BLE_MANAGER_TASK_PRIO
        int "BLE Manager Task Priority"
        default 5
        range 1 24
        help
          Priority of the BLE manager task.

    config SYS_BLE_TASK_STACK_SIZE
        int "BLE Task Stack Size (bytes)"
        default 4096
        range 1024 32768
        help
          Stack size in bytes for the BLE manager task.

    config SYS_BLE_GAP_APPEARANCE
        hex "GAP Appearance Value"
        default 0x0200
        range 0x0000 0xFFFF
        help
          GAP appearance value advertised in the BLE advertising fields
          (0x0200 = Generic Tag).

    config SYS_BLE_MAX_LINKED_CONNECTORS
        int "Maximum Linked Connectors per Characteristic"
        default 2
        range 1 8
        help
          Maximum number of data connectors that can be linked to a
          single BLE characteristic.
endmenu
