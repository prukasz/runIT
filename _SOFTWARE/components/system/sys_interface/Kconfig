menu "System Interface Options"
    config SYS_INTERFACE_RX_TASK_STACK_SIZE
        int "RX Receiver Task Stack Size (bytes)"
        default 4096
        range 1024 32768
        help
          Stack size in bytes for shared RX receiver task.

    config SYS_INTERFACE_RX_TASK_PRIO
        int "RX Receiver Task Priority"
        default 5
        range 1 24
        help
          Priority of shared RX receiver task.

    config SYS_INTERFACE_RX_WAIT_MS
        int "RX Receiver Task Wait/Poll Period (ms)"
        default 100
        range 10 1000
        help
          Wait/poll period in ms for RX receiver task.

    config SYS_INTERFACE_MAX_CLASSES
        int "Maximum Registered Class Handlers"
        default 12
        range 2 32
        help
          Maximum number of registered class handlers.

    config SYS_INTERFACE_RESPONSE_MAX
        int "Maximum Response Data (bytes)"
        default 128
        range 16 1024
        help
          Capacity for the data a decoder attaches to one command's response
          (sys_interface_respond()), not counting the 4-byte response header (seq, class, packet, status).
          The largest response today is the USB-PD option list (106 bytes).
          A response longer than the origin transport's current frame limit
          (BLE: MTU - 3) is answered with an error status instead.
endmenu
