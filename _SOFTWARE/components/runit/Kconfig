menu "runIT Board & Diagnostic Configuration"

    config RUNIT_UART_CONSOLE_LINK
        bool "Command link on the console UART"
        default y
        help
            Registers the console UART as a data connector provider and binds
            the interface (commands in, responses out), telemetry and error
            packet connectors to it, next to BLE. Frames are "#R:<hex>" lines
            mixed with the text log (sys_uart_provider.h). Used by the host
            test scripts; disable to keep the console log-only.

endmenu
