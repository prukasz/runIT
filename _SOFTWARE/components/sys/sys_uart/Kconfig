menu "sys_uart"

    config SYS_UART_TASK_PRIO
        int "RX task priority"
        default 5
        range 1 24
        help
          Priority of the task that reads the console UART (and USB-Serial-JTAG)
          and turns "#R:" hex lines into router frames.

    config SYS_UART_TASK_STACK
        int "RX task stack (bytes)"
        default 3072
        range 2048 16384
        help
          The line and frame buffers are static, not on this stack.

    config SYS_UART_DRIVER_RX_BUF
        int "Driver RX buffer (bytes)"
        default 1024
        range 256 8192
        help
          RX buffer of the UART (and USB-Serial-JTAG) driver installed on the
          console. Must be larger than the UART hardware FIFO (128 bytes).

endmenu
