{
  "$schema": "../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "contract-definition",
  "id": "POWER_VREG",
  "contract_id": 5,
  "alias": "Regulator",
  "description": "An adjustable regulator: enable, voltage, current limit",
  "category": "power",
  "commands": [
    {
      "id": "SET_ENABLE",
      "op": 0,
      "label": "Output",
      "description": "Switches the regulator output on or off.",
      "symbol": "VREG_OP_SET_ENABLE",
      "args": {
        "fields": [
          {
            "id": "enable",
            "label": "Output",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "options": [
              {
                "label": "Off",
                "value": 0
              },
              {
                "label": "On",
                "value": 1
              }
            ]
          }
        ],
        "struct": "vreg_enable_args_t"
      }
    },
    {
      "id": "SET_VOLTAGE",
      "op": 1,
      "label": "Voltage",
      "description": "Sets the wanted output voltage; the output follows when it is enabled.",
      "symbol": "VREG_OP_SET_VOLTAGE",
      "args": {
        "fields": [
          {
            "id": "voltage_mV",
            "label": "Voltage",
            "type": "number",
            "raw_type": "u32",
            "size": 4,
            "offset": 0,
            "description": "The wanted output voltage",
            "unit": "mV"
          }
        ],
        "struct": "vreg_voltage_args_t"
      }
    },
    {
      "id": "SET_CURRENT",
      "op": 2,
      "label": "Current limit",
      "description": "Sets the wanted output current limit.",
      "symbol": "VREG_OP_SET_CURRENT",
      "args": {
        "fields": [
          {
            "id": "current_mA",
            "label": "Current limit",
            "type": "number",
            "raw_type": "u32",
            "size": 4,
            "offset": 0,
            "description": "The wanted output current limit",
            "unit": "mA"
          }
        ],
        "struct": "vreg_current_args_t"
      }
    }
  ],
  "events": [
    {
      "id": "OVP",
      "event": 0,
      "code": 1280,
      "label": "Over-voltage",
      "description": "The output went above its limit",
      "notify": true,
      "symbol": "VREG_EV_OVP",
      "value": {
        "description": "The wanted voltage",
        "unit": "mV"
      }
    },
    {
      "id": "OCP",
      "event": 1,
      "code": 1281,
      "label": "Over-current",
      "description": "The output passed its current limit",
      "notify": true,
      "symbol": "VREG_EV_OCP",
      "value": {
        "description": "The current limit",
        "unit": "mA"
      }
    },
    {
      "id": "SCP",
      "event": 2,
      "code": 1282,
      "label": "Short circuit",
      "description": "The output is shorted",
      "notify": true,
      "symbol": "VREG_EV_SCP"
    },
    {
      "id": "READY",
      "event": 3,
      "code": 1283,
      "label": "Output ready",
      "description": "The output settled at the wanted voltage",
      "notify": false,
      "symbol": "VREG_EV_READY",
      "value": {
        "description": "The voltage",
        "unit": "mV"
      }
    }
  ]
}
