menu "sys_event"

    config SYS_EVENT_MAX_SUBS
        int "Subscriptions (C)"
        default 32
        range 4 255
        help
          Listeners made by C code (devices, VM, power manager), inline or
          queued.

    config SYS_EVENT_MAX_RULES
        int "Rules"
        default 16
        range 1 254
        help
          Remote "event -> action" listeners, a table of their own so rules
          never take a device's slot.

    config SYS_EVENT_QUEUE_LEN
        int "Queue (events)"
        default 16
        range 4 128
        help
          Events waiting for the event task (queued listeners, rules, events
          from ISRs). A full queue drops the event.

    config SYS_EVENT_MAX_HOPS
        int "Republish depth"
        default 4
        range 1 16
        help
          An event published because of another (SYS_EVENT_CAUSED_BY) at this
          depth is dropped with ERR_EVENT_LOOP.

    config SYS_EVENT_TASK_PRIO
        int "Task priority"
        default 6
        range 1 24
        help
          Above the router work task (5), below the urgent task (15).

    config SYS_EVENT_TASK_STACK
        int "Task stack (bytes)"
        default 4096
        range 3072 32768
        help
          Runs queued listeners: device ON_EVENT ops (I2C), rules.

endmenu
