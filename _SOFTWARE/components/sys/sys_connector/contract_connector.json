{
  "$schema": "../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "CONNECTOR",
  "router_key": 4,
  "alias": "Konektor strumieni danych (Data Connectors)",
  "description": "Zarządzanie logicznymi strumieniami danych wychodzących (telemetria, logi, błędy, zdarzenia, strumienie użytkownika) oraz ich powiązaniami z transportami (UART, BLE).",
  "category": "system",
  "commands": [
    {
      "id": "CREATE",
      "op": 1,
      "symbol": "OP_CREATE",
      "label": "Utwórz strumień",
      "description": "Tworzy logiczny strumień użytkownika o zadanym ID i bajcie strumienia.",
      "args": {
        "struct": "create_t",
        "fields": [
          {
            "id": "id",
            "label": "Connector ID",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "Identyfikator konektora (>= 4 dla strumieni aplikacji)"
          },
          {
            "id": "stream",
            "label": "Stream byte",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "description": "Bajt identyfikujący strumień w ramce"
          },
          {
            "id": "name",
            "label": "Nazwa strumienia",
            "type": "string",
            "raw_type": "string",
            "description": "Tekstowa nazwa diagnostyczna (ogon NUL-terminated tail)"
          }
        ]
      }
    },
    {
      "id": "REMOVE",
      "op": 2,
      "symbol": "OP_REMOVE",
      "label": "Usuń strumień",
      "description": "Usuwa strumień użytkownika i jego powiązania z transportami.",
      "args": {
        "struct": "id_t_",
        "fields": [
          {
            "id": "id",
            "label": "Connector ID",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "Identyfikator usuwanego konektora"
          }
        ]
      }
    },
    {
      "id": "BIND",
      "op": 3,
      "symbol": "OP_BIND",
      "label": "Powiąż z transportem",
      "description": "Przypisuje strumień do transportu (UART, BLE) pod wskazanym punktem końcowym (endpoint).",
      "args": {
        "struct": "bind_t",
        "fields": [
          {
            "id": "id",
            "label": "Connector ID",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "Identyfikator konektora"
          },
          {
            "id": "provider",
            "label": "Transport",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "description": "Identyfikator transportu",
            "options": [
              {
                "label": "UART",
                "value": 1
              },
              {
                "label": "BLE",
                "value": 2
              }
            ]
          },
          {
            "id": "endpoint",
            "label": "Endpoint",
            "type": "integer",
            "raw_type": "u32",
            "size": 4,
            "offset": 2,
            "description": "Punkt końcowy transportu (dla BLE 16-bit UUID cechy, dla UART 0)"
          }
        ]
      }
    },
    {
      "id": "UNBIND",
      "op": 4,
      "symbol": "OP_UNBIND",
      "label": "Usuń powiązanie",
      "description": "Usuwa powiązanie strumienia z wybranym transportem.",
      "args": {
        "struct": "unbind_t",
        "fields": [
          {
            "id": "id",
            "label": "Connector ID",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "Identyfikator konektora"
          },
          {
            "id": "provider",
            "label": "Transport",
            "type": "choice",
            "raw_type": "u8",
            "size": 1,
            "offset": 1,
            "description": "Identyfikator transportu",
            "options": [
              {
                "label": "UART",
                "value": 1
              },
              {
                "label": "BLE",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUSPEND",
      "op": 5,
      "symbol": "OP_SUSPEND",
      "label": "Zawieś strumień",
      "description": "Zawiesza wysyłanie ramek na strumieniu (pakiety są ignorowane bez blokowania nadawcy).",
      "args": {
        "struct": "id_t_",
        "fields": [
          {
            "id": "id",
            "label": "Connector ID",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "Identyfikator zawieszanego konektora"
          }
        ]
      }
    },
    {
      "id": "RESUME",
      "op": 6,
      "symbol": "OP_RESUME",
      "label": "Wznów strumień",
      "description": "Wznawia normalne nadawanie zawieszonego strumienia.",
      "args": {
        "struct": "id_t_",
        "fields": [
          {
            "id": "id",
            "label": "Connector ID",
            "type": "integer",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "Identyfikator wznawianego konektora"
          }
        ]
      }
    },
    {
      "id": "INFO",
      "op": 7,
      "symbol": "OP_INFO",
      "label": "Pobierz listę strumieni",
      "description": "Zwraca listę wszystkich aktywnych konektorów, ich stan (systemowy, zawieszony) oraz powiązania transportowe.",
      "returns": {
        "type": "u8",
        "label": "Liczba konektorów",
        "description": "Potem, dla każdego konektora: id, stream, flagi (bit0 systemowy, bit1 zawieszony), liczba powiązań i powiązania (provider, endpoint), nazwa zakończona NUL."
      }
    }
  ]
}

