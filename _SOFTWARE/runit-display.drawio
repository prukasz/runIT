        </mxCell>
        <mxCell id="m-e7" edge="1" parent="1" source="m-vm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.2778;exitY=0.0000;entryX=0.4848;entryY=1.0000;" target="m-aa3" value="↑ zmiana obiektu">
