          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="k-e12" edge="1" parent="1" source="k-ba1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.8286;exitY=0.0000;entryX=0.2222;entryY=1.0000;" target="k-da3" value="↑ transfer gotowy">
