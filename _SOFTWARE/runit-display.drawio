          <mxGeometry height="85" width="280" x="980" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="n-e12" edge="1" parent="1" source="n-st0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.2941;entryX=0.0000;entryY=0.2941;" target="n-st1" value="INSTALL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n-e13" edge="1" parent="1" source="n-st1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.0000;exitY=0.7647;entryX=1.0000;entryY=0.7647;" target="n-st0" value="RESET">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n-e14" edge="1" parent="1" source="n-st1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.2941;entryX=0.0000;entryY=0.2941;" target="n-st2" value="STOP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n-e15" edge="1" parent="1" source="n-st2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.0000;exitY=0.7647;entryX=1.0000;entryY=0.7647;" target="n-st1" value="START">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n-e-rst" edge="1" parent="1" source="n-st2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=1.0000;" target="n-st0" value="RESET">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1120" y="1565" />
              <mxPoint x="180" y="1565" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n-st-n" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;STOP&lt;/b&gt;: czeka na ostatni FLUSH_DONE, read_cb zwraca puszczony. &lt;b&gt;START&lt;/b&gt;: wznawia i unieważnia cały ekran (panel mógł stracić zawartość). &lt;b&gt;RESET&lt;/b&gt;: czeka na ostatni FLUSH_DONE, odsubskrybowuje, usuwa indev i display razem z obiektami, zwalnia bufory i wraca ze stertą do startowej; lv_deinit nie jest wołane. Stan bezpieczny płytki: STOP, potem START." vertex="1">
          <mxGeometry height="80" width="1260" x="30" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="n-l7" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4f8ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;roundedPerimeter=1;" value="Interfejsy adaptera" vertex="1">
          <mxGeometry height="235" width="1300" x="10" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="n-tab" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;font-size:11px;width:640px&#39;&gt;&lt;tr&gt;&lt;th&gt;op&lt;/th&gt;&lt;th&gt;strona&lt;/th&gt;&lt;th&gt;argumenty&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;INSTALL&lt;/td&gt;&lt;td&gt;RW&lt;/td&gt;&lt;td&gt;{u16 display, u16 touch, u32 heap_bytes}; odczyt: co zainstalowane&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RESET&lt;/td&gt;&lt;td&gt;W&lt;/td&gt;&lt;td&gt;bez argumentów&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ROTATION&lt;/td&gt;&lt;td&gt;RW&lt;/td&gt;&lt;td&gt;{u8 0..3}; DISPLAY ORIENTATION obraca panel, potem lv_display_set_rotation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;STATUS&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;td&gt;installed, running, w, h, buffer_bytes, heap_total, heap_free, flushes, flush_errors&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;START&lt;/td&gt;&lt;td&gt;W&lt;/td&gt;&lt;td&gt;bez argumentów&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;STOP&lt;/td&gt;&lt;td&gt;W&lt;/td&gt;&lt;td&gt;bez argumentów&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="180" width="660" x="30" y="1735" as="geometry" />
        </mxCell>
        <mxCell id="n-api" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="&lt;b&gt;Router sys_lvgl&lt;/b&gt;: komendy [klucz][dir][op][args]. Ramki są zapisywalne jako rekordy, więc projekt odtwarza INSTALL przy starcie.&lt;br&gt;&lt;br&gt;&lt;b&gt;Interfejs C&lt;/b&gt; (bez drutu): sys_lvgl_init (krok bootu), sys_lvgl_lock i unlock, sys_lvgl_install, _reset, _start, _stop, _set_rotation, _get_status. sys_screen i adapter VM używają lock i unlock; stan bezpieczny płytki woła STOP i START.&lt;br&gt;&lt;br&gt;Błędy własnej rodziny ERR_LVGL_*: brak pamięci, już zainstalowany, zły kontrakt, za mała sterta." vertex="1">
          <mxGeometry height="185" width="570" x="720" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="n-desc" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;strokeColor=#E07A5F;rounded=1;spacing=8;roundedPerimeter=1;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Adapter LVGL: co jest jego&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Własne bufory.&lt;/b&gt; Bufor rysowania należy do adaptera, nie do sterownika: wylicza go z GEOMETRY przy INSTALL (partial, 1/10 ekranu, dwa), alokuje raz, przy INSTALL, w wewnętrznym RAM zdolnym do DMA i trzyma, dopóki trwa FLUSH (w czasie pracy nie alokuje).&lt;br&gt;&lt;b&gt;2. Obiekty alokuje LVGL.&lt;/b&gt; Widgety, style i cache alokuje własny alokator LVGL w osobnej puli (w firmware przez hooki malloc z budżetem); adapter ustawia tylko budżet: INSTALL na heap_bytes, RESET przywraca.&lt;br&gt;&lt;b&gt;3. Jeden wątek, jedna blokada.&lt;/b&gt; LVGL renderuje z jednego tasku, a wszyscy inni dotykają obiektów tylko pod sys_lvgl_lock; słuchacz FLUSH_DONE nie bierze blokad.&lt;br&gt;&lt;b&gt;4. Stany.&lt;/b&gt; PUSTY, DZIAŁA, ZATRZYMANY: INSTALL buduje, RESET rozbiera do stanu pustego, STOP i START wstrzymują i wznawiają bez niszczenia obiektów." vertex="1">
          <mxGeometry height="125" width="1260" x="30" y="1945" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
