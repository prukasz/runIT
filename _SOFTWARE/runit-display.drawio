        <mxCell id="k-ab4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeedb;strokeColor=#ecd0b6;fontColor=#a38668;roundedPerimeter=1;" value="ROTATION: obrót robi panel (DISPLAY ORIENTATION), LVGL tylko zamienia rozdzielczość; orientacja dotyku = panelu" vertex="1">
