        <mxCell id="m-e8" edge="1" parent="1" source="m-aa4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5030;exitY=1.0000;entryX=0.4194;entryY=0.0000;" target="m-sc1" value="↓ SET, SHOW">
