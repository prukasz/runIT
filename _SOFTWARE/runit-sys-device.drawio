<mxfile host="Electron" pages="2">
  <diagram id="sysdev-call-tls" name="1 Przepływ wywołania i TLS">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-outer" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fontSize=22;fontStyle=1;fillColor=none;" value="sys_device: wywołanie, tożsamość (sys_device_self / caller) i TLS" vertex="1">
          <mxGeometry height="1740" width="1360" x="10" y="10" as="geometry" />
        </mxCell>

        <!-- LANE A: Call pipeline -->
        <mxCell id="p1-lane-a" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fff8f0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="A. Ścieżka wywołania (sys_device_call.c) — wszystko w bieżącym tasku, bez kolejki" vertex="1">
          <mxGeometry height="620" width="1340" x="20" y="60" as="geometry" />
        </mxCell>

        <!-- Entry points -->
        <mxCell id="a-app" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;APP / Router&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_router&lt;/code&gt;&lt;br&gt;&lt;code&gt;sys_device_call_routed&lt;/code&gt;&lt;br&gt;(&lt;i&gt;routed = true&lt;/i&gt;, bez LOCAL)" vertex="1">
          <mxGeometry height="85" width="190" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="a-c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Kod C / Sterownik / Moduł&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_write / read / call&lt;/code&gt;&lt;br&gt;(&lt;i&gt;routed = false&lt;/i&gt;, LOCAL OK)" vertex="1">
          <mxGeometry height="85" width="190" x="40" y="215" as="geometry" />
        </mxCell>
        <mxCell id="a-step" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Timer urządzenia&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_step(id, gen, op)&lt;/code&gt;&lt;br&gt;(&lt;i&gt;how.gen != 0&lt;/i&gt;, try_lock)" vertex="1">
          <mxGeometry height="85" width="190" x="40" y="320" as="geometry" />
        </mxCell>
        <mxCell id="a-sweep" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;Sweep (SUSPEND/RESUME/...)&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_sweep(op)&lt;/code&gt;&lt;br&gt;otwiera własny &lt;code&gt;hold&lt;/code&gt;, &lt;code&gt;s_depth++&lt;/code&gt;,&lt;br&gt;&lt;code&gt;s_sweeping++&lt;/code&gt;, ew. &lt;code&gt;safe_gate&lt;/code&gt;" vertex="1">
          <mxGeometry height="95" width="190" x="40" y="430" as="geometry" />
        </mxCell>

        <!-- Pipeline boxes -->
        <mxCell id="a-wrapped" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;call_wrapped()&lt;/b&gt;&lt;br&gt;błąd owija w:&lt;br&gt;&lt;code&gt;ERR_DEV_OP&lt;/code&gt;&lt;br&gt;&lt;code&gt;ERR_DEV_ID&lt;/code&gt;" vertex="1">
          <mxGeometry height="110" width="140" x="290" y="205" as="geometry" />
        </mxCell>
        <mxCell id="a-outer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;call_outermost()&lt;/b&gt;&lt;br&gt;gdy &lt;code&gt;s_depth == 0&lt;/code&gt; (&lt;i&gt;noinline&lt;/i&gt;)&lt;br&gt;• stos: &lt;code&gt;room[256 B]&lt;/code&gt;&lt;br&gt;• &lt;code&gt;sys_event_hold()&lt;/code&gt;&lt;br&gt;• po powrocie: &lt;code&gt;release()&lt;/code&gt;" vertex="1">
          <mxGeometry height="110" width="175" x="470" y="130" as="geometry" />
        </mxCell>
        <mxCell id="a-nested" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;call_nested()&lt;/b&gt;&lt;br&gt;1. zapisz &lt;code&gt;was_running&lt;/code&gt;, &lt;code&gt;was_caller&lt;/code&gt;&lt;br&gt;2. &lt;b&gt;&lt;code&gt;s_caller = was_running&lt;/code&gt;&lt;/b&gt;&lt;br&gt;3. &lt;b&gt;&lt;code&gt;s_running = id + 1&lt;/code&gt;&lt;/b&gt;, &lt;code&gt;s_depth++&lt;/code&gt;&lt;br&gt;4. wywołaj &lt;code&gt;call()&lt;/code&gt;&lt;br&gt;5. zawsze odtwórz &lt;code&gt;s_running&lt;/code&gt;, &lt;code&gt;s_caller&lt;/code&gt;, &lt;code&gt;s_depth--&lt;/code&gt;" vertex="1">
          <mxGeometry height="125" width="230" x="455" y="295" as="geometry" />
        </mxCell>
        <mxCell id="a-call" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;call() — interceptor&lt;/b&gt;&lt;br&gt;(bez locka rejestru)&lt;br&gt;• &lt;code&gt;interceptor-&amp;gt;fn()&lt;/code&gt; przed&lt;br&gt;• &lt;code&gt;interceptor-&amp;gt;done()&lt;/code&gt; po" vertex="1">
          <mxGeometry height="110" width="165" x="730" y="302" as="geometry" />
        </mxCell>
        <mxCell id="a-dev" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;call_device()&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;slot_lock&lt;/code&gt; (lub &lt;code&gt;try_lock&lt;/code&gt;)&lt;br&gt;2. &lt;code&gt;run_locked()&lt;/code&gt;&lt;br&gt;3. &lt;code&gt;slot_unlock&lt;/code&gt;&lt;br&gt;4. &lt;code&gt;publish_change&lt;/code&gt; (w &lt;code&gt;hold&lt;/code&gt;)&lt;br&gt;5. jeśli &lt;code&gt;NOLOCK&lt;/code&gt; / &lt;code&gt;remote&lt;/code&gt;: wykonaj tu" vertex="1">
          <mxGeometry height="145" width="205" x="935" y="285" as="geometry" />
        </mxCell>
        <mxCell id="a-locked" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;run_locked() + sterownik&lt;/b&gt;&lt;br&gt;• &lt;code&gt;CREATE&lt;/code&gt; / op rejestru / op typu&lt;br&gt;• bramka &lt;code&gt;suspended || gated()&lt;/code&gt;&lt;br&gt;• odmowa &lt;code&gt;LOCAL&lt;/code&gt; dla &lt;code&gt;routed&lt;/code&gt;&lt;br&gt;• handler sterownika widzi:&lt;br&gt;  &lt;code&gt;sys_device_self() == id&lt;/code&gt;&lt;br&gt;  &lt;code&gt;sys_device_caller() == prev&lt;/code&gt;" vertex="1">
          <mxGeometry height="145" width="195" x="1155" y="285" as="geometry" />
        </mxCell>

        <!-- Nesting loopback and event release notes -->
        <mxCell id="a-note-nest" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Wywołanie zagnieżdżone (sterownik U → D):&lt;/b&gt; handler w &lt;code&gt;U&lt;/code&gt; woła &lt;code&gt;sys_device_write(D, ...)&lt;/code&gt; → wchodzi w &lt;code&gt;call_wrapped&lt;/code&gt; (&lt;code&gt;s_depth &amp;gt; 0&lt;/code&gt;) → omija &lt;code&gt;call_outermost&lt;/code&gt; → wchodzi prosto w &lt;code&gt;call_nested&lt;/code&gt; (dla &lt;code&gt;D&lt;/code&gt;: &lt;code&gt;caller = U&lt;/code&gt;, &lt;code&gt;self = D&lt;/code&gt;)" vertex="1">
          <mxGeometry height="55" width="840" x="490" y="505" as="geometry" />
        </mxCell>
        <mxCell id="a-note-evt" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Eventy po powrocie z &lt;code&gt;call_outermost()&lt;/code&gt;:&lt;/b&gt; wszystkie locki slotów są już zdjęte, a &lt;code&gt;s_running = 0&lt;/code&gt;, &lt;code&gt;s_caller = 0&lt;/code&gt;. Listenery inline mogą bezpiecznie wołać dowolne urządzenie (bez deadlocka i bez &lt;code&gt;REENTRY&lt;/code&gt;); nadmiar lub &lt;code&gt;DEFER&lt;/code&gt; idzie do taska eventów." vertex="1">
          <mxGeometry height="55" width="1290" x="40" y="595" as="geometry" />
        </mxCell>

        <!-- Edges in Lane A -->
        <mxCell id="ae1" edge="1" parent="1" source="a-app" target="a-wrapped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" edge="1" parent="1" source="a-c" target="a-wrapped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae3" edge="1" parent="1" source="a-step" target="a-wrapped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4" edge="1" parent="1" source="a-sweep" target="a-wrapped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" value="dla każdego id">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="478" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ae5" edge="1" parent="1" source="a-wrapped" target="a-outer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" value="s_depth == 0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae6" edge="1" parent="1" source="a-wrapped" target="a-nested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" value="s_depth &gt; 0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae7" edge="1" parent="1" source="a-outer" target="a-nested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae8" edge="1" parent="1" source="a-nested" target="a-call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae9" edge="1" parent="1" source="a-call" target="a-dev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae10" edge="1" parent="1" source="a-dev" target="a-locked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae11" edge="1" parent="1" source="a-locked" target="a-note-nest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1253" y="470" />
              <mxPoint x="1340" y="470" />
              <mxPoint x="1340" y="532" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ae12" edge="1" parent="1" source="a-note-nest" target="a-wrapped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;dashed=1;exitX=0;exitY=0.5;entryX=0.75;entryY=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="395" y="532" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- LANE B: TLS trace U -> D -->
        <mxCell id="p1-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fffdf0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="B. Zmiana tożsamości w TLS (__thread) — przykład zagnieżdżenia: APP → PCA9685 (id=5) → GPIO (id=0)" vertex="1">
          <mxGeometry height="400" width="1340" x="20" y="700" as="geometry" />
        </mxCell>

        <mxCell id="b-s0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;1. Task przed wywołaniem&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;code&gt;s_running = 0&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_caller = 0&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_depth = 0&lt;/code&gt;&lt;hr&gt;self() = &lt;b&gt;NONE&lt;/b&gt;&lt;br&gt;caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="185" x="40" y="760" as="geometry" />
        </mxCell>
        <mxCell id="b-s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;2. Wejście w PCA9685 (id=5)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;code&gt;s_running = 6&lt;/code&gt; (5+1)&lt;br&gt;&lt;code&gt;s_caller = 0&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_depth = 1&lt;/code&gt;&lt;hr&gt;self() = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="200" x="260" y="760" as="geometry" />
        </mxCell>
        <mxCell id="b-s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;3. PCA (5) woła GPIO (id=0)&lt;/b&gt;&lt;br&gt;(np. &lt;code&gt;IO_OP_LEVEL&lt;/code&gt; na OE)&lt;hr&gt;&lt;code&gt;s_running = 1&lt;/code&gt; (0+1)&lt;br&gt;&lt;code&gt;s_caller = 6&lt;/code&gt; (5+1)&lt;br&gt;&lt;code&gt;s_depth = 2&lt;/code&gt;&lt;hr&gt;self() = &lt;b&gt;0&lt;/b&gt; · caller() = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;&lt;i&gt;owner[oe]==5 → OK!&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="225" x="495" y="760" as="geometry" />
        </mxCell>
        <mxCell id="b-s3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;4. Powrót z GPIO do PCA&lt;/b&gt;&lt;br&gt;&lt;code&gt;call_nested&lt;/code&gt; odtwarza ze stosu:&lt;hr&gt;&lt;code&gt;s_running = 6&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_caller = 0&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_depth = 1&lt;/code&gt;&lt;hr&gt;self() = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="205" x="755" y="760" as="geometry" />
        </mxCell>
        <mxCell id="b-s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;5. Wyjście + release eventów&lt;/b&gt;&lt;br&gt;locki zdjęte, odtworzone:&lt;hr&gt;&lt;code&gt;s_running = 0&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_caller = 0&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_depth = 0&lt;/code&gt;&lt;hr&gt;listener widzi:&lt;br&gt;self() = &lt;b&gt;NONE&lt;/b&gt;, caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="215" x="995" y="760" as="geometry" />
        </mxCell>

        <mxCell id="b-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Dlaczego kodowanie &lt;code&gt;id + 1&lt;/code&gt;?&lt;/b&gt; &amp;nbsp;Wartości &lt;code&gt;0&lt;/code&gt; w TLS trafiają do sekcji &lt;code&gt;.tbss&lt;/code&gt; — każdy nowy task FreeRTOS dostaje &lt;code&gt;0&lt;/code&gt; automatycznie, bez &lt;code&gt;.tdata&lt;/code&gt;. Dlatego również &lt;b&gt;prywatny wątek sterownika&lt;/b&gt; (poza opem) ma zawsze &lt;code&gt;s_running = 0&lt;/code&gt; (nie ma tożsamości urządzenia)." vertex="1">
          <mxGeometry height="60" width="1290" x="40" y="950" as="geometry" />
        </mxCell>
        <mxCell id="b-note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;sys_device_self_suspended():&lt;/b&gt; zwraca &lt;code&gt;s_running != 0 &amp;amp;&amp;amp; sys_device_slot_is_suspended(s_running - 1)&lt;/code&gt;. Służy opom &lt;code&gt;READ&lt;/code&gt; oraz &lt;code&gt;ALWAYS&lt;/code&gt; (np. &lt;code&gt;ON_EVENT&lt;/code&gt;), aby zwrócić kopię stanu z RAM lub pominąć zapis do uśpionego sprzętu — bez własnej flagi &lt;code&gt;suspended&lt;/code&gt; w strukturze sterownika." vertex="1">
          <mxGeometry height="55" width="1290" x="40" y="1025" as="geometry" />
        </mxCell>

        <mxCell id="be1" edge="1" parent="1" source="b-s0" target="b-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be2" edge="1" parent="1" source="b-s1" target="b-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be3" edge="1" parent="1" source="b-s2" target="b-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be4" edge="1" parent="1" source="b-s3" target="b-s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE C: Context table -->
        <mxCell id="p1-lane-c" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4fbe6;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="C. Co widzi kod w poszczególnych miejscach wykonania" vertex="1">
          <mxGeometry height="600" width="1340" x="20" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="c-table" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="&lt;table border='1' cellpadding='5' style='border-collapse:collapse;font-size:12px;width:1290px'&gt;&lt;tr style='background:#e9f5d8'&gt;&lt;th style='width:280px'&gt;Kontekst wykonania&lt;/th&gt;&lt;th style='width:140px'&gt;sys_device_self()&lt;/th&gt;&lt;th style='width:150px'&gt;sys_device_caller()&lt;/th&gt;&lt;th style='width:170px'&gt;sys_device_self_suspended()&lt;/th&gt;&lt;th&gt;Co z tego wynika&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Poza opem&lt;/b&gt; (moduł, listener, task prywatny)&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE (0xFF)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE (0xFF)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Nie ma własności pinu/adresu; w trakcie sweepa SUSPEND zapis z zewnątrz dostanie &lt;code&gt;ERR_DEV_SUSPENDED&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Op z komendy / kodu C&lt;/b&gt; na urządzeniu &lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE (0xFF)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (lub &lt;code&gt;true&lt;/code&gt; dla READ / ALWAYS na zawieszonym)&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt; może czytać swoje ID w błędach/eventach i sprawdzać czy ma czytać z kopii RAM; zasoby zablokowane przez inne urządzenia odrzucają zapis (&lt;code&gt;ERR_DEV_PIN_LOCKED&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Zagnieżdżony op&lt;/b&gt; (&lt;code&gt;U&lt;/code&gt; woła &lt;code&gt;D&lt;/code&gt;) — wewnątrz &lt;code&gt;D&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;D&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;U&lt;/code&gt;&lt;/td&gt;&lt;td&gt;stan slotu &lt;code&gt;D&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;D&lt;/code&gt; zapisuje &lt;code&gt;U&lt;/code&gt; jako właściciela (&lt;code&gt;LOCK&lt;/code&gt;, &lt;code&gt;ATTACH&lt;/code&gt;) albo weryfikuje, że woła właściciel &lt;code&gt;U&lt;/code&gt; (&lt;code&gt;LEVEL&lt;/code&gt;, &lt;code&gt;XFER&lt;/code&gt;, &lt;code&gt;UNLOCK&lt;/code&gt;, &lt;code&gt;DETACH&lt;/code&gt;); po powrocie do &lt;code&gt;U&lt;/code&gt; wraca &lt;code&gt;self() = U&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;create(X)&lt;/code&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt; (albo wywołujący)&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (&lt;code&gt;installed=0&lt;/code&gt;)&lt;/td&gt;&lt;td&gt;Gdy &lt;code&gt;create(X)&lt;/code&gt; woła &lt;code&gt;D&lt;/code&gt; (&lt;code&gt;sys_io_claim_*&lt;/code&gt;, &lt;code&gt;sys_i2c_dev_attach&lt;/code&gt;), w &lt;code&gt;D&lt;/code&gt; widoczne jest &lt;code&gt;caller() = X&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;suspend(X)&lt;/code&gt;&lt;/b&gt; (z SUSPEND, REMOVE lub sweepa)&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (flaga ustawiana po hooku)&lt;/td&gt;&lt;td&gt;Wywołania z &lt;code&gt;suspend(X)&lt;/code&gt; do zależności &lt;code&gt;D&lt;/code&gt; dostają w &lt;code&gt;D&lt;/code&gt; &lt;code&gt;caller() = X&lt;/code&gt;, więc omijają bramkę &lt;code&gt;gated()&lt;/code&gt; podczas sweepa i przechodzą kontrolę właściciela&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;resume(X)&lt;/code&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;true&lt;/code&gt; (flaga kasowana po hooku)&lt;/td&gt;&lt;td&gt;Przywraca sprzęt; nieudany &lt;code&gt;resume()&lt;/code&gt; zostawia urządzenie w stanie zawieszonym&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;REMOVE(X)&lt;/code&gt; → &lt;code&gt;release_resources(X)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;stan &lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Zwalnianie zasobów LIFO biegnie wewnątrz opu &lt;code&gt;REMOVE&lt;/code&gt; z &lt;code&gt;self() = X&lt;/code&gt;, więc wołane &lt;code&gt;UNLOCK&lt;/code&gt;/&lt;code&gt;DETACH&lt;/code&gt; dostają &lt;code&gt;caller() = X&lt;/code&gt; i zwalniają zasób&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Krok timera (&lt;code&gt;sys_device_step&lt;/code&gt;)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (zawieszone pomijane)&lt;/td&gt;&lt;td&gt;Task timerów bierze lock przez &lt;code&gt;try_lock&lt;/code&gt;, sprawdza generację i &lt;code&gt;!gated()&lt;/code&gt;; op kroku woła zależności jako &lt;code&gt;caller() = X&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Op &lt;code&gt;NOLOCK&lt;/code&gt; (&lt;code&gt;later.fn&lt;/code&gt;)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;prev&lt;/code&gt;&lt;/td&gt;&lt;td&gt;stan slotu &lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Biegnie po zdjęciu mutexa slotu (pod licznikiem &lt;code&gt;in_flight&lt;/code&gt;), wciąż wewnątrz &lt;code&gt;call_nested()&lt;/code&gt; — ma więc pełne &lt;code&gt;self()&lt;/code&gt; i &lt;code&gt;caller()&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="520" width="1300" x="40" y="1165" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="sysdev-slots-owners" name="2 Sloty, własność zasobów i safe state">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-outer" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fontSize=22;fontStyle=1;fillColor=none;" value="sys_device: sloty, równoległość, własność zasobów i safe state" vertex="1">
          <mxGeometry height="1590" width="1360" x="10" y="10" as="geometry" />
        </mxCell>

        <!-- LANE A: Parallelism and slots -->
        <mxCell id="p2-lane-a" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f0f6ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="A. Tablica slotów s_slots[64] i równoległość tasków (sys_device_slots.c)" vertex="1">
          <mxGeometry height="430" width="1340" x="20" y="60" as="geometry" />
        </mxCell>

        <mxCell id="s-task1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Task A (np. router_work)&lt;/b&gt;&lt;br&gt;własny TLS (&lt;code&gt;s_running&lt;/code&gt;, &lt;code&gt;s_caller&lt;/code&gt;)&lt;br&gt;woła urządzenie &lt;b&gt;id=2&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="210" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="s-task2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Task B (np. timer / urgent)&lt;/b&gt;&lt;br&gt;własny TLS (&lt;code&gt;s_running&lt;/code&gt;, &lt;code&gt;s_caller&lt;/code&gt;)&lt;br&gt;woła urządzenie &lt;b&gt;id=7&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="210" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="s-task3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;Task C (np. policy / event)&lt;/b&gt;&lt;br&gt;op &lt;code&gt;NOLOCK&lt;/code&gt; (np. &lt;code&gt;I2C SCAN&lt;/code&gt;)&lt;br&gt;zdejmuje lock, rośnie &lt;code&gt;in_flight&lt;/code&gt;" vertex="1">
          <mxGeometry height="80" width="210" x="40" y="375" as="geometry" />
        </mxCell>

        <mxCell id="s-slot2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Slot 2 (np. Silnik)&lt;/b&gt;&lt;br&gt;• mutex &lt;code&gt;lock&lt;/code&gt; (nierekursywny, 5 s)&lt;br&gt;• &lt;code&gt;gen = 1..255&lt;/code&gt;, &lt;code&gt;op&lt;/code&gt;&lt;br&gt;• &lt;code&gt;type&lt;/code&gt;, &lt;code&gt;instance&lt;/code&gt;, &lt;code&gt;res&lt;/code&gt; (LIFO)&lt;br&gt;• &lt;code&gt;uses&lt;/code&gt; / &lt;code&gt;used_by&lt;/code&gt; (maski u64)&lt;br&gt;• &lt;code&gt;flags&lt;/code&gt;: inst | susp | sys | rem | rmv" vertex="1">
          <mxGeometry height="115" width="265" x="340" y="105" as="geometry" />
        </mxCell>
        <mxCell id="s-slot7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Slot 7 (np. PCA9685)&lt;/b&gt;&lt;br&gt;• własny mutex &lt;code&gt;lock&lt;/code&gt;&lt;br&gt;• niezależna pamięć i zasoby&lt;br&gt;&lt;i&gt;biegnie równolegle ze Slotem 2!&lt;/i&gt;" vertex="1">
          <mxGeometry height="95" width="265" x="340" y="245" as="geometry" />
        </mxCell>
        <mxCell id="s-slot1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;Slot 1 (np. Szyna I2C)&lt;/b&gt;&lt;br&gt;• wspólna zależność wielu chipów&lt;br&gt;• serializuje tylko transfery do siebie&lt;br&gt;• &lt;code&gt;REMOVE&lt;/code&gt; czeka w &lt;code&gt;drain()&lt;/code&gt; na &lt;code&gt;in_flight==0&lt;/code&gt;" vertex="1">
          <mxGeometry height="95" width="265" x="340" y="365" as="geometry" />
        </mxCell>

        <mxCell id="s-tlock" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;s_table_lock (portMUX)&lt;/b&gt;&lt;br&gt;brany wyłącznie na ułamki µs:&lt;br&gt;• &lt;code&gt;uses&lt;/code&gt; / &lt;code&gt;used_by&lt;/code&gt; + detekcja cykli (&lt;code&gt;ERR_DEV_CYCLE&lt;/code&gt;)&lt;br&gt;• &lt;code&gt;begin_remove&lt;/code&gt; (atomowo &lt;code&gt;used_by==0&lt;/code&gt; + &lt;code&gt;removing=1&lt;/code&gt;)&lt;br&gt;• &lt;code&gt;gen&lt;/code&gt;, &lt;code&gt;in_flight&lt;/code&gt;, zapis &lt;code&gt;flags&lt;/code&gt;&lt;br&gt;&lt;i&gt;Nigdy nie jest trzymany podczas opa sterownika.&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="380" x="680" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s-rules" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Kolejność locków i brak deadlocków:&lt;/b&gt;&lt;br&gt;• Wywołanie &lt;code&gt;U → D&lt;/code&gt; bierze najpierw &lt;code&gt;lock(U)&lt;/code&gt;, potem &lt;code&gt;lock(D)&lt;/code&gt;.&lt;br&gt;• &lt;code&gt;sys_device_use(U, D)&lt;/code&gt; odrzuca cykle (&lt;code&gt;ERR_DEV_CYCLE&lt;/code&gt;), więc graf zależności jest DAG-iem.&lt;br&gt;• Ponowne wejście w ten sam slot w tym samym tasku → &lt;code&gt;ERR_DEV_REENTRY&lt;/code&gt;.&lt;br&gt;• Eventy z opa są wstrzymane do zdjęcia wszystkich locków w &lt;code&gt;call_outermost()&lt;/code&gt;." vertex="1">
          <mxGeometry height="160" width="640" x="680" y="290" as="geometry" />
        </mxCell>

        <mxCell id="se1" edge="1" parent="1" source="s-task1" target="s-slot2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="równolegle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" edge="1" parent="1" source="s-task2" target="s-slot7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="równolegle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" edge="1" parent="1" source="s-task3" target="s-slot1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="NOLOCK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" edge="1" parent="1" source="s-slot7" target="s-slot1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="U → D">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE B: Resource ownership & LIFO cleanup -->
        <mxCell id="p2-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fff8f0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="B. Własność zasobów i automatyczne zwalnianie (sys_device_res_add + sys_device_caller)" vertex="1">
          <mxGeometry height="500" width="1340" x="20" y="510" as="geometry" />
        </mxCell>

        <mxCell id="r-pca" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;PCA9685 (id = 5)&lt;/b&gt;&lt;br&gt;&lt;code&gt;create()&lt;/code&gt; → &lt;code&gt;self() = 5&lt;/code&gt;&lt;hr&gt;Lista zasobów &lt;code&gt;s_slots[5].res&lt;/code&gt;:&lt;br&gt;1. &lt;code&gt;c-&amp;gt;i2c&lt;/code&gt; (adres I2C)&lt;br&gt;2. &lt;code&gt;c-&amp;gt;oe&lt;/code&gt; (pin OE)&lt;br&gt;&lt;i&gt;(dodane przed zajęciem)&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="40" y="585" as="geometry" />
        </mxCell>
        <mxCell id="r-i2c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Szyna I2C (id = 1)&lt;/b&gt;&lt;br&gt;&lt;code&gt;ATTACH(0x40)&lt;/code&gt; widzi:&lt;br&gt;&lt;code&gt;caller() == 5&lt;/code&gt;&lt;br&gt;→ &lt;code&gt;c-&amp;gt;owner[0x40] = 5&lt;/code&gt;&lt;hr&gt;&lt;code&gt;XFER&lt;/code&gt; / &lt;code&gt;DETACH&lt;/code&gt; przechodzą&lt;br&gt;tylko gdy &lt;code&gt;caller() == 5&lt;/code&gt;" vertex="1">
          <mxGeometry height="135" width="230" x="350" y="560" as="geometry" />
        </mxCell>
        <mxCell id="r-gpio" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;ESP32-S3 GPIO (id = 0)&lt;/b&gt;&lt;br&gt;&lt;code&gt;LOCK(pin)&lt;/code&gt; widzi:&lt;br&gt;&lt;code&gt;caller() == 5&lt;/code&gt;&lt;br&gt;→ &lt;code&gt;pins.owner[pin] = 5&lt;/code&gt;&lt;hr&gt;&lt;code&gt;LEVEL/MODE/INTR/UNLOCK&lt;/code&gt;&lt;br&gt;przechodzą dla &lt;code&gt;caller() == 5&lt;/code&gt;" vertex="1">
          <mxGeometry height="135" width="230" x="350" y="725" as="geometry" />
        </mxCell>

        <mxCell id="r-intruder" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Obce wywołanie&lt;/b&gt;&lt;br&gt;APP (&lt;code&gt;caller=NONE&lt;/code&gt;) lub inny sterownik (&lt;code&gt;caller=8&lt;/code&gt;)&lt;hr&gt;• próba &lt;code&gt;IO_LEVEL&lt;/code&gt; na pinie OE → &lt;b&gt;&lt;code&gt;ERR_DEV_PIN_LOCKED{owner=5}&lt;/code&gt;&lt;/b&gt;&lt;br&gt;• próba &lt;code&gt;IO_UNLOCK&lt;/code&gt; → &lt;b&gt;&lt;code&gt;ERR_DEV_PIN_NOT_OWNED{owner=5}&lt;/code&gt;&lt;/b&gt;&lt;br&gt;• próba &lt;code&gt;I2C_RAW&lt;/code&gt; na &lt;code&gt;0x40&lt;/code&gt; → &lt;b&gt;&lt;code&gt;ERR_I2C_ADDR_TAKEN{owner=5}&lt;/code&gt;&lt;/b&gt;&lt;br&gt;• &lt;code&gt;ATTACH / DETACH / LOCK / UNLOCK / XFER&lt;/code&gt; z APP → &lt;b&gt;&lt;code&gt;ERR_DEV_LOCAL_OP&lt;/code&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="165" width="380" x="650" y="560" as="geometry" />
        </mxCell>
        <mxCell id="r-remove" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;REMOVE(5) lub nieudane create(5):&lt;/b&gt;&lt;br&gt;1. przy REMOVE (jeśli aktywne): &lt;code&gt;suspend(5)&lt;/code&gt; (&lt;code&gt;self()=5&lt;/code&gt;, ustawia OE=1, usypia chip)&lt;br&gt;2. &lt;code&gt;release_resources(5)&lt;/code&gt; w kolejności &lt;b&gt;LIFO&lt;/b&gt; (ostatni dodany pierwszy):&lt;br&gt;   • oddaje pin OE (&lt;code&gt;UNLOCK&lt;/code&gt; widzi &lt;code&gt;caller()=5&lt;/code&gt; → OK)&lt;br&gt;   • oddaje adres I2C (&lt;code&gt;DETACH&lt;/code&gt; widzi &lt;code&gt;caller()=5&lt;/code&gt; → OK)&lt;br&gt;3. zwalnia zależności (&lt;code&gt;uses/used_by&lt;/code&gt;) i pamięć &lt;code&gt;instance&lt;/code&gt;. Brak ręcznego &lt;code&gt;uninstall()&lt;/code&gt; w sterownikach." vertex="1">
          <mxGeometry height="145" width="660" x="650" y="750" as="geometry" />
        </mxCell>

        <mxCell id="re1" edge="1" parent="1" source="r-pca" target="r-i2c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" value="use + ATTACH">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" edge="1" parent="1" source="r-pca" target="r-gpio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" value="use + LOCK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" edge="1" parent="1" source="r-intruder" target="r-i2c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;dashed=1;exitX=0;exitY=0.4;entryX=1;entryY=0.5;" value="odmowa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" edge="1" parent="1" source="r-intruder" target="r-gpio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.3;" value="odmowa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE C: Safe state sweep -->
        <mxCell id="p2-lane-c" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fffdf0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="C. Bramka safe state podczas sys_device_sweep(SUSPEND)" vertex="1">
          <mxGeometry height="540" width="1340" x="20" y="1030" as="geometry" />
        </mxCell>

        <mxCell id="g-order" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;1. Kolejność topologiczna (user przed depem)&lt;/b&gt;&lt;br&gt;&lt;code&gt;Silnik → Mostek → PCA9685 → Szyna I2C / GPIO&lt;/code&gt;&lt;br&gt;(dla &lt;code&gt;RESUME&lt;/code&gt; odwrotnie: dep przed userem)" vertex="1">
          <mxGeometry height="85" width="430" x="40" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="g-gate" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;2. Aktywna bramka: &lt;code&gt;s_safe_gate &amp;gt; 0&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;code&gt;gated() = (s_safe_gate != 0 &amp;amp;&amp;amp; s_caller == 0)&lt;/code&gt;&lt;br&gt;• zapis z zewnątrz (APP, VM, timer &lt;code&gt;step&lt;/code&gt;) i &lt;code&gt;CREATE&lt;/code&gt;: &lt;code&gt;s_caller == 0&lt;/code&gt; → &lt;b&gt;odrzucone (&lt;code&gt;ERR_DEV_SUSPENDED&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;• op &lt;code&gt;SUSPEND&lt;/code&gt; przechodzi jako op rejestru&lt;br&gt;• hook &lt;code&gt;suspend()&lt;/code&gt; urządzenia &lt;code&gt;A&lt;/code&gt; wołający zależność &lt;code&gt;D&lt;/code&gt;: w &lt;code&gt;D&lt;/code&gt; jest &lt;code&gt;s_caller = A+1 != 0&lt;/code&gt; → &lt;b&gt;przechodzi!&lt;/b&gt;" vertex="1">
          <mxGeometry height="145" width="520" x="510" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="g-policy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;3. Task policy (priorytet 14)&lt;/b&gt;&lt;br&gt;Błąd CRITICAL w opcie urządzenia kopiuje &lt;code&gt;err_record&lt;/code&gt; do kolejki; task policy robi sweep z zewnątrz (bez trzymania żadnego locka slotu)." vertex="1">
          <mxGeometry height="85" width="430" x="40" y="1195" as="geometry" />
        </mxCell>
        <mxCell id="g-events" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;4. Event na koniec sweepa&lt;/b&gt;&lt;br&gt;&lt;code&gt;s_sweeping &amp;gt; 0&lt;/code&gt; tłumi eventy per urządzenie; po ostatnim urządzeniu i zdjęciu &lt;code&gt;s_safe_gate&lt;/code&gt; idzie jeden event ze źródłem &lt;code&gt;NONE&lt;/code&gt; (&lt;code&gt;SUSPENDED / RESUMED / RESET&lt;/code&gt;), a przy &lt;code&gt;REMOVE&lt;/code&gt; — &lt;code&gt;REMOVED&lt;/code&gt; dla każdego usuniętego." vertex="1">
          <mxGeometry height="90" width="990" x="40" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="g-legend" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="&lt;b&gt;Legenda kolorów:&lt;/b&gt; &amp;nbsp; &lt;span style='background:#dae8fc;border:1px solid #6c8ebf;padding:1px 6px'&gt;Wywołujący / task&lt;/span&gt; &amp;nbsp; &lt;span style='background:#F2CC8F;border:1px solid #E07A5F;padding:1px 6px'&gt;Warstwa wywołania / zależność&lt;/span&gt; &amp;nbsp; &lt;span style='background:#e1d5e7;border:1px solid #9673a6;padding:1px 6px'&gt;TLS / cykl życia / policy&lt;/span&gt; &amp;nbsp; &lt;span style='background:#cdeb8b;border:1px solid #36393d;padding:1px 6px'&gt;Slot / sterownik&lt;/span&gt; &amp;nbsp; &lt;span style='background:#ffcccc;border:1px solid #36393d;padding:1px 6px'&gt;Bramka / blokada / błąd&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="1290" x="40" y="1430" as="geometry" />
        </mxCell>

        <mxCell id="ge1" edge="1" parent="1" source="g-order" target="g-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge2" edge="1" parent="1" source="g-policy" target="g-order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" value="uruchamia sweep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
