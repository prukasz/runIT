<mxfile host="Electron" pages="2">
  <diagram id="sysdev-call-tls" name="1 Przepływ wywołania i TLS">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-outer" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fontSize=22;fontStyle=1;fillColor=none;" value="sys_device: wywołanie, tożsamość (sys_device_self / caller) i TLS" vertex="1">
          <mxGeometry height="1825" width="1360" x="10" y="10" as="geometry" />
        </mxCell>

        <!-- LANE A: Call pipeline -->
        <mxCell id="p1-lane-a" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fff8f0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="A. Ścieżka wywołania (sys_device_call.c) — wszystko w bieżącym tasku, bez kolejki" vertex="1">
          <mxGeometry height="610" width="1340" x="20" y="60" as="geometry" />
        </mxCell>

        <!-- Entry points -->
        <mxCell id="a-app" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;APP / Router / Remote&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_call_routed&lt;/code&gt;&lt;br&gt;(&lt;i&gt;how.routed = true&lt;/i&gt;, bez &lt;code&gt;LOCAL&lt;/code&gt;)" vertex="1">
          <mxGeometry height="82" width="205" x="40" y="105" as="geometry" />
        </mxCell>
        <mxCell id="a-c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Kod C / Sterownik / Moduł&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_write / read / call&lt;/code&gt;&lt;br&gt;(&lt;i&gt;how = {0}&lt;/i&gt;, &lt;code&gt;LOCAL&lt;/code&gt; OK)" vertex="1">
          <mxGeometry height="82" width="205" x="40" y="197" as="geometry" />
        </mxCell>
        <mxCell id="a-step" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Timer (&lt;code&gt;sys_device_timer&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_step(id, gen, op)&lt;/code&gt;&lt;br&gt;&lt;i&gt;OWN op, gen != 0, try_lock&lt;/i&gt; (cichy skip)" vertex="1">
          <mxGeometry height="82" width="205" x="40" y="289" as="geometry" />
        </mxCell>
        <mxCell id="a-deliver" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Zdarzenie (&lt;code&gt;sys_device_event&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_deliver(id, gen, op…)&lt;/code&gt;&lt;br&gt;&lt;i&gt;gen != 0, slot_lock&lt;/i&gt; (&lt;code&gt;ALWAYS&lt;/code&gt; OK)" vertex="1">
          <mxGeometry height="82" width="205" x="40" y="381" as="geometry" />
        </mxCell>
        <mxCell id="a-sweep" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;Sweep (&lt;code&gt;SUSPEND/RESUME/…&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_sweep(op)&lt;/code&gt;&lt;br&gt;własny &lt;code&gt;hold&lt;/code&gt;, &lt;code&gt;how.sweep=1&lt;/code&gt;,&lt;br&gt;ew. &lt;code&gt;s_safe_gate++&lt;/code&gt;" vertex="1">
          <mxGeometry height="92" width="205" x="40" y="473" as="geometry" />
        </mxCell>

        <!-- Pipeline boxes -->
        <mxCell id="a-dispatch" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;call_dispatch()&lt;/code&gt;&lt;/b&gt;&lt;br&gt;rozwidlenie wg&lt;br&gt;&lt;code&gt;s_frame&lt;/code&gt;" vertex="1">
          <mxGeometry height="95" width="125" x="285" y="238" as="geometry" />
        </mxCell>
        <mxCell id="a-outer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;call_outermost()&lt;/code&gt;&lt;/b&gt; (&lt;i&gt;noinline&lt;/i&gt;)&lt;br&gt;• stos: &lt;code&gt;room[256 B]&lt;/code&gt;&lt;br&gt;• &lt;code&gt;sys_event_hold()&lt;/code&gt; przed &lt;code&gt;call_exec&lt;/code&gt;&lt;br&gt;• &lt;code&gt;sys_event_release()&lt;/code&gt; po powrocie" vertex="1">
          <mxGeometry height="110" width="225" x="475" y="105" as="geometry" />
        </mxCell>
        <mxCell id="a-exec" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;call_exec()&lt;/code&gt;&lt;/b&gt;&lt;br&gt;1. na stosie: &lt;code&gt;frame = {.up = s_frame, .id}&lt;/code&gt;&lt;br&gt;2. &lt;b&gt;&lt;code&gt;s_frame = &amp;amp;frame&lt;/code&gt;&lt;/b&gt; &lt;i&gt;(wskaźnik TLS)&lt;/i&gt;&lt;br&gt;3. &lt;code&gt;interceptor-&amp;gt;fn()&lt;/code&gt; &lt;i&gt;(bez locka)&lt;/i&gt;&lt;br&gt;4. wywołaj &lt;code&gt;call_device()&lt;/code&gt;&lt;br&gt;5. &lt;code&gt;interceptor-&amp;gt;done()&lt;/code&gt; &lt;i&gt;(bez locka)&lt;/i&gt;&lt;br&gt;6. &lt;b&gt;&lt;code&gt;s_frame = frame.up&lt;/code&gt;&lt;/b&gt; &lt;i&gt;(jedno przypisanie!)&lt;/i&gt;&lt;br&gt;7. błąd owija w &lt;code&gt;ERR_DEV_OP&lt;/code&gt; + &lt;code&gt;ERR_DEV_ID&lt;/code&gt;" vertex="1">
          <mxGeometry height="205" width="265" x="475" y="248" as="geometry" />
        </mxCell>
        <mxCell id="a-dev" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;call_device()&lt;/code&gt;&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;step ? try_lock : slot_lock&lt;/code&gt;; wspólny skip&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;stale || (step &amp;amp;&amp;amp; (susp || gated()))&lt;/code&gt; → &lt;code&gt;NULL&lt;/code&gt;&lt;br&gt;2. &lt;code&gt;run_locked()&lt;/code&gt; → &lt;code&gt;change_of()&lt;/code&gt;&lt;br&gt;3. &lt;code&gt;sys_device_slot_unlock(id)&lt;/code&gt;&lt;br&gt;4. &lt;code&gt;publish_change()&lt;/code&gt; (w &lt;code&gt;hold&lt;/code&gt;, jeśli&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;!how-&amp;gt;sweep || CREATED || REMOVED&lt;/code&gt;)&lt;br&gt;5. poza lockiem: &lt;code&gt;NOLOCK&lt;/code&gt; (&lt;code&gt;later.fn&lt;/code&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;albo &lt;code&gt;sys_device_remote_send()&lt;/code&gt;" vertex="1">
          <mxGeometry height="205" width="255" x="775" y="248" as="geometry" />
        </mxCell>
        <mxCell id="a-locked" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;run_locked()&lt;/code&gt; + sterownik&lt;/b&gt;&lt;br&gt;• &lt;code&gt;CREATE&lt;/code&gt; / &lt;code&gt;CREATE_REMOTE&lt;/code&gt; (&lt;code&gt;!gated()&lt;/code&gt;)&lt;br&gt;• op rejestru (&lt;code&gt;own != NULL&lt;/code&gt;) / op typu&lt;br&gt;• odmowa &lt;code&gt;ERR_DEV_SUSPENDED&lt;/code&gt; dla zapisu&lt;br&gt;&amp;nbsp;&amp;nbsp;bez &lt;code&gt;ALWAYS&lt;/code&gt; gdy &lt;code&gt;suspended || gated()&lt;/code&gt;&lt;br&gt;• odmowa &lt;code&gt;ERR_DEV_LOCAL_OP&lt;/code&gt; gdy&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;(routed || is_remote) &amp;amp;&amp;amp; LOCAL&lt;/code&gt;&lt;br&gt;• sterownik widzi: &lt;code&gt;sys_device_self() == id&lt;/code&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;sys_device_caller() == prev&lt;/code&gt;" vertex="1">
          <mxGeometry height="205" width="280" x="1060" y="248" as="geometry" />
        </mxCell>

        <!-- Nesting loopback and event release notes -->
        <mxCell id="a-note-nest" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Wywołanie zagnieżdżone (sterownik U → D):&lt;/b&gt; handler w &lt;code&gt;U&lt;/code&gt; woła &lt;code&gt;sys_device_write(D, …)&lt;/code&gt; → wchodzi w &lt;code&gt;call_dispatch()&lt;/code&gt; (&lt;code&gt;s_frame != NULL&lt;/code&gt;) → omija &lt;code&gt;call_outermost()&lt;/code&gt; i wchodzi prosto w &lt;code&gt;call_exec()&lt;/code&gt; (dla &lt;code&gt;D&lt;/code&gt;: &lt;code&gt;caller() = U&lt;/code&gt;, &lt;code&gt;self() = D&lt;/code&gt;, ten sam &lt;code&gt;hold&lt;/code&gt; na ramce zewnętrznej)" vertex="1">
          <mxGeometry height="65" width="845" x="475" y="492" as="geometry" />
        </mxCell>
        <mxCell id="a-note-evt" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Eventy po powrocie z &lt;code&gt;call_outermost()&lt;/code&gt; (i na końcu &lt;code&gt;sys_device_sweep()&lt;/code&gt;):&lt;/b&gt; wszystkie locki slotów są już zdjęte, a &lt;code&gt;s_frame = NULL&lt;/code&gt;. Listenery inline mogą bezpiecznie wołać dowolne urządzenie (bez deadlocka i bez &lt;code&gt;ERR_DEV_REENTRY&lt;/code&gt;); nadmiar z ramki lub &lt;code&gt;DEFER&lt;/code&gt; idzie do taska eventów." vertex="1">
          <mxGeometry height="62" width="1300" x="40" y="588" as="geometry" />
        </mxCell>

        <!-- Edges in Lane A -->
        <mxCell id="ae1" edge="1" parent="1" source="a-app" target="a-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" edge="1" parent="1" source="a-c" target="a-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae3" edge="1" parent="1" source="a-step" target="a-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4d" edge="1" parent="1" source="a-deliver" target="a-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4s" edge="1" parent="1" source="a-sweep" target="a-exec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;dashed=1;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0.35;entryY=1;" value="call_exec (how.sweep=1)">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="265" y="519" />
              <mxPoint x="265" y="472" />
              <mxPoint x="568" y="472" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ae5" edge="1" parent="1" source="a-dispatch" target="a-outer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" value="s_frame == NULL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae6" edge="1" parent="1" source="a-dispatch" target="a-exec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.75;entryX=0;entryY=0.2;" value="s_frame != NULL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae7" edge="1" parent="1" source="a-outer" target="a-exec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.42;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae9" edge="1" parent="1" source="a-exec" target="a-dev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae10" edge="1" parent="1" source="a-dev" target="a-locked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae11" edge="1" parent="1" source="a-locked" target="a-note-nest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="472" />
              <mxPoint x="1345" y="472" />
              <mxPoint x="1345" y="524" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ae12" edge="1" parent="1" source="a-note-nest" target="a-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;dashed=1;exitX=0;exitY=0.5;entryX=0.75;entryY=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="379" y="524" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- LANE B: TLS trace U -> D -->
        <mxCell id="p1-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fffdf0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="B. Zmiana tożsamości w TLS (__thread) — przykład zagnieżdżenia: APP → PCA9685 (id=5) → GPIO (id=0)" vertex="1">
          <mxGeometry height="410" width="1340" x="20" y="685" as="geometry" />
        </mxCell>

        <mxCell id="b-s0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;1. Task przed wywołaniem&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;code&gt;s_frame = NULL&lt;/code&gt;&lt;br&gt;&lt;i&gt;(brak ramki na stosie)&lt;/i&gt;&lt;hr&gt;self() = &lt;b&gt;NONE&lt;/b&gt;&lt;br&gt;caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="155" width="205" x="40" y="740" as="geometry" />
        </mxCell>
        <mxCell id="b-s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;2. Wejście w PCA9685 (id=5)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;code&gt;f5 = {.up=NULL, .id=5}&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_frame = &amp;amp;f5&lt;/code&gt;&lt;hr&gt;self() = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="155" width="215" x="280" y="740" as="geometry" />
        </mxCell>
        <mxCell id="b-s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;3. PCA (5) woła GPIO (id=0)&lt;/b&gt;&lt;br&gt;(np. &lt;code&gt;CONTRACT_IO OP_LEVEL&lt;/code&gt; na OE)&lt;hr&gt;&lt;code&gt;f0 = {.up=&amp;amp;f5, .id=0}&lt;/code&gt;&lt;br&gt;&lt;code&gt;s_frame = &amp;amp;f0&lt;/code&gt;&lt;hr&gt;self() = &lt;b&gt;0&lt;/b&gt; · caller() = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;&lt;i&gt;owner[oe]==5 → OK!&lt;/i&gt;" vertex="1">
          <mxGeometry height="155" width="245" x="530" y="740" as="geometry" />
        </mxCell>
        <mxCell id="b-s3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;4. Powrót z GPIO do PCA&lt;/b&gt;&lt;br&gt;&lt;code&gt;call_exec()&lt;/code&gt; odtwarza jednym zapisem:&lt;hr&gt;&lt;code&gt;s_frame = f0.up&lt;/code&gt; (&lt;code&gt;&amp;amp;f5&lt;/code&gt;)&lt;br&gt;&amp;nbsp;&lt;hr&gt;self() = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="155" width="225" x="810" y="740" as="geometry" />
        </mxCell>
        <mxCell id="b-s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;5. Wyjście + release eventów&lt;/b&gt;&lt;br&gt;locki zdjęte, odtworzone:&lt;hr&gt;&lt;code&gt;s_frame = f5.up&lt;/code&gt; (&lt;code&gt;NULL&lt;/code&gt;)&lt;br&gt;&amp;nbsp;&lt;hr&gt;listener widzi:&lt;br&gt;self() = &lt;b&gt;NONE&lt;/b&gt;, caller() = &lt;b&gt;NONE&lt;/b&gt;" vertex="1">
          <mxGeometry height="155" width="250" x="1070" y="740" as="geometry" />
        </mxCell>

        <mxCell id="b-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Dlaczego 1 wskaźnik TLS &lt;code&gt;s_frame&lt;/code&gt; i ramka na stosie w &lt;code&gt;.tbss&lt;/code&gt;?&lt;/b&gt; &amp;nbsp;Cały stan TLS wątku to jeden wskaźnik &lt;code&gt;static __thread const call_frame_t* s_frame&lt;/code&gt; w sekcji &lt;code&gt;.tbss&lt;/code&gt; — każdy nowy task FreeRTOS dostaje &lt;code&gt;NULL&lt;/code&gt; automatycznie, bez &lt;code&gt;.tdata&lt;/code&gt;. Zagnieżdżenia łączą się na stosie (&lt;code&gt;frame.up&lt;/code&gt;) bez licznika &lt;code&gt;s_depth&lt;/code&gt;, bez triku &lt;code&gt;id + 1&lt;/code&gt; i z jednym przypisaniem przy wyjściu; prywatny wątek sterownika ma zawsze &lt;code&gt;s_frame == NULL&lt;/code&gt;." vertex="1">
          <mxGeometry height="65" width="1280" x="40" y="925" as="geometry" />
        </mxCell>
        <mxCell id="b-note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;sys_device_self_suspended()&lt;/code&gt;:&lt;/b&gt; zwraca &lt;code&gt;s_frame != NULL &amp;amp;&amp;amp; s_frame-&amp;gt;id &amp;lt; SYS_DEVICE_COUNT &amp;amp;&amp;amp; sys_device_slot_is_suspended(s_frame-&amp;gt;id)&lt;/code&gt;. Służy opom &lt;code&gt;READ&lt;/code&gt; oraz &lt;code&gt;SYS_DEVICE_OP_ALWAYS&lt;/code&gt; (np. &lt;code&gt;ON_EVENT&lt;/code&gt;), aby zwrócić kopię stanu z RAM lub pominąć zapis do uśpionego sprzętu — bez własnej flagi &lt;code&gt;suspended&lt;/code&gt; w strukturze sterownika." vertex="1">
          <mxGeometry height="60" width="1280" x="40" y="1005" as="geometry" />
        </mxCell>

        <mxCell id="be1" edge="1" parent="1" source="b-s0" target="b-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be2" edge="1" parent="1" source="b-s1" target="b-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be3" edge="1" parent="1" source="b-s2" target="b-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be4" edge="1" parent="1" source="b-s3" target="b-s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE C: Context table -->
        <mxCell id="p1-lane-c" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f4fbe6;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="C. Co widzi kod w poszczególnych miejscach wykonania" vertex="1">
          <mxGeometry height="700" width="1340" x="20" y="1115" as="geometry" />
        </mxCell>
        <mxCell id="c-table" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="&lt;table border='1' cellpadding='5' style='border-collapse:collapse;font-size:12px;width:1290px'&gt;&lt;tr style='background:#e9f5d8'&gt;&lt;th style='width:290px'&gt;Kontekst wykonania&lt;/th&gt;&lt;th style='width:130px'&gt;sys_device_self()&lt;/th&gt;&lt;th style='width:140px'&gt;sys_device_caller()&lt;/th&gt;&lt;th style='width:170px'&gt;sys_device_self_suspended()&lt;/th&gt;&lt;th&gt;Co z tego wynika&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Poza opem&lt;/b&gt; (moduł, listener, task prywatny)&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE (0xFF)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE (0xFF)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Nie ma własności pinu/adresu; podczas sweepa &lt;code&gt;SUSPEND&lt;/code&gt; (&lt;code&gt;s_safe_gate &amp;gt; 0&lt;/code&gt;) zapis z zewnątrz oraz &lt;code&gt;CREATE&lt;/code&gt; dostają &lt;code&gt;ERR_DEV_SUSPENDED&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Op z komendy / kodu C&lt;/b&gt; na urządzeniu &lt;code&gt;X&lt;/code&gt; (&lt;code&gt;call_routed&lt;/code&gt; / &lt;code&gt;call&lt;/code&gt;)&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE (0xFF)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (lub &lt;code&gt;true&lt;/code&gt; dla &lt;code&gt;READ&lt;/code&gt; / &lt;code&gt;ALWAYS&lt;/code&gt; na zawieszonym)&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt; ma swoje ID w błędach/eventach i może czytać kopię z RAM; zablokowane piny i adresy I2C odrzucają dostęp (&lt;code&gt;ERR_DEV_PIN_LOCKED&lt;/code&gt;, &lt;code&gt;ERR_I2C_NOT_OWNER&lt;/code&gt;); &lt;code&gt;routed&lt;/code&gt; odrzuca &lt;code&gt;LOCAL&lt;/code&gt; (&lt;code&gt;ERR_DEV_LOCAL_OP&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Zagnieżdżony op&lt;/b&gt; (&lt;code&gt;U&lt;/code&gt; woła &lt;code&gt;D&lt;/code&gt;) — wewnątrz &lt;code&gt;D&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;D&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;U&lt;/code&gt;&lt;/td&gt;&lt;td&gt;stan slotu &lt;code&gt;D&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;D&lt;/code&gt; zapisuje &lt;code&gt;U&lt;/code&gt; jako właściciela (&lt;code&gt;LOCK&lt;/code&gt;, &lt;code&gt;ATTACH&lt;/code&gt;) albo weryfikuje &lt;code&gt;caller() == U&lt;/code&gt; (&lt;code&gt;LEVEL&lt;/code&gt;, &lt;code&gt;XFER&lt;/code&gt;, &lt;code&gt;UNLOCK&lt;/code&gt;, &lt;code&gt;DETACH&lt;/code&gt;); po powrocie do &lt;code&gt;U&lt;/code&gt; wraca &lt;code&gt;self() = U&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;create(X)&lt;/code&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt; (albo wywołujący)&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (&lt;code&gt;installed=0&lt;/code&gt;)&lt;/td&gt;&lt;td&gt;Gdy &lt;code&gt;create(X)&lt;/code&gt; woła &lt;code&gt;D&lt;/code&gt; (&lt;code&gt;sys_io_claim_*&lt;/code&gt;, &lt;code&gt;sys_i2c_dev_attach&lt;/code&gt;), w &lt;code&gt;D&lt;/code&gt; jest &lt;code&gt;caller() = X&lt;/code&gt;; &lt;code&gt;sys_device_gen(X)&lt;/code&gt; ma już nową generację (&lt;code&gt;begin_create&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;suspend(X)&lt;/code&gt;&lt;/b&gt; (z &lt;code&gt;SUSPEND&lt;/code&gt;, &lt;code&gt;REMOVE&lt;/code&gt; lub sweepa)&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (flaga ustawiana po hooku)&lt;/td&gt;&lt;td&gt;Wywołania z &lt;code&gt;suspend(X)&lt;/code&gt; do zależności &lt;code&gt;D&lt;/code&gt; dostają w &lt;code&gt;D&lt;/code&gt; &lt;code&gt;caller() = X&lt;/code&gt;, więc omijają &lt;code&gt;gated()&lt;/code&gt; podczas sweepa i przechodzą kontrolę właściciela&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;resume(X)&lt;/code&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;true&lt;/code&gt; (flaga kasowana po hooku)&lt;/td&gt;&lt;td&gt;Przywraca sprzęt; nieudany &lt;code&gt;resume()&lt;/code&gt; zostawia urządzenie w stanie zawieszonym&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;code&gt;REMOVE(X)&lt;/code&gt; → &lt;code&gt;drain&lt;/code&gt; + &lt;code&gt;suspend&lt;/code&gt; + &lt;code&gt;release_resources(X)&lt;/code&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;stan &lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Sprawdza &lt;code&gt;used_by == 0&lt;/code&gt; (&lt;code&gt;begin_remove&lt;/code&gt;), czeka w &lt;code&gt;drain()&lt;/code&gt; na &lt;code&gt;in_flight == 0&lt;/code&gt;, zawiesza aktywne, a następnie zwalnia zasoby LIFO wewnątrz &lt;code&gt;REMOVE&lt;/code&gt; (&lt;code&gt;caller() = X&lt;/code&gt; w &lt;code&gt;UNLOCK&lt;/code&gt;/&lt;code&gt;DETACH&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Krok timera (&lt;code&gt;sys_device_step&lt;/code&gt;)&lt;/b&gt; (&lt;code&gt;sys_device_timer&lt;/code&gt;)&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;false&lt;/code&gt; (zawieszone pomijane)&lt;/td&gt;&lt;td&gt;Task timerów bierze lock przez &lt;code&gt;try_lock&lt;/code&gt; i przyjmuje tylko op &lt;code&gt;OWN&lt;/code&gt;; gdy slot zajęty, usunięty, inna generacja, zawieszony lub &lt;code&gt;gated()&lt;/code&gt; → cicho pomija (&lt;code&gt;NULL&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Dostarczenie zdarzenia (&lt;code&gt;sys_device_deliver&lt;/code&gt;)&lt;/b&gt; (&lt;code&gt;sys_device_event&lt;/code&gt;)&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;NONE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;stan slotu &lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Bierze &lt;code&gt;slot_lock&lt;/code&gt; i sprawdza generację (pomija cicho gdy usunięte lub zły &lt;code&gt;gen&lt;/code&gt;); respektuje flagę &lt;code&gt;SYS_DEVICE_OP_ALWAYS&lt;/code&gt; (działa mimo &lt;code&gt;suspended&lt;/code&gt; / &lt;code&gt;gated()&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Op &lt;code&gt;NOLOCK&lt;/code&gt; (&lt;code&gt;later.fn&lt;/code&gt;)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;prev&lt;/code&gt;&lt;/td&gt;&lt;td&gt;stan slotu &lt;code&gt;X&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Biegnie po zdjęciu mutexa slotu (pod licznikiem &lt;code&gt;in_flight&lt;/code&gt;), wciąż wewnątrz &lt;code&gt;call_exec()&lt;/code&gt; — ma więc pełne &lt;code&gt;self()&lt;/code&gt; i &lt;code&gt;caller()&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="630" width="1290" x="40" y="1160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="sysdev-slots-owners" name="2 Sloty, własność zasobów i safe state">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-outer" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fontSize=22;fontStyle=1;fillColor=none;" value="sys_device: sloty, równoległość, własność zasobów i safe state" vertex="1">
          <mxGeometry height="1640" width="1360" x="10" y="10" as="geometry" />
        </mxCell>

        <!-- LANE A: Parallelism and slots -->
        <mxCell id="p2-lane-a" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#f0f6ff;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="A. Tablica slotów s_slots[64] i równoległość tasków (sys_device_slots.c)" vertex="1">
          <mxGeometry height="430" width="1340" x="20" y="60" as="geometry" />
        </mxCell>

        <mxCell id="s-task1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Task A (np. router_work)&lt;/b&gt;&lt;br&gt;własny TLS (&lt;code&gt;s_frame&lt;/code&gt;)&lt;br&gt;woła urządzenie &lt;b&gt;id=2&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="210" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="s-task2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;Task B (np. timer / urgent)&lt;/b&gt;&lt;br&gt;własny TLS (&lt;code&gt;s_frame&lt;/code&gt;)&lt;br&gt;woła urządzenie &lt;b&gt;id=7&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="210" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="s-task3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;Task C (np. policy / event)&lt;/b&gt;&lt;br&gt;op &lt;code&gt;NOLOCK&lt;/code&gt; (np. &lt;code&gt;I2C SCAN&lt;/code&gt;)&lt;br&gt;zdejmuje lock, rośnie &lt;code&gt;in_flight&lt;/code&gt;" vertex="1">
          <mxGeometry height="80" width="210" x="40" y="375" as="geometry" />
        </mxCell>

        <mxCell id="s-slot2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Slot 2 (np. Silnik)&lt;/b&gt;&lt;br&gt;• mutex &lt;code&gt;lock&lt;/code&gt; (nierekursywny, 500 ms)&lt;br&gt;• &lt;code&gt;gen = 1..255&lt;/code&gt;, &lt;code&gt;op&lt;/code&gt;, &lt;code&gt;in_flight&lt;/code&gt;&lt;br&gt;• &lt;code&gt;type&lt;/code&gt;, &lt;code&gt;instance&lt;/code&gt;, &lt;code&gt;res&lt;/code&gt; (LIFO)&lt;br&gt;• &lt;code&gt;uses&lt;/code&gt; / &lt;code&gt;used_by&lt;/code&gt; (maski u64)&lt;br&gt;• &lt;code&gt;flags&lt;/code&gt;: inst | susp | sys | rem | rmv" vertex="1">
          <mxGeometry height="115" width="265" x="340" y="105" as="geometry" />
        </mxCell>
        <mxCell id="s-slot7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Slot 7 (np. PCA9685)&lt;/b&gt;&lt;br&gt;• własny mutex &lt;code&gt;lock&lt;/code&gt;&lt;br&gt;• niezależna pamięć i zasoby&lt;br&gt;&lt;i&gt;biegnie równolegle ze Slotem 2!&lt;/i&gt;" vertex="1">
          <mxGeometry height="95" width="265" x="340" y="245" as="geometry" />
        </mxCell>
        <mxCell id="s-slot1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;Slot 1 (np. Szyna I2C)&lt;/b&gt;&lt;br&gt;• wspólna zależność wielu chipów&lt;br&gt;• serializuje tylko transfery do siebie&lt;br&gt;• &lt;code&gt;REMOVE&lt;/code&gt; czeka w &lt;code&gt;drain()&lt;/code&gt; na &lt;code&gt;in_flight==0&lt;/code&gt;" vertex="1">
          <mxGeometry height="95" width="265" x="340" y="365" as="geometry" />
        </mxCell>

        <mxCell id="s-tlock" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;s_table_lock&lt;/code&gt; (portMUX)&lt;/b&gt;&lt;br&gt;brany wyłącznie na ułamki µs:&lt;br&gt;• &lt;code&gt;uses&lt;/code&gt; / &lt;code&gt;used_by&lt;/code&gt; + detekcja cykli (&lt;code&gt;ERR_DEV_CYCLE&lt;/code&gt;)&lt;br&gt;• &lt;code&gt;begin_remove&lt;/code&gt; (atomowo &lt;code&gt;used_by==0&lt;/code&gt; + &lt;code&gt;removing=1&lt;/code&gt;)&lt;br&gt;• &lt;code&gt;gen&lt;/code&gt;, &lt;code&gt;in_flight&lt;/code&gt;, zapis &lt;code&gt;flags&lt;/code&gt;&lt;br&gt;&lt;i&gt;Nigdy nie jest trzymany podczas opa sterownika.&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="380" x="680" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s-rules" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Kolejność locków i brak deadlocków:&lt;/b&gt;&lt;br&gt;• Wywołanie &lt;code&gt;U → D&lt;/code&gt; bierze najpierw &lt;code&gt;lock(U)&lt;/code&gt;, potem &lt;code&gt;lock(D)&lt;/code&gt;.&lt;br&gt;• &lt;code&gt;sys_device_use(U, D)&lt;/code&gt; odrzuca cykle (&lt;code&gt;ERR_DEV_CYCLE&lt;/code&gt;), więc graf zależności jest DAG-iem.&lt;br&gt;• Ponowne wejście w ten sam slot w tym samym tasku → &lt;code&gt;ERR_DEV_REENTRY&lt;/code&gt;.&lt;br&gt;• Eventy z opa są wstrzymane do zdjęcia wszystkich locków w &lt;code&gt;call_outermost()&lt;/code&gt;." vertex="1">
          <mxGeometry height="160" width="640" x="680" y="290" as="geometry" />
        </mxCell>

        <mxCell id="se1" edge="1" parent="1" source="s-task1" target="s-slot2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="równolegle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" edge="1" parent="1" source="s-task2" target="s-slot7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="równolegle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" edge="1" parent="1" source="s-task3" target="s-slot1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="NOLOCK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" edge="1" parent="1" source="s-slot7" target="s-slot1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="U → D">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE B: Resource ownership & LIFO cleanup -->
        <mxCell id="p2-lane-b" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fff8f0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="B. Własność zasobów i automatyczne zwalnianie (sys_device_res_add + sys_device_caller)" vertex="1">
          <mxGeometry height="555" width="1340" x="20" y="510" as="geometry" />
        </mxCell>

        <mxCell id="r-pca" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&lt;b&gt;PCA9685 (id = 5)&lt;/b&gt;&lt;br&gt;&lt;code&gt;create()&lt;/code&gt; → &lt;code&gt;self() = 5&lt;/code&gt; (nowy &lt;code&gt;gen&lt;/code&gt;)&lt;hr&gt;Lista zasobów &lt;code&gt;s_slots[5].res&lt;/code&gt; (LIFO):&lt;br&gt;1. &lt;code&gt;c-&amp;gt;i2c&lt;/code&gt; (&lt;code&gt;sys_i2c_dev_attach&lt;/code&gt;)&lt;br&gt;2. &lt;code&gt;c-&amp;gt;oe&lt;/code&gt; (&lt;code&gt;sys_io_claim_output&lt;/code&gt;, &lt;code&gt;keep=true&lt;/code&gt;)&lt;br&gt;&lt;i&gt;(rejestrowane w &lt;code&gt;res&lt;/code&gt; przed zajęciem;&lt;br&gt;inne drivery też: &lt;code&gt;sys_device_timer&lt;/code&gt;,&lt;br&gt;subskrypcja zdarzeń pinu)&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="250" x="40" y="575" as="geometry" />
        </mxCell>
        <mxCell id="r-claim" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" value="&lt;b&gt;Wzorzec &lt;code&gt;sys_io_claim_*&lt;/code&gt;&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;sys_device_use&lt;/code&gt; + &lt;code&gt;res_add&lt;/code&gt; (zanim zajmie!)&lt;br&gt;2. &lt;code&gt;prepare&lt;/code&gt; → &lt;code&gt;LEVEL&lt;/code&gt; / &lt;code&gt;subscribe&lt;/code&gt; / &lt;code&gt;INTR&lt;/code&gt; → &lt;code&gt;OP_LOCK&lt;/code&gt;&lt;br&gt;3. Później sterownik woła &lt;code&gt;sys_io_claim_drive()&lt;/code&gt; z wnętrza własnego opa (&lt;code&gt;caller() == 5&lt;/code&gt;)" vertex="1">
          <mxGeometry height="170" width="250" x="40" y="800" as="geometry" />
        </mxCell>
        <mxCell id="r-i2c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Szyna I2C (id = 1)&lt;/b&gt;&lt;br&gt;&lt;code&gt;ATTACH(0x40)&lt;/code&gt; widzi: &lt;code&gt;caller() == 5&lt;/code&gt;&lt;br&gt;→ &lt;code&gt;c-&amp;gt;owner[0x40] = 5&lt;/code&gt;&lt;hr&gt;&lt;code&gt;XFER&lt;/code&gt; / &lt;code&gt;DETACH&lt;/code&gt; (&lt;code&gt;LOCAL&lt;/code&gt;) przechodzą&lt;br&gt;tylko gdy &lt;code&gt;caller() == 5&lt;/code&gt;&lt;br&gt;(&lt;i&gt;inaczej &lt;code&gt;ERR_I2C_NOT_OWNER&lt;/code&gt;&lt;/i&gt;)" vertex="1">
          <mxGeometry height="145" width="275" x="345" y="555" as="geometry" />
        </mxCell>
        <mxCell id="r-gpio" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;ESP32-S3 GPIO (id = 0)&lt;/b&gt;&lt;br&gt;&lt;code&gt;LOCK(pin)&lt;/code&gt; widzi: &lt;code&gt;caller() == 5&lt;/code&gt;&lt;br&gt;→ &lt;code&gt;pins.owner[pin] = 5&lt;/code&gt;&lt;hr&gt;&lt;code&gt;LEVEL/MODE/INTR/UNLOCK&lt;/code&gt; OK dla &lt;code&gt;caller()==5&lt;/code&gt;&lt;br&gt;&lt;i&gt;Piny SoC (flash, PSRAM, USB):&lt;br&gt;&lt;code&gt;locked=1&lt;/code&gt;, &lt;code&gt;owner=NONE (0xFF)&lt;/code&gt; → nikt nie zapisze!&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="275" x="345" y="725" as="geometry" />
        </mxCell>

        <mxCell id="r-intruder" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;Obce wywołanie:&lt;/b&gt; APP / prywatny task sterownika (&lt;code&gt;caller=NONE&lt;/code&gt;) lub inny sterownik (&lt;code&gt;caller=8&lt;/code&gt;)&lt;hr&gt;• &lt;code&gt;IO_LEVEL&lt;/code&gt; / &lt;code&gt;IO_LOCK&lt;/code&gt; na OE → &lt;b&gt;&lt;code&gt;ERR_DEV_PIN_LOCKED{owner=5}&lt;/code&gt;&lt;/b&gt; (dla pinu SoC: &lt;code&gt;owner=NONE&lt;/code&gt;, też odrzucone)&lt;br&gt;• &lt;code&gt;IO_UNLOCK&lt;/code&gt; z obcym &lt;code&gt;caller()&lt;/code&gt; → &lt;b&gt;&lt;code&gt;ERR_DEV_PIN_NOT_OWNED{owner=5}&lt;/code&gt;&lt;/b&gt;&lt;br&gt;• &lt;code&gt;I2C_RAW&lt;/code&gt; na zajętym &lt;code&gt;0x40&lt;/code&gt; → &lt;b&gt;&lt;code&gt;ERR_I2C_ADDR_TAKEN{owner=5}&lt;/code&gt;&lt;/b&gt;&lt;br&gt;• &lt;code&gt;I2C_XFER&lt;/code&gt; / &lt;code&gt;I2C_DETACH&lt;/code&gt; z obcym &lt;code&gt;caller()&lt;/code&gt; → &lt;b&gt;&lt;code&gt;ERR_I2C_NOT_OWNER{bus, addr, owner=5}&lt;/code&gt;&lt;/b&gt;&lt;br&gt;• &lt;code&gt;ATTACH / DETACH / LOCK / UNLOCK / XFER&lt;/code&gt; z routera lub remote → &lt;b&gt;&lt;code&gt;ERR_DEV_LOCAL_OP&lt;/code&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="175" width="660" x="680" y="555" as="geometry" />
        </mxCell>
        <mxCell id="r-remove" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;&lt;code&gt;REMOVE(5)&lt;/code&gt; lub nieudane &lt;code&gt;create(5)&lt;/code&gt;:&lt;/b&gt;&lt;br&gt;0. przy &lt;code&gt;REMOVE&lt;/code&gt;: &lt;code&gt;begin_remove(5)&lt;/code&gt; (atomowo &lt;code&gt;used_by==0&lt;/code&gt; + &lt;code&gt;removing=1&lt;/code&gt;, inaczej &lt;code&gt;ERR_DEV_IN_USE&lt;/code&gt;) + &lt;code&gt;drain(5)&lt;/code&gt; (czeka aż &lt;code&gt;in_flight==0&lt;/code&gt;)&lt;br&gt;1. przy &lt;code&gt;REMOVE&lt;/code&gt; (jeśli aktywne): &lt;code&gt;suspend(5)&lt;/code&gt; (&lt;code&gt;self()=5&lt;/code&gt;, ustawia OE=1, usypia chip; nieudane &lt;code&gt;create&lt;/code&gt; pomija ten krok)&lt;br&gt;2. &lt;code&gt;release_resources(5)&lt;/code&gt; w kolejności &lt;b&gt;LIFO&lt;/b&gt; (ostatni dodany pierwszy; wszystko, co zdążono zająć):&lt;br&gt;&amp;nbsp;&amp;nbsp;• zwalnia pin OE (&lt;code&gt;unsubscribe&lt;/code&gt; jeśli było, &lt;code&gt;OP_UNLOCK&lt;/code&gt; widzi &lt;code&gt;caller()=5&lt;/code&gt; → OK, &lt;code&gt;sys_io_release&lt;/code&gt; pominięte przez &lt;code&gt;keep=true&lt;/code&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;• zwalnia adres I2C (&lt;code&gt;DETACH&lt;/code&gt; widzi &lt;code&gt;caller()=5&lt;/code&gt; → OK); w innych driverach także stop &lt;code&gt;sys_device_timer&lt;/code&gt;&lt;br&gt;3. &lt;code&gt;sys_device_slot_uninstall(5)&lt;/code&gt; (czyści &lt;code&gt;uses/used_by&lt;/code&gt;) + &lt;code&gt;free(instance)&lt;/code&gt;. Brak ręcznego &lt;code&gt;uninstall()&lt;/code&gt; w sterownikach." vertex="1">
          <mxGeometry height="285" width="660" x="680" y="755" as="geometry" />
        </mxCell>

        <mxCell id="re1" edge="1" parent="1" source="r-pca" target="r-i2c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" value="use + ATTACH">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" edge="1" parent="1" source="r-pca" target="r-gpio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" value="use + LOCK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" edge="1" parent="1" source="r-intruder" target="r-i2c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;dashed=1;exitX=0;exitY=0.4;entryX=1;entryY=0.5;" value="odmowa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" edge="1" parent="1" source="r-intruder" target="r-gpio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07A5F;dashed=1;exitX=0;exitY=0.88;entryX=1;entryY=0.25;" value="odmowa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE C: Safe state sweep -->
        <mxCell id="p2-lane-c" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;dashed=1;fillColor=#fffdf0;strokeColor=#36393d;fontColor=#393C56;fontStyle=1;" value="C. Bramka safe state podczas sys_device_sweep(SUSPEND)" vertex="1">
          <mxGeometry height="545" width="1340" x="20" y="1085" as="geometry" />
        </mxCell>

        <mxCell id="g-order" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2CC8F;strokeColor=#E07A5F;fontColor=#000000;" value="&lt;b&gt;1. Kolejność topologiczna (&lt;code&gt;sweep_order&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;• &lt;code&gt;SUSPEND / RESET / REMOVE&lt;/code&gt;: user przed depem:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;Silnik → Mostek → PCA9685 → I2C / GPIO&lt;/code&gt;&lt;br&gt;• &lt;code&gt;RESUME&lt;/code&gt;: odwrotnie (dep przed userem)&lt;br&gt;&lt;i&gt;&lt;code&gt;REMOVE&lt;/code&gt; pomija systemowe; &lt;code&gt;RESET&lt;/code&gt; pomija typy bez &lt;code&gt;OP_RESET&lt;/code&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="450" x="40" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="g-gate" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;2. Aktywna bramka: &lt;code&gt;s_safe_gate &amp;gt; 0&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;code&gt;gated() = (s_safe_gate != 0 &amp;amp;&amp;amp; sys_device_caller() == NONE)&lt;/code&gt;&lt;br&gt;• zapis z zewnątrz (&lt;code&gt;APP&lt;/code&gt;, &lt;code&gt;VM&lt;/code&gt;, &lt;code&gt;deliver&lt;/code&gt; bez &lt;code&gt;ALWAYS&lt;/code&gt;, &lt;code&gt;CREATE&lt;/code&gt; / &lt;code&gt;CREATE_REMOTE&lt;/code&gt;): &lt;code&gt;s_frame-&amp;gt;up == NULL&lt;/code&gt; → &lt;b&gt;odrzucone (&lt;code&gt;ERR_DEV_SUSPENDED&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;• timer &lt;code&gt;sys_device_step()&lt;/code&gt;: wykrywa &lt;code&gt;gated()&lt;/code&gt; po &lt;code&gt;try_lock&lt;/code&gt; → &lt;b&gt;cicho pominięty (&lt;code&gt;return NULL&lt;/code&gt;, bez błędu)&lt;/b&gt;&lt;br&gt;• opy &lt;code&gt;SUSPEND&lt;/code&gt; / rejestru (&lt;code&gt;own != NULL&lt;/code&gt;), &lt;code&gt;READ&lt;/code&gt; oraz &lt;code&gt;SYS_DEVICE_OP_ALWAYS&lt;/code&gt; → &lt;b&gt;przechodzą&lt;/b&gt;&lt;br&gt;• hook &lt;code&gt;suspend(A)&lt;/code&gt; woła zależność &lt;code&gt;D&lt;/code&gt;: w &lt;code&gt;D&lt;/code&gt; jest &lt;code&gt;s_frame-&amp;gt;up-&amp;gt;id == A&lt;/code&gt; (&lt;code&gt;gated() == false&lt;/code&gt;) → &lt;b&gt;przechodzi!&lt;/b&gt;" vertex="1">
          <mxGeometry height="180" width="810" x="530" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="g-policy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" value="&lt;b&gt;3. Task policy (&lt;code&gt;sys_device_policy&lt;/code&gt;, priorytet 14)&lt;/b&gt;&lt;br&gt;&lt;code&gt;sys_device_policy_handle()&lt;/code&gt; filtruje łańcuch wg &lt;code&gt;importance&lt;/code&gt; (zatrzymuje na &lt;code&gt;NONE&lt;/code&gt;) i wrzuca &lt;code&gt;err_record&lt;/code&gt; do &lt;code&gt;sys_device_policy_ring&lt;/code&gt; (ignoruje własny task i &lt;code&gt;ERR_DEV_FAULT_RESPONSE&lt;/code&gt;). Task woła &lt;code&gt;vm_stop&lt;/code&gt;, &lt;code&gt;sys_device_sweep(SUSPEND)&lt;/code&gt; z zewnątrz (bez locków slotów!) oraz akcję slotu." vertex="1">
          <mxGeometry height="135" width="450" x="40" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="g-events" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontColor=#000000;" value="&lt;b&gt;4. Event na koniec sweepa&lt;/b&gt;&lt;br&gt;&lt;code&gt;how-&amp;gt;sweep&lt;/code&gt; tłumi eventy &lt;code&gt;SUSPENDED / RESUMED / RESET&lt;/code&gt; per urządzenie; po ostatnim urządzeniu i zdjęciu &lt;code&gt;s_safe_gate&lt;/code&gt; idzie jeden event ze źródłem &lt;code&gt;NONE&lt;/code&gt; (&lt;code&gt;SYS_DEVICE_ID_NONE&lt;/code&gt;), natomiast &lt;code&gt;CREATED&lt;/code&gt; i &lt;code&gt;REMOVED&lt;/code&gt; idą zawsze per urządzenie (wewnątrz wspólnego &lt;code&gt;hold&lt;/code&gt; zwalnianego na końcu sweepa)." vertex="1">
          <mxGeometry height="100" width="1300" x="40" y="1445" as="geometry" />
        </mxCell>
        <mxCell id="g-legend" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;" value="&lt;b&gt;Legenda kolorów:&lt;/b&gt; &amp;nbsp; &lt;span style='background:#dae8fc;border:1px solid #6c8ebf;padding:1px 6px'&gt;Wywołujący / task&lt;/span&gt; &amp;nbsp; &lt;span style='background:#F2CC8F;border:1px solid #E07A5F;padding:1px 6px'&gt;Warstwa wywołania / zależność&lt;/span&gt; &amp;nbsp; &lt;span style='background:#e1d5e7;border:1px solid #9673a6;padding:1px 6px'&gt;TLS / cykl życia / policy&lt;/span&gt; &amp;nbsp; &lt;span style='background:#cdeb8b;border:1px solid #36393d;padding:1px 6px'&gt;Slot / sterownik&lt;/span&gt; &amp;nbsp; &lt;span style='background:#ffcccc;border:1px solid #36393d;padding:1px 6px'&gt;Bramka / blokada / błąd&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1300" x="40" y="1565" as="geometry" />
        </mxCell>

        <mxCell id="ge1" edge="1" parent="1" source="g-order" target="g-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge2" edge="1" parent="1" source="g-policy" target="g-order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" value="uruchamia sweep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
