            10,
            11,
            12,
            13,
            14,
            15
          ]
        }
      ],
      "alias": "Reset output",
      "description": "Set one PWM output duty to zero.",
      "packet_definition": {
        "source_file": "dec_sys_contracts.h",
        "section": "IO Control Packet decoders (0x20 - 0x2F)",
        "class_name": "SYS_CONTRACTS",
        "class_header": "0x01",
        "packet_header": "0x20",
        "decoder": "decoder_packet_sys_io_reset_t()",
        "field_order": [
          "device_id",
          "pin"
        ],
        "fields": {
          "device_id": {
            "type": "uint8_t",
            "alias": "Device ID",
            "required": true
          },
          "pin": {
            "type": "uint8_t",
            "alias": "Pin Number",
            "required": true
          }
        }
      }
    },
