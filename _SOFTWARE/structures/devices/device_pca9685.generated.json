            11,
            12,
            13,
            14,
            15
          ]
        },
        {
          "name": "level",
          "alias": "Output Level",
          "type": "bool"
        }
      ],
      "alias": "Set output level",
      "description": "Map a logical level to off or full PWM duty.",
      "packet_definition": {
        "source_file": "dec_sys_contracts.h",
        "section": "IO Control Packet decoders (0x20 - 0x2F)",
        "class_name": "SYS_CONTRACTS",
