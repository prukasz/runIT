    {
      "packet": "packet_sys_vreg_add_callback_t",
      "parameters": [
        {
          "name": "device_id",
          "alias": "Device ID",
          "instance": true
        },
        {
          "name": "on_event",
          "one_of": [
            {
              "symbol": "SYS_PWR_EVENT_OCP_CRITICAL",
