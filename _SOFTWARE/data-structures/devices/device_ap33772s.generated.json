            },
            {
              "symbol": "SYS_PWR_EVENT_OCP_WARNING",
              "enum": "sys_power_events_e",
              "value": 4,
              "alias": "Over-Current Warning",
              "description": "Current draw is approaching the limit - not cut off yet, just a heads-up"
