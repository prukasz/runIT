{
  "$schema": "data-structures/schema/device-definition.schema.json",
  "schemaVersion": 1,
  "kind": "device-definition",
  "id": "device_ap33772s",
  "version": "1.0.0",
  "title": "AP33772S USB-C PD sink",
  "description": "USB-C Power Delivery sink controller that negotiates voltage/current from a charger and can also act as a regulated, monitored output.",
  "protocols": [
    "i2c"
  ],
  "tags": [
    "i2c",
    "usb-c",
    "power-delivery",
    "power",
    "voltage",
    "current"
  ],
  "source_file": "dec_device_ap33772s.h",
  "contractProvider": {
    "symbol": "SYS_DEVICE_CONTRACT_POWER_USB_PD",
    "enum": "sys_device_contract_type_e",
    "value": 3,
    "alias": "USB-C Power Delivery",
    "description": "Negotiates power (voltage/current) from a USB-C charger"
  },
  "install": {
    "packet": "packet_sys_device_install_ap33772s_t",
    "packet_definition": {
      "source_file": "dec_device_ap33772s.h",
      "class_name": "SYS_CONTRACTS",
      "class_header": "0x01",
      "packet_header": "0x45",
      "decoder": "decoder_packet_sys_device_install_ap33772s_t()",
      "field_order": [
        "device_id",
        "i2c_bus",
        "i2c_addr",
        "intr_pin_device_id",
        "intr_pin_pin",
        "intr_pin_mode"
      ],
      "fields": {
        "device_id": {
          "type": "uint8_t",
          "required": true,
          "min": 0,
          "max": 127
        },
        "i2c_bus": {
          "type": "uint8_t",
          "required": true,
          "min": 0,
          "max": 1
        },
        "i2c_addr": {
          "type": "uint8_t",
          "required": true,
          "default": 82,
          "note": "AP33772S has a fixed datasheet address (AP33772S_ADDRESS); the field is honored (adapter_ap33772s.c overwrites the driver handle's address with it) but the real chip only answers at 0x52"
        },
        "intr_pin_device_id": {
          "type": "uint8_t",
          "group": "interrupt-pin",
          "role": "device_id"
        },
        "intr_pin_pin": {
          "type": "uint8_t",
          "sentinel": 255,
          "group": "interrupt-pin",
          "role": "pin"
        },
        "intr_pin_mode": {
          "type": "uint8_t",
          "ref": "sys_io_mode_e",
          "group": "interrupt-pin",
          "role": "mode"
        }
      },
      "groups": {
        "interrupt-pin": {
          "fields": [
            "intr_pin_device_id",
            "intr_pin_pin",
            "intr_pin_mode"
          ],
          "sentinel_field": "intr_pin_pin"
        }
      }
    }
  },
