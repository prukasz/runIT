{
  "schemaVersion": 2,
  "kind": "device-definition",
  "id": "device_servo",
  "alias": "Servo",
  "description": "Hobby servo on a PWM pin of another device: an angle servo moves to an angle, a continuous (360 degree) servo runs at a speed from -100 to 100. Pulse limits, trim, direction and the position it takes at start-up are set here.",
  "protocols": [
    "pwm"
  ],
  "source_file": "components/devices/device_servo/device_servo.h",
  "type": {
    "symbol": "SYS_DEVICE_TYPE_SERVO",
    "id": 72
  },
  "tags": [
    "servo",
    "pwm",
    "motion"
  ],
  "create": {
    "frame": [
      "key 0x05",
      "device id (u16)",
      "op 0x0000 (CREATE)",
      "type (u16)",
      "the fields below, in order"
    ],
    "struct": "servo_cfg_t",
    "size": 18,
    "source_file": "components/devices/device_servo/device_servo.h",
    "fields": [
      {
        "name": "pwm_pin",
        "offset": 0,
        "type": "struct",
        "struct": "sys_io_pin_t",
        "fields": [
          {
            "name": "device",
            "offset": 0,
            "type": "u16",
            "size": 2,
            "alias": "Device",
            "description": "The device the pin is on",
            "id_kind": "device",
            "any_value": 65535
          },
          {
            "name": "pin",
            "offset": 2,
            "type": "u8",
            "size": 1,
            "alias": "Pin",
            "description": "The pin of that device",
            "id_kind": "pin",
            "device_field": "device"
          }
        ],
        "size": 3,
        "alias": "PWM pin",
        "description": "Any pin that can output PWM; the servo is driven through the IO contract",
        "required": true,
        "pin_ref": true,
        "default_mode": 6
      },
      {
        "name": "servo_type",
        "offset": 3,
        "type": "u8",
        "size": 1,
        "alias": "Servo type",
        "description": "An angle servo moves to a position, a continuous one turns at a speed",
        "default": {
          "symbol": "SERVO_TYPE_ANGLE",
          "enum": "servo_type_e",
          "value": 0,
          "alias": "Angle servo"
        },
        "enum_ref": "servo_type_e"
      },
      {
        "name": "byte_mode",
        "offset": 4,
        "type": "u8",
        "size": 1,
        "alias": "Byte steering",
        "description": "Steer with one byte: 0 to 255 is the whole range",
        "default": 0,
        "choices": [
          {
            "value": 0,
            "alias": "Off"
          },
          {
            "value": 1,
            "alias": "On"
          }
        ]
      },
      {
        "name": "invert",
        "offset": 5,
        "type": "u8",
        "size": 1,
        "alias": "Reverse direction",
        "description": "Mirrors the movement, for a servo mounted the other way round",
        "default": 0,
        "choices": [
          {
            "value": 0,
            "alias": "Off"
          },
          {
            "value": 1,
            "alias": "On"
          }
        ]
      },
      {
        "name": "angle_min_deg",
        "offset": 6,
        "type": "i16",
        "size": 2,
        "alias": "Angle at min pulse",
        "description": "Angle servo only",
        "min": -360,
        "max": 360,
        "default": 0,
        "unit": "deg"
      },
      {
        "name": "angle_max_deg",
        "offset": 8,
        "type": "i16",
        "size": 2,
        "alias": "Angle at max pulse",
        "description": "Angle servo only; above the minimum",
        "min": -360,
        "max": 360,
        "default": 180,
        "unit": "deg"
      },
      {
        "name": "default_pos",
        "offset": 10,
        "type": "i16",
        "size": 2,
        "alias": "Default position",
        "description": "Where the servo goes at create and on Home: degrees (angle) or percent (continuous)",
        "min": -360,
        "max": 360,
        "default": 90
      },
      {
        "name": "min_us",
        "offset": 12,
        "type": "u16",
        "size": 2,
        "alias": "Min pulse",
        "description": "The lowest pulse ever sent (500 and 1000 are common)",
        "min": 400,
        "max": 2600,
        "default": 500,
        "unit": "us"
      },
      {
        "name": "max_us",
        "offset": 14,
        "type": "u16",
        "size": 2,
        "alias": "Max pulse",
        "description": "The highest pulse ever sent (2000 and 2500 are common)",
        "min": 400,
        "max": 2600,
        "default": 2500,
        "unit": "us"
      },
      {
        "name": "deadband_us",
        "offset": 16,
        "type": "u16",
        "size": 2,
        "alias": "Deadband",
        "description": "Continuous servo: the pulse width around stop in which it does not move",
        "min": 0,
        "max": 200,
        "default": 0,
        "unit": "us"
      }
    ]
  },
  "contracts": [
    {
      "contract": "DEVICE",
      "id": 0,
      "alias": "Device",
      "ops": [
        {
          "name": "RESET",
          "symbol": "SYS_DEVICE_OP_RESET",
          "id": 1,
          "alias": "Reset",
          "description": "Puts the device's outputs off and its settings back to defaults."
        },
        {
          "name": "SUSPEND",
          "symbol": "SYS_DEVICE_OP_SUSPEND",
          "id": 2,
          "alias": "Suspend",
          "description": "Makes the outputs safe; the device refuses writes until it is resumed."
        },
        {
          "name": "RESUME",
          "symbol": "SYS_DEVICE_OP_RESUME",
          "id": 3,
          "alias": "Resume",
          "description": "Lets a suspended device work again."
        }
      ]
    }
  ],
  "own_ops": [
    {
      "symbol": "SERVO_OP_HOME",
      "id": 65280,
      "alias": "Home",
      "description": "Moves the servo to its default position (plus the trim)"
    },
    {
      "symbol": "SERVO_OP_SET_TRIM",
      "id": 65281,
      "alias": "Set trim",
      "description": "A correction added to every move",
      "args": {
        "struct": "servo_trim_t",
        "source_file": "components/devices/device_servo/device_servo.h",
        "size": 2,
        "fields": [
          {
            "name": "trim",
            "offset": 0,
            "type": "i16",
            "size": 2,
            "alias": "Trim",
            "description": "Added to every target: degrees for an angle servo, microseconds for a continuous one",
            "min": -500,
            "max": 500
          }
        ]
      }
    },
    {
      "symbol": "SERVO_OP_SET",
      "id": 65282,
      "alias": "Move",
      "description": "Moves the servo to a position",
      "args": {
        "struct": "servo_set_t",
        "source_file": "components/devices/device_servo/device_servo.h",
        "size": 2,
        "fields": [
          {
            "name": "value_x10",
            "offset": 0,
            "type": "i16",
            "size": 2,
            "alias": "Position",
            "description": "In tenths: 905 is 90.5 degrees or -250 is -25 percent; in byte mode the byte times ten"
          }
        ]
      }
    },
    {
      "symbol": "SERVO_OP_GET_PULSE",
      "id": 65283,
      "alias": "Read pulse",
      "description": "The pulse last sent; 0 when the servo is not driven",
      "returns": {
        "type": "u16",
        "alias": "Pulse",
        "unit": "us"
      }
    },
    {
      "symbol": "SERVO_OP_RELEASE",
      "id": 65284,
      "alias": "Release",
      "description": "Stops the pulse so the servo goes limp; the next move drives it again"
    }
  ],
  "values": {
    "POSITION": [
      {
        "title": "Byte",
        "when": [
          {
            "field": "byte_mode",
            "value": 1
          }
        ],
        "range": {
          "min": 0,
          "max": 255
        }
      },
      {
        "title": "Speed",
        "when": [
          {
            "field": "servo_type",
            "value": 1
          }
        ],
        "unit": "%",
        "range": {
          "min": -100,
          "max": 100
        }
      },
      {
        "title": "Angle",
        "when": [
          {
            "field": "servo_type",
            "value": 0
          }
        ],
        "unit": "deg",
        "range": {
          "min": {
            "field": "angle_min_deg"
          },
          "max": {
            "field": "angle_max_deg"
          }
        }
      }
    ]
  },
  "guide": "device_servo.md"
}
