{
  "$schema": "../../templates/board.schema.json",
  "schemaVersion": 3,
  "kind": "board",
  "name": "runIT",
  "revision": 1,
  "description": "runIT controller board (rev 1): ESP32-S3 MCU, 2x TPS55289 buck-boost rails, 2x DRV8962 motor drivers, PCA9685 PWM expander, TCA6424A GPIO expander, ADS7128 8-channel 20V ADC, INA3221 power monitor, AP33772S USB-PD sink, DAC53202 current reference.",
  "source_files": [
    "components/app/runit/runit_board_defs.h",
    "components/app/runit/runit_board_cfg.c",
    ".claude/skills/runit-root/HARDWARE.md"
  ],
  "i2c_buses": [
    {
      "bus": 0,
      "name": "internal",
      "sda_pin": {
        "device": 0,
        "pin": 15
      },
      "scl_pin": {
        "device": 0,
        "pin": 16
      },
      "frequency_hz": 400000,
      "description": "Internal I2C bus for all onboard chips"
    },
    {
      "bus": 1,
      "name": "user",
      "sda_pin": {
        "device": 0,
        "pin": 40
      },
      "scl_pin": {
        "device": 0,
        "pin": 41
      },
      "frequency_hz": 400000,
      "description": "External user I2C bus for sensors and breakouts"
    }
  ],
  "power": {
    "limits": {
      "max_mV": 20000,
      "max_mA": 5500,
      "reserve_mW": 3667,
      "unknown_source_mA": 1000,
      "vreg_efficiency_pct": 90
    },
    "sources": {
      "usb_pd": {
        "device": 13,
        "descriptor": "device_ap33772s",
        "ok_pin": {
          "device": 1,
          "pin": 3
        },
        "description": "USB-C PD 3.0 sink up to 20V/5A, eFuse power good on TCA pin 3 (VUSB_OK)"
      },
      "external": {
        "ok_pin": {
          "device": 1,
          "pin": 4
        },
        "description": "External input 5-20V via XT60, eFuse power good on TCA pin 4 (VEXT_OK)"
      }
    },
    "rails": [
      {
        "id": "rail_a",
        "name": "Rail A",
        "vreg_device": 10,
        "monitor": {
          "device": 12,
          "channel": 2
        },
        "min_mA": 200,
        "mV_min": 4500,
        "mV_max": 20000,
        "description": "Adjustable buck-boost regulator TPS55289 at 0x74, monitored by INA3221 CH 2"
      },
      {
        "id": "rail_b",
        "name": "Rail B",
        "vreg_device": 11,
        "monitor": {
          "device": 12,
          "channel": 0
        },
        "min_mA": 200,
        "mV_min": 4500,
        "mV_max": 20000,
        "description": "Adjustable buck-boost regulator TPS55289 at 0x75, monitored by INA3221 CH 0"
      }
    ],
    "input_monitor": {
      "device": 12,
      "channel": 1,
      "description": "Whole-board input voltage and current monitored by INA3221 CH 1"
    },
    "muxes": [
      {
        "id": "mux_drv1",
        "device": 7,
        "symbol": "DEVICE_ID_SUPPLY_DRV8962_0",
        "target_device": 5,
        "source_a": "input",
        "source_b": "rail_b",
        "en_a_pin": {
          "device": 1,
          "pin": 14
        },
        "en_b_pin": {
          "device": 1,
          "pin": 15
        },
        "active_level": 1,
        "switch_delay_ms": 5,
        "description": "LM73100 pair for DRV8962 #1: A = board input, B = Rail B"
      },
      {
        "id": "mux_drv2",
        "device": 8,
        "symbol": "DEVICE_ID_SUPPLY_DRV8962_1",
        "target_device": 6,
        "source_a": "input",
        "source_b": "rail_a",
        "en_a_pin": {
          "device": 1,
          "pin": 12
        },
        "en_b_pin": {
          "device": 1,
          "pin": 13
        },
        "active_level": 1,
        "switch_delay_ms": 5,
        "description": "LM73100 pair for DRV8962 #2: A = board input, B = Rail A"
      }
    ],
    "responses": {
      "ovp": "disable",
      "uvp": "notify",
      "spc": "disable",
      "ocp_warning": "notify",
      "ocp_critical": "notify",
      "otp": "safe_state",
      "battery_low": "notify",
      "battery_critical": "safe_state",
      "budget_exceeded": "disable",
      "source_changed": "notify"
    }
