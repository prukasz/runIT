{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-structures/schema/vm-blocks.schema.json",
  "title": "runIT VM block catalog",
  "type": "object",
  "required": ["$schema", "schemaVersion", "kind", "enums", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "data-structures/schema/vm-blocks.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "vm-blocks" },
    "enums": { "type": "string" },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": ["index", "name", "title"],
      "additionalProperties": false,
      "properties": {
        "index": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "*" }] },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "c_type", "offset"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "c_type": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1 },
        "element_size": { "type": "integer", "minimum": 1 },
        "array_len": { "type": "integer", "minimum": 1 },
        "flexible": { "const": true },
        "description": { "type": "string" },
        "enum_ref": { "type": "string" },
        "runtime": { "const": true },
        "padding": { "const": true }
      }
    },
    "state": {
      "type": "object",
      "required": ["struct", "source_file", "size", "align", "fields"],
      "additionalProperties": false,
      "properties": {
        "struct": { "type": "string" },
        "source_file": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "align": { "type": "integer", "minimum": 1 },
        "tail": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "name", "title", "category", "description", "source_file", "min_inputs", "min_outputs", "inputs", "outputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 255 },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "source_file": { "type": "string" },
        "min_inputs": { "type": "integer", "minimum": 0 },
        "min_outputs": { "type": "integer", "minimum": 0 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
        "state": { "$ref": "#/$defs/state" }
      }
    }
  }
}
