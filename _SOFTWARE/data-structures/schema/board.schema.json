{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-structures/schema/board.schema.json",
  "title": "runIT board catalog",
  "description": "Onboard devices with their fixed device IDs (//@STATIC_DEVICE in runit_board_defs.h) and drivers (RUNIT_BOARD_DEVICE in runit_board_cfg.c).",
  "type": "object",
  "required": ["$schema", "schemaVersion", "kind", "source_files", "i2c_buses", "devices", "pin_setup", "reserved_pins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "data-structures/schema/board.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "board" },
    "source_files": { "type": "array", "items": { "type": "string" } },
    "i2c_buses": {
      "type": "object",
      "description": "SYS_I2C_BUS_* in runit_board_defs.h: the board's own devices sit on `internal`, user devices go on `user`.",
      "required": ["internal", "user"],
      "additionalProperties": false,
      "properties": { "internal": { "type": "integer" }, "user": { "type": "integer" } }
    },
    "pin_setup": {
      "type": "array",
      "description": "Pins the board configures itself at boot (sys_io_set_mode / sys_io_set_level in runit_board_devices_init).",
      "items": {
        "type": "object",
        "required": ["device", "pin", "mode", "installed"],
        "additionalProperties": false,
        "properties": {
          "device": { "type": "integer" },
          "pin": { "type": "integer" },
          "mode": { "type": "string", "pattern": "^SYS_IO_MODE_\\w+$" },
          "level": { "type": "boolean" },
          "installed": { "type": "boolean", "description": "false when its bring-up switch is off." },
          "label": { "type": "string" }
        }
      }
    },
    "reserved_pins": {
      "type": "array",
      "description": "ESP pins the board uses outside sys_io (SYS_PIN_* in runit_board_defs.h: I2C buses …); never free for devices or settings.",
      "items": {
        "type": "object",
        "required": ["device", "pin", "label"],
        "additionalProperties": false,
        "properties": { "device": { "type": "integer" }, "pin": { "type": "integer" }, "label": { "type": "string" } }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "symbol", "name", "installed"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 255 },
          "symbol": { "type": "string", "pattern": "^DEVICE_ID_\\w+$" },
          "name": { "type": "string", "description": "Symbol without DEVICE_ID_, e.g. TPS55289_0." },
          "driver": { "type": "string", "description": "d_<driver>_create() that installs it; absent when the board doesn't create it at boot." },
          "descriptor": { "type": "string", "description": "id of the device descriptor in data-structures/devices/." },
          "title": { "type": "string", "description": "Title of that descriptor." },
          "installed": { "type": "boolean", "description": "The board installs it at boot (its RUNIT_BOARD_DEV_* bring-up switch is on)." },
          "i2c": {
            "type": "object",
            "required": ["bus", "address"],
            "additionalProperties": false,
            "properties": { "bus": { "type": "integer" }, "address": { "type": "integer" } }
          },
          "pins": {
            "type": "array",
            "description": "Pins this device takes on other devices (SYS_IO_PIN_INIT in its create call).",
            "items": {
              "type": "object",
              "required": ["use", "device", "pin", "mode"],
              "additionalProperties": false,
              "properties": {
                "use": { "type": "string", "description": "Config field, e.g. intr_pin or in_pins[2]." },
                "device": { "type": "integer" },
                "pin": { "type": "integer" },
                "mode": { "type": "string", "pattern": "^SYS_IO_MODE_\\w+$" }
              }
            }
          }
        }
      }
    }
  }
}
