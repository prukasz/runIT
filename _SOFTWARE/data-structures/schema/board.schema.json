{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-structures/schema/board.schema.json",
  "title": "runIT board catalog",
  "description": "Onboard devices with their fixed device IDs (//@STATIC_DEVICE in runit_board_defs.h) and drivers (RUNIT_BOARD_DEVICE in runit_board_cfg.c).",
  "type": "object",
  "required": ["$schema", "schemaVersion", "kind", "source_files", "devices"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "data-structures/schema/board.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "board" },
    "source_files": { "type": "array", "items": { "type": "string" } },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "symbol", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 255 },
          "symbol": { "type": "string", "pattern": "^DEVICE_ID_\\w+$" },
          "name": { "type": "string", "description": "Symbol without DEVICE_ID_, e.g. TPS55289_0." },
          "driver": { "type": "string", "description": "d_<driver>_create() that installs it; absent when the board doesn't create it at boot." },
          "descriptor": { "type": "string", "description": "id of the device descriptor in data-structures/devices/." },
          "title": { "type": "string", "description": "Title of that descriptor." }
        }
      }
    }
  }
}
