  "activation": {
    "kind": "triggered",
    "text": "Runs when the source (the first input) is fresh, or on each pass an enable fires (an open gate, a tick), and the block is enabled. With no source it writes its constant when an enable fires (once at start without enables)."
  },
  "min_enables": 0,
