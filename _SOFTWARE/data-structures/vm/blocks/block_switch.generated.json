  "activation": {
    "kind": "enabled",
    "description": "Runs every pass while enabled."
  },
  "inputs": {
    "min": 1,
    "max": 1,
    "pins": [
      {
        "index": 0,
        "name": "selector",
        "title": "Selector",
        "value": "i32",
        "required": true
      }
    ]
  },
  "outputs": {
    "min": 1,
    "max": 16,
    "max_symbol": "CONFIG_VM_BLOCK_MAX_OUT",
    "pins": [
      {
        "index": "*",
        "name": "branch",
        "title": "Branch",
        "value": "gate",
        "description": "One per case, 0..15."
      }
    ]
  },
  "rules": [],
  "min_custom_len": 0,
  "enums": {}
}
