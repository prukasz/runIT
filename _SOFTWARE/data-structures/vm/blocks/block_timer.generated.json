{
  "$schema": "data-structures/schema/vm-block.schema.json",
  "schemaVersion": 1,
  "kind": "vm-block",
  "id": 9,
  "name": "VM_BLK_TIMER",
  "title": "Timer",
  "category": "time",
  "description": "On-delay, off-delay or pulse timer (plus inverted). ENO is the timer's output Q, held as a level; Elapsed counts in time_base units.",
  "source_file": "components/VM/blocks/vm_block_timer.h",
  "activation": {
    "kind": "enabled",
    "description": "Runs every pass while enabled."
  },
  "inputs": {
    "min": 1,
    "max": 2,
    "pins": [
      {
        "index": 0,
        "name": "in",
        "title": "Start",
        "value": "bool",
        "description": "The signal the timer acts on; the block's enable gates the whole timer.",
        "required": true
      },
      {
        "index": 1,
        "name": "pt",
        "title": "Preset",
        "value": "u32",
        "description": "Overrides pt, in time_base units.",
        "overrides": "pt",
        "required": false,
        "hidden_by_default": true
      }
    ]
  },
  "outputs": {
    "min": 0,
    "max": 1,
    "pins": [
      {
        "index": 0,
        "name": "et",
        "title": "Elapsed time",
        "value": "u32",
        "description": "Time elapsed, in time_base units."
      }
    ]
  },
  "rules": [
    {
      "rule": "mode is a vm_timer_mode_e value and time_base a vm_timer_unit_e value.",
      "error": "ERR_VM_BLK_BAD_SHAPE",
      "error_tag": 43296
    }
  ],
  "eno": {
    "title": "Q",
    "description": "The timer's output level: true after the on-delay, during a pulse, or until the off-delay ends. Put it on another block's Run when to gate that block."
  },
  "header": {
    "lead": [
      {
        "text": "Timer"
      }
    ],
    "value": [
