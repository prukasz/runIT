        "description": "The iterator's first value.",
        "overrides": "k_start",
        "required": false,
        "hidden_by_default": true
      },
      {
        "index": 1,
        "name": "end",
        "title": "End",
        "value": "f32",
        "description": "The value the iterator is compared with.",
        "overrides": "k_end",
        "required": false,
        "hidden_by_default": true
      },
      {
        "index": 2,
