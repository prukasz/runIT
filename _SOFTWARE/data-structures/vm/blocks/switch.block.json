{
  "schemaVersion": 2,
  "kind": "vm-block",
  "id": 4,
  "name": "VM_BLK_SWITCH",
  "alias": "Switch",
  "category": "flow",
  "description": "N-way router: drives the output whose index equals the selector (rounded); out of range drives none.",
  "source_file": "components/vm/vm_blocks/core/switch/vm_block_switch.h",
  "guide": "switch.md",
  "activation": {
    "kind": "enabled",
    "text": "Runs every pass while enabled."
  },
  "min_enables": 0,
  "shape": {
    "min_in": 1,
    "max_in": 1,
    "min_q": 1,
    "max_q": 16,
    "min_en": 0,
    "required_in": 1,
    "state_len": 0
  },
  "inputs": {
    "min": 1,
    "max": 1,
    "pins": [
      {
        "index": 0,
        "name": "selector",
        "alias": "Selector",
        "value": "i32",
        "required": true
      }
    ]
  },
  "outputs": {
    "min": 1,
    "max": 16,
    "max_symbol": "CONFIG_VM_BLOCK_MAX_OUT",
    "pins": [
      {
        "index": "*",
        "name": "branch",
        "alias": "Branch",
        "value": "gate",
        "description": "One per case, 0..15.",
        "required": false
      }
    ]
  }
}
