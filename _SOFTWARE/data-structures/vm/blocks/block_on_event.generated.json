        "description": "Event domain, 255 = any",
        "enum_ref": "sys_event_domain_e",
        "source": "user"
      },
      {
        "name": "device_id",
        "c_type": "uint8_t",
        "offset": 1,
        "size": 1,
        "description": "Source device, 255 = any",
        "source": "user"
      },
      {
        "name": "channel",
        "c_type": "uint8_t",
        "offset": 2,
        "size": 1,
        "description": "Pin / channel, 255 = any",
        "source": "user"
      },
      {
        "name": "event",
        "c_type": "uint8_t",
        "offset": 3,
        "size": 1,
        "description": "Domain event, 255 = any",
        "source": "user"
      }
    ]
  },
  "min_custom_len": 4,
  "enums": {
    "sys_event_domain_e": {
      "alias": "Event Domain",
      "source_file": "components/system/sys_event/include/sys_event.h",
      "members": [
        {
          "name": "SYS_EVENT_DOMAIN_IO",
          "value": 0,
          "alias": "IO",
          "description": "Pin interrupts and analog alerts. Channel = pin, event = the edge or window crossed, value = level or mV"
        },
        {
          "name": "SYS_EVENT_DOMAIN_POWER",
          "value": 1,
          "alias": "Power",
          "description": "Regulator, monitor and board power events. Event = power event; board events use device 255"
        },
        {
          "name": "SYS_EVENT_DOMAIN_HBRIDGE",
          "value": 2,
          "alias": "H-Bridge",
