  "activation": {
    "kind": "enabled",
    "description": "Runs every pass while enabled."
  },
  "inputs": {
    "min": 0,
    "max": 0,
    "pins": []
  },
  "outputs": {
    "min": 0,
    "max": 2,
    "pins": [
      {
        "index": 0,
        "name": "value",
        "title": "Value",
        "value": "i32",
        "description": "The event's value (last match of the pass)."
      },
      {
        "index": 1,
        "name": "count",
        "title": "Count",
        "value": "u32",
        "description": "Matches this pass."
      }
    ]
  },
  "rules": [],
  "state": {
    "struct": "vm_block_on_event_data_t",
