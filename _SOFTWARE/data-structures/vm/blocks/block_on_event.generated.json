        {
          "name": "SYS_EVENT_DOMAIN_BLE",
          "value": 3,
          "alias": "Bluetooth",
          "description": "Connection events. Event = BLE event"
        },
        {
          "name": "SYS_EVENT_DOMAIN_FEATURE",
          "value": 4,
          "alias": "Feature",
          "description": "Events raised by features. Device = feature ID"
        }
      ]
    }
