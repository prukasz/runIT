{
  "schemaVersion": 2,
  "kind": "vm-block",
  "id": 2,
  "name": "VM_BLK_EXPR_BIT",
  "alias": "Bit Expression",
  "category": "data",
  "description": "Evaluates a bitwise formula over its inputs, on whole numbers; the result goes to output 0.",
  "source_file": "components/vm/vm_blocks/core/expr_bit/vm_block_expr_bit.h",
  "guide": "expr_bit.md",
  "activation": {
    "kind": "triggered",
    "text": "Runs when an input it reads is fresh, or on each pass an enable fires (an open gate, a tick), and the block is enabled."
  },
  "min_enables": 0,
  "shape": {
    "min_in": 0,
    "max_in": 16,
    "min_q": 1,
    "max_q": 1,
    "min_en": 0,
    "required_in": 0,
    "state_len": 4
  },
  "inputs": {
    "min": 0,
    "max": 16,
    "max_symbol": "CONFIG_VM_BLOCK_MAX_IN",
    "pins": [
      {
        "index": "*",
        "name": "pin",
        "alias": "Input",
        "value": "u32",
        "description": "Read by the IN opcode; any number, only the ones the code names are read.",
        "hide_when_wired": true,
        "required": false
      }
    ]
  },
  "outputs": {
    "min": 1,
    "max": 1,
    "pins": [
      {
        "index": 0,
        "name": "result",
        "alias": "Result",
        "value": "u32",
        "description": "The expression's value (u32).",
        "required": true
      }
    ]
  },
  "rules": [
    {
      "rule": "constants and code fit custom_len (4 + 4 x const_cnt + code_len bytes).",
      "error": "ERR_VM_EXPR_BAD_CODE",
      "error_tag": 983079
    },
    {
      "rule": "Every opcode is a known value; code after END is ignored.",
      "error": "ERR_VM_EXPR_BAD_CODE",
      "error_tag": 983079
    },
    {
      "rule": "An IN operand names a wired input (below in_cnt); a K operand a constant (below const_cnt).",
      "error": "ERR_VM_EXPR_BAD_CODE",
      "error_tag": 983079
    },
    {
      "rule": "The stack never holds fewer values than an opcode takes, nor more than VM_EXPR_STACK_MAX.",
      "error": "ERR_VM_EXPR_BAD_CODE",
      "error_tag": 983079
    },
    {
      "rule": "The code ends (END or its last byte) with exactly one value on the stack.",
      "error": "ERR_VM_EXPR_BAD_CODE",
      "error_tag": 983079
    }
  ],
  "state": {
    "struct": "vm_expr_code_t",
    "source_file": "components/vm/vm_blocks/core/expr_core/vm_expr_core.h",
    "size": 4,
    "align": 4,
    "fields": [
      {
        "name": "const_cnt",
        "c_type": "uint8_t",
        "offset": 0,
        "size": 1,
        "description": "Number of 4-byte constants after the header",
        "source": "derived",
        "derived": "counted from the compiled formula"
      },
      {
        "name": "rt",
        "c_type": "uint8_t",
        "offset": 1,
        "size": 1,
        "description": "VM_EXPR_RT_* fault latch",
        "source": "runtime"
      },
      {
        "name": "code_len",
        "c_type": "uint16_t",
        "offset": 2,
        "size": 2,
        "description": "Length of the bytecode after the constants",
        "source": "derived",
        "derived": "counted from the compiled formula"
      },
      {
        "name": "consts",
        "c_type": "vm_expr_k_t",
        "offset": 4,
        "flexible": true,
        "element_size": 4,
        "description": "const_cnt constants (f32 for EXPR, u32 for EXPR_BIT), then code_len opcode bytes",
        "source": "derived",
        "derived": "the constants and code the editor compiles from the formula"
      }
    ],
    "tail": "consts u32[const_cnt], code u8[code_len] (opcodes vm_bit_op_e)"
  },
  "min_custom_len": 4,
  "encoding": {
    "kind": "bytecode",
    "layout": "state header, then const_cnt constants of 4 bytes, then code_len code bytes; custom_len = 4 + 4 x const_cnt + code_len",
    "const_count_field": "const_cnt",
    "code_length_field": "code_len",
    "constant_type": "u32",
    "stack_max": 16,
    "opcode_enum": "vm_bit_op_e",
    "opcodes": [
      {
        "symbol": "VM_BIT_END",
        "value": 0,
        "alias": "end",
        "pops": 0,
        "pushes": 0,
        "operand": "none",
        "description": "Stop; the rest of the code is ignored."
      },
      {
        "symbol": "VM_BIT_IN",
        "value": 1,
        "alias": "in",
        "pops": 0,
        "pushes": 1,
        "operand": "input",
        "description": "-> input[operand] (as u32)",
        "format": "{input}"
      },
      {
        "symbol": "VM_BIT_K",
        "value": 2,
        "alias": "const",
        "pops": 0,
        "pushes": 1,
        "operand": "const",
        "description": "-> constant[operand]",
        "format": "{const}"
      },
      {
        "symbol": "VM_BIT_DUP",
        "value": 3,
        "alias": "dup",
        "pops": 1,
        "pushes": 2,
        "operand": "none",
        "description": "a -> a a",
        "stack_op": true
      },
      {
        "symbol": "VM_BIT_DROP",
        "value": 4,
        "alias": "drop",
        "pops": 1,
        "pushes": 0,
        "operand": "none",
        "description": "a ->",
        "stack_op": true
      },
      {
        "symbol": "VM_BIT_SWAP",
        "value": 5,
        "alias": "swap",
        "pops": 2,
        "pushes": 2,
        "operand": "none",
        "description": "a b -> b a",
        "stack_op": true
      },
      {
        "symbol": "VM_BIT_AND",
        "value": 6,
        "alias": "&",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a b -> a AND b",
        "format": "{a} & {b}"
      },
      {
        "symbol": "VM_BIT_OR",
        "value": 7,
        "alias": "|",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a b -> a OR b",
        "format": "{a} | {b}"
      },
      {
        "symbol": "VM_BIT_XOR",
        "value": 8,
        "alias": "^",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a b -> a XOR b",
        "format": "{a} ^ {b}"
      },
      {
        "symbol": "VM_BIT_SHL",
        "value": 9,
        "alias": "<<",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a shifted left by n (n >= 32 gives 0)",
        "format": "{a} << {b}"
      },
      {
        "symbol": "VM_BIT_SHR",
        "value": 10,
        "alias": ">>",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a shifted right by n, zero fill (n >= 32 gives 0)",
        "format": "{a} >> {b}"
      },
      {
        "symbol": "VM_BIT_SAR",
        "value": 11,
        "alias": ">>>",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a shifted right by n, sign fill",
        "format": "{a} >>> {b}"
      },
      {
        "symbol": "VM_BIT_ROL",
        "value": 12,
        "alias": "rol",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a rotated left by n mod 32",
        "format": "rol({a}, {b})"
      },
      {
        "symbol": "VM_BIT_ROR",
        "value": 13,
        "alias": "ror",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a rotated right by n mod 32",
        "format": "ror({a}, {b})"
      },
      {
        "symbol": "VM_BIT_GET",
        "value": 14,
        "alias": "bit",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> bit n mod 32 of a (1 or 0)",
        "format": "bit({a}, {b})"
      },
      {
        "symbol": "VM_BIT_SET",
        "value": 15,
        "alias": "set",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a with bit n mod 32 set",
        "format": "setbit({a}, {b})"
      },
      {
        "symbol": "VM_BIT_CLR",
        "value": 16,
        "alias": "clear",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a with bit n mod 32 cleared",
        "format": "clearbit({a}, {b})"
      },
      {
        "symbol": "VM_BIT_TGL",
        "value": 17,
        "alias": "toggle",
        "pops": 2,
        "pushes": 1,
        "operand": "none",
        "description": "a n -> a with bit n mod 32 flipped",
        "format": "togglebit({a}, {b})"
      },
      {
        "symbol": "VM_BIT_NOT",
        "value": 18,
        "alias": "~",
        "pops": 1,
        "pushes": 1,
        "operand": "none",
        "description": "a -> every bit flipped",
        "format": "~{a}"
      },
      {
        "symbol": "VM_BIT_POPCNT",
        "value": 19,
        "alias": "popcount",
        "pops": 1,
        "pushes": 1,
        "operand": "none",
        "description": "a -> number of set bits",
        "format": "popcnt({a})"
      },
      {
        "symbol": "VM_BIT_CLZ",
        "value": 20,
        "alias": "clz",
        "pops": 1,
        "pushes": 1,
        "operand": "none",
        "description": "a -> leading zero bits (32 for 0)",
        "format": "clz({a})"
      },
      {
        "symbol": "VM_BIT_CTZ",
        "value": 21,
        "alias": "ctz",
        "pops": 1,
        "pushes": 1,
        "operand": "none",
        "description": "a -> trailing zero bits (32 for 0)",
        "format": "ctz({a})"
      },
      {
        "symbol": "VM_BIT_BSWAP",
        "value": 22,
        "alias": "bswap",
        "pops": 1,
        "pushes": 1,
        "operand": "none",
        "description": "a -> byte order reversed",
        "format": "bswap({a})"
      }
    ],
    "examples": [
      {
        "title": "bit 3 of a",
        "inputs": [
          8
        ],
        "constants": [
          3
        ],
        "code": [
          "VM_BIT_IN",
          "0",
          "VM_BIT_K",
          "0",
          "VM_BIT_GET",
          "VM_BIT_END"
        ],
        "custom_data": "0100060003000000010002000e00",
        "custom_len": 14,
        "result": 1
      },
      {
        "title": "(a << 4) | b",
        "inputs": [
          10,
          5
        ],
        "constants": [
          4
        ],
        "code": [
          "VM_BIT_IN",
          "0",
          "VM_BIT_K",
          "0",
          "VM_BIT_SHL",
          "VM_BIT_IN",
          "1",
          "VM_BIT_OR"
        ],
        "custom_data": "01000800040000000100020009010107",
        "custom_len": 16,
        "result": 165
      },
      {
        "title": "set bits in a",
        "inputs": [
          61680
        ],
        "constants": [],
        "code": [
          "VM_BIT_IN",
          "0",
          "VM_BIT_POPCNT"
        ],
        "custom_data": "00000300010013",
        "custom_len": 7,
        "result": 8
      }
    ],
    "formula": [
      {
        "ref": "result",
        "kind": "out",
        "pin": 0
      },
      {
        "text": " = "
      },
      {
        "ref": "expr",
        "kind": "expression"
      }
    ]
  }
}
