        <mxCell id="m-e6" edge="1" parent="1" source="m-aa2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#000000;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.4970;exitY=1.0000;entryX=0.8030;entryY=0.0000;" target="m-vm1" value="↓ zapis do obiektu">
