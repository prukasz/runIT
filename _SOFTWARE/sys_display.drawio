          <mxGeometry height="90" width="200" x="490" y="1295" as="geometry" />
        </mxCell>
        <mxCell id="m-e15" edge="1" parent="1" source="m-c0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="m-c1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-e16" edge="1" parent="1" source="m-c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" target="m-c2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-o1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6c1be;strokeColor=#b85450;fontColor=#000000;roundedPerimeter=1;" value="&lt;b&gt;zapis do obiektu VM&lt;/b&gt; (payload albo wartość zdarzenia): vm_override_post, program widzi ją od następnego przebiegu" vertex="1">
          <mxGeometry height="55" width="520" x="740" y="1265" as="geometry" />
        </mxCell>
        <mxCell id="m-o2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6c1be;strokeColor=#b85450;fontColor=#000000;roundedPerimeter=1;" value="&lt;b&gt;zmiana ekranu&lt;/b&gt;: sys_screen SHOW" vertex="1">
          <mxGeometry height="55" width="520" x="740" y="1335" as="geometry" />
        </mxCell>
        <mxCell id="m-o3" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#393C56;fontSize=11;rounded=1;roundedPerimeter=1;" value="ON_EVENT widzi tylko sys_event, więc zdarzenie widgetu dociera do programu jako wartość w obiekcie (w VM każde zdarzenie jest wartością)." vertex="1">
          <mxGeometry height="50" width="520" x="740" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="m-e17" edge="1" parent="1" source="m-c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.4909;" target="m-o1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-e18" edge="1" parent="1" source="m-c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;fontColor=#393C56;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.4909;" target="m-o2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m-desc" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#393C56;fontSize=12;strokeColor=#E07A5F;rounded=1;spacing=8;roundedPerimeter=1;" value="&lt;b style='font-size:16px'&gt;Adapter VM: co robi&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Ostatnia warstwa.&lt;/b&gt; Wiąże obiekty VM z widgetami (wyświetlanie, odświeżanie przy zmianie) i zdarzenia widgetów z akcjami (zapis do obiektu, zmiana ekranu). Ekran należy do programu VM.&lt;br&gt;&lt;b&gt;2. Obiekt → widget.&lt;/b&gt; Obserwator wykrywa zmianę obiektu, tablica daje ID widgetu, wartość jest dopasowana do typu właściwości, a sys_screen ustawia ją pod blokadą LVGL.&lt;br&gt;&lt;b&gt;3. Zdarzenie → akcja.&lt;/b&gt; Adapter czeka na zdarzenie z kolejki sys_screen, tablica daje powiązanie, a akcja to zapis do obiektu (vm_override_post) albo zmiana ekranu (SHOW). Zdarzenia widgetów mają własną kolejkę i task, osobne od sys_event (rozmiary payloadu).&lt;br&gt;&lt;b&gt;4. Dwa światy, jedno miejsce styku.&lt;/b&gt; VM i ekran mają osobne wątki; adapter styka je tylko przez zwalidowane, kolejkowane wejścia, więc nie dotyka wprost ani obiektów VM, ani obiektów LVGL." vertex="1">
          <mxGeometry height="105" width="1260" x="30" y="1495" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>