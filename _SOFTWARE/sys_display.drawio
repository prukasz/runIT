        <mxCell id="m-e7" edge="1" parent="1" source="m-la2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c8c8c8;fontColor=#a0a0a0;fontSize=11;labelBackgroundColor=default;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.2222;exitY=1.0000;entryX=0.4189;entryY=0.0000;" target="m-va" value="lv_obj ↓">
