CompileFlags:
    CompilationDatabase: build
    Add:
        [
            -std=gnu23,
            -ferror-limit=99999,
            -Wno-implicit-function-declaration,
            -isystem,
            C:/Espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/15.2.0/include,
        ]
    Remove:
        - -mlongcalls
        - -mdisable-hardware-atomics
        - -mno-target-align
        - -fno-shrink-wrap
        - -fstrict-volatile-bitfields
        - -fno-tree-switch-conversion
        - -fzero-init-padding-bits=all
        - -fno-malloc-dce
Diagnostics:
    Suppress:
        - pp_file_not_found
        - unused-includes
