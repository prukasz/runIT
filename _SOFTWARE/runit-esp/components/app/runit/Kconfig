menu "runIT"

    config RUNIT_BLE_START
        bool "Start BLE at boot"
        default y
        help
          Off for QEMU: it emulates no Bluetooth controller (the controller
          init asserts). The runIT GATT table, the BLE router link and the BLE
          stream bindings are still set up; only NimBLE is not started.
          sdkconfig.qemu.defaults turns it off for the QEMU build.

    choice RUNIT_BOARD
        prompt "Board"
        default RUNIT_BOARD_PCB
        help
          What the firmware creates at boot (boot step "devices") and the power
          layout it gives the power manager.

        config RUNIT_BOARD_PCB
            bool "runIT PCB"
            help
              The ESP GPIO, the TCA6424A expander (status LED lit) and every
              other onboard chip (power muxes, ADS7128, PCA9685, both TPS55289
              rails, INA3221, AP33772S, DAC53202, both DRV8962), and the
              board's power layout (rails, input monitor, USB-C PD sink).

        config RUNIT_BOARD_DEVKIT
            bool "ESP32-S3 devkit"
            help
              Only the ESP GPIO (device 0); no chips and no power layout (the
              power manager has no rails, monitor or sink). For a plain devkit:
              sdkconfig.devkit.defaults.

        config RUNIT_BOARD_BARE
            bool "No devices (QEMU, test suites)"
            help
              Nothing created at boot: the test suites create devices from an
              empty table. The power layout stays the PCB's. QEMU:
              sdkconfig.qemu.defaults.
    endchoice

    choice RUNIT_LINK_ROLE
        prompt "Link to another board"
        default RUNIT_LINK_NONE
        help
          What the sys_uart link (a second UART, CONFIG_SYS_UART_LINK_*) is in
          the tree of boards (SYS_SESSION.MD). A board with a parent takes no
          client: a child has no console or BLE session of its own, the app
          reaches it through the root.

        config RUNIT_LINK_NONE
            bool "None"
            help
              No link: the board is alone and takes clients (the app, the
              test scripts) on the console and on BLE.

        config RUNIT_LINK_ROOT
            bool "Root: the link leads to a child"
            select SYS_UART_LINK
            help
              The board stays the root and takes its clients; the link is a
              child session. The child's board id must differ from this
              board's (sdkconfig.link_root.defaults).

        config RUNIT_LINK_CHILD
            bool "Child: the link leads to the parent"
            select SYS_UART_LINK
            help
              The link is the board's parent session; no client session is
              attached. Give the board an id of its own
              (CONFIG_SYS_SESSION_BOARD_ID_DEFAULT; sdkconfig.link_child.defaults).
    endchoice

    menu "Onboard action IDs"

        #@limit @alias Onboard action: resume all
        config RUNIT_ACTION_ID_RESUME
            int "Resume all devices"
            default 3
            range 1 255
            help
              ID of the onboard action that resumes every device. The firmware
              writes it at every boot (replacing a stored action with this ID).

        #@limit @alias Onboard action: suspend all
        config RUNIT_ACTION_ID_SUSPEND
            int "Suspend all devices"
            default 4
            range 1 255
            help
              ID of the onboard action that suspends every device. The firmware
              writes it at every boot (replacing a stored action with this ID).

        #@limit @alias Onboard action: reset all
        config RUNIT_ACTION_ID_RESET
            int "Reset all devices"
            default 5
            range 1 255
            help
              ID of the onboard action that resets every device (RESET sweep,
              newest first). The firmware writes it at every boot.

        #@limit @alias Onboard action: hard reset
        config RUNIT_ACTION_ID_HARD_RESET
            int "Hard reset (restart the board)"
            default 6
            range 1 255
            help
              ID of the onboard action that restarts the board (sys RESTART).
              The firmware writes it at every boot.

    endmenu

endmenu
