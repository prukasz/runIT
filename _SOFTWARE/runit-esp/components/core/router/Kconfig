menu "router"

    #@limit @alias Response stream byte
    config ROUTER_RESPONSE_STREAM
        hex "Response stream byte"
        default 0x05
        range 0x00 0xFF
        help
          First byte of every response frame, so clients can tell answers from
          other streams on the same link.

    config ROUTER_MAX_KEYS
        int "Root keys"
        default 16
        range 2 64
        help
          Root table slots (router_register).

    config ROUTER_MAX_LINKS
        int "Highest link ID"
        default 4
        range 1 16
        help
          Links (the transports: transport_e in sys_data_connector_config.h) are
          registered under IDs 1..ROUTER_MAX_LINKS. The data connectors bind
          to the same links, so this also bounds their providers.

    config ROUTER_WORK_QUEUE_SIZE
        int "Work queue (bytes)"
        default 4096
        range 1024 32768
        help
          Ring buffer of normal commands waiting for the work task: each takes
          its request, a 12-byte header (answer callback, its ctx, origin) and
          the ring's own header. Multiple of 4.

    config ROUTER_URGENT_QUEUE_SIZE
        int "Urgent queue (bytes)"
        default 1024
        range 256 8192
        help
          Ring buffer of commands flagged urgent. Multiple of 4.

    config ROUTER_WORK_TASK_PRIO
        int "Work task priority"
        default 5
        range 1 24

    config ROUTER_WORK_TASK_STACK
        int "Work task stack (bytes)"
        default 6144
        range 3072 32768
        help
          Runs the module routers of normal commands and their answer
          callbacks.

    config ROUTER_URGENT_TASK_PRIO
        int "Urgent task priority"
        default 15
        range 1 24
        help
          Above every task that may run a long command, so an urgent one
          (stop) never waits behind it.

    config ROUTER_URGENT_TASK_STACK
        int "Urgent task stack (bytes)"
        default 6144
        range 3072 32768
        help
          Runs urgent commands and router_run_urgent (the safe-state
          handler on a dead-man or a lost link).

endmenu
