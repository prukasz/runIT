{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "CONNECTOR",
  "router_key": 4,
  "alias": "Data stream connectors (Data Connectors)",
  "description": "Managing the outgoing data streams (telemetry, logs, errors, events, user streams): their bindings to providers and the peers subscribed to them.",
  "category": "system",
  "record": "SYS_ACTIONS_ID_CONN",
  "commands": [
    {
      "id": "CREATE",
      "op": 1,
      "symbol": "SYS_DATA_CONNECTOR_OP_CREATE",
      "label": "Create a stream",
      "description": "Creates a user connector: a stream named by its byte.",
      "write": {
        "args": {
          "struct": "create_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The new connector: any byte but 0x00, 0x05 and a system connector's"
            },
            {
              "id": "flags",
              "label": "Flags",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "SYS_DATA_CONNECTOR_FLAG_URGENT: its frames go first on every way out"
            }
          ]
        }
      }
    },
    {
      "id": "REMOVE",
      "op": 2,
      "symbol": "SYS_DATA_CONNECTOR_OP_REMOVE",
      "label": "Remove a stream",
      "description": "Removes a user stream, its subscriptions and its bindings.",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector to remove"
            }
          ]
        }
      }
    },
    {
      "id": "BIND",
      "op": 3,
      "symbol": "SYS_DATA_CONNECTOR_OP_BIND",
      "label": "Bind to a provider",
      "description": "Binds a stream to a provider (a BLE characteristic, a UART port): its frames go there as they are.",
      "write": {
        "args": {
          "struct": "bind_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector"
            },
            {
              "id": "link",
              "label": "Link",
              "type": "enum",
              "enum": "sys_data_provider_link_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Which driver made the provider (UART, BLE)"
            },
            {
              "id": "channel",
              "label": "Channel",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 2,
              "description": "Its address on that link: BLE the characteristic's 16-bit UUID, UART the port"
            },
            {
              "id": "flags",
              "label": "Direction",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 6,
              "description": "SYS_DATA_CONNECTOR_BIND_TX"
            }
          ]
        }
      }
    },
    {
      "id": "UNBIND",
      "op": 4,
      "symbol": "SYS_DATA_CONNECTOR_OP_UNBIND",
      "label": "Unbind from a provider",
      "description": "Removes a binding; the provider is free again. Link 0: every binding of the stream.",
      "write": {
        "args": {
          "struct": "unbind_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector"
            },
            {
              "id": "link",
              "label": "Link",
              "type": "enum",
              "enum": "sys_data_provider_link_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Which driver made the provider (UART, BLE)"
            },
            {
              "id": "channel",
              "label": "Channel",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 2,
              "description": "Its address on that link: BLE the characteristic's 16-bit UUID, UART the port"
            }
          ]
        }
      }
    },
    {
      "id": "SUSPEND",
      "op": 5,
      "symbol": "SYS_DATA_CONNECTOR_OP_SUSPEND",
      "label": "Suspend a stream",
      "description": "Stops sending frames on a stream (they are dropped without blocking the sender).",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector to suspend"
            }
          ]
        }
      }
    },
    {
      "id": "RESUME",
      "op": 6,
      "symbol": "SYS_DATA_CONNECTOR_OP_RESUME",
      "label": "Resume a stream",
      "description": "Sends the frames of a suspended stream again.",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector to resume"
            }
          ]
        }
      }
    },
    {
      "id": "LIST",
      "op": 7,
      "symbol": "SYS_DATA_CONNECTOR_OP_LIST",
      "label": "List the streams",
      "description": "Returns every connector, its state, its subscribers and its bindings.",
      "read": {
        "returns": {
          "type": "u8",
          "label": "Number of connectors",
          "description": "Then, per connector: its head (id, flags, state, subscriber count, binding count), its subscribers (peer u8, dropped u16), its bindings (provider id, flags u8, dropped u16)."
        }
      }
    },
    {
      "id": "SUBSCRIBE",
      "op": 9,
      "symbol": "SYS_DATA_CONNECTOR_OP_SUBSCRIBE",
      "label": "Subscribe to a stream",
      "description": "The peer that sends it gets the stream's frames, until UNSUBSCRIBE or its session ends.",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector"
            }
          ]
        }
      }
    },
    {
      "id": "UNSUBSCRIBE",
      "op": 10,
      "symbol": "SYS_DATA_CONNECTOR_OP_UNSUBSCRIBE",
      "label": "Unsubscribe from a stream",
      "description": "Ends the subscription of the peer that sends it.",
      "write": {
        "args": {
          "struct": "connector_t",
          "fields": [
            {
              "id": "id",
              "label": "Connector",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The connector"
            }
          ]
        }
      }
    }
  ]
}
