{
  "$schema": "../../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "POLICY",
  "router_key": 48,
  "alias": "Device fault policy",
  "description": "Configures how device errors are filtered by importance and what automated recovery action or record executes for each error severity level.",
  "category": "system",
  "commands": [
    {
      "id": "POLICY",
      "op": 1,
      "symbol": "POLICY_OP_POLICY",
      "label": "Device error policy",
      "description": "Reads or updates the error importance threshold and per-severity action/response table for a device.",
      "read": {
        "args": {
          "struct": "sys_device_policy_key_t",
          "fields": [
            {
              "id": "id",
              "label": "Device ID",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "min": 0,
              "max": 63
            }
          ]
        },
        "returns": {
          "struct": "sys_device_policy_entry_t",
          "fields": [
            {
              "id": "id",
              "label": "Device ID",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "importance",
              "label": "Importance",
              "type": "enum",
              "enum": "sys_device_importance_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Minimum severity level that triggers a policy response"
            },
            {
              "id": "actions",
              "label": "Severity actions",
              "type": "number",
              "raw_type": "u32",
              "size": 16,
              "offset": 2,
              "description": "Four u32 entries (low, medium, high, critical): an action record ID, SYS_DEVICE_RESPONSE_*, or 0 for none"
            }
          ]
        }
      },
      "write": {
        "args": {
          "struct": "sys_device_policy_entry_t",
          "fields": [
            {
              "id": "id",
              "label": "Device ID",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "importance",
              "label": "Importance",
              "type": "enum",
              "enum": "sys_device_importance_e",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Minimum severity level that triggers a policy response"
            },
            {
              "id": "actions",
              "label": "Severity actions",
              "type": "number",
              "raw_type": "u32",
              "size": 16,
              "offset": 2,
              "description": "Four u32 entries (low, medium, high, critical): an action record ID, SYS_DEVICE_RESPONSE_*, or 0 for none"
            }
          ]
        }
      }
    }
  ]
}
