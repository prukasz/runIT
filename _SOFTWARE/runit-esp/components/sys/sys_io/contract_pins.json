{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "contract-definition",
  "id": "PINS",
  "contract_id": 2,
  "alias": "Pin locks",
  "description": "Claiming a pin of a device for another device",
  "category": "gpio",
  "commands": [
    {
      "id": "AVAILABLE",
      "op": 0,
      "symbol": "PINS_OP_AVAILABLE",
      "label": "Available pins",
      "description": "The pins the device has.",
      "read": {
        "returns": {
          "type": "u64",
          "label": "Pins"
        }
      }
    },
    {
      "id": "LOCKED",
      "op": 1,
      "symbol": "PINS_OP_LOCKED",
      "label": "Locked pins",
      "description": "The pins that are locked.",
      "read": {
        "returns": {
          "type": "u64",
          "label": "Pins"
        }
      }
    },
    {
      "id": "LOCK",
      "op": 2,
      "symbol": "PINS_OP_LOCK",
      "label": "Lock pin",
      "description": "Claims a pin for another device (refused if it is locked).",
      "write": {
        "args": {
          "fields": [
            {
              "id": "pin",
              "label": "Pin",
              "type": "pin",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The pin of the device"
            }
          ],
          "struct": "pins_pin_args_t"
        }
      }
    },
    {
      "id": "UNLOCK",
      "op": 3,
      "symbol": "PINS_OP_UNLOCK",
      "label": "Unlock pin",
      "description": "Releases a claimed pin.",
      "write": {
        "args": {
          "fields": [
            {
              "id": "pin",
              "label": "Pin",
              "type": "pin",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The pin of the device"
            }
          ],
          "struct": "pins_pin_args_t"
        }
      }
    },
    {
      "id": "LOCKED_LEVEL",
      "op": 4,
      "symbol": "PINS_OP_LOCKED_LEVEL",
      "label": "Locked pin level",
      "description": "The owner of a locked pin drives it.",
      "write": {
        "args": {
          "fields": [
            {
              "id": "pin",
              "label": "Pin",
              "type": "pin",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The locked pin"
            },
            {
              "id": "level",
              "label": "Level",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "options": [
                {
                  "label": "Low",
                  "value": 0
                },
                {
                  "label": "High",
                  "value": 1
                }
              ]
            }
          ],
          "struct": "pins_level_args_t"
        }
      }
    }
  ]
}
