menu "sys_event"

    config SYS_EVENT_MAX_SUBS
        int "Subscriptions (C)"
        default 32
        range 4 255
        help
          Listeners made by C code: devices (inline) and functions (the VM,
          the power manager; the event task).

    config SYS_EVENT_QUEUE_LEN
        int "Queue (events)"
        default 16
        range 4 128
        help
          Events waiting for the event task (for the function listeners,
          events from ISRs and deferred publishes). A full queue drops the event.

    config SYS_EVENT_TASK_PRIO
        int "Task priority"
        default 6
        range 1 24
        help
          Above the router work task (5), below the urgent task (15).

    config SYS_EVENT_TASK_STACK
        int "Task stack (bytes)"
        default 4096
        range 3072 32768
        help
          Runs the function listeners (the VM, the power manager) and every
          listener of an ISR or deferred event: device ON_EVENT ops (I2C).

endmenu
