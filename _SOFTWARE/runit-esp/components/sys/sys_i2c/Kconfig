menu "sys_i2c"

    config SYS_I2C_XFER_TIMEOUT_MS
        int "Transfer timeout (ms)"
        default 50
        range 5 5000
        help
          Timeout of one transfer (write, read, write-read), including the wait
          for the bus lock when another task is using the bus.

    config SYS_I2C_PROBE_TIMEOUT_MS
        int "Probe timeout (ms)"
        default 50
        range 5 5000
        help
          Timeout of the address probe done by sys_i2c_dev_add() and
          sys_i2c_probe().

    config SYS_I2C_GLITCH_IGNORE_CNT
        int "Glitch filter (I2C module clock cycles)"
        default 7
        range 0 7
        help
          Pulses on SDA/SCL shorter than this are ignored. Applies to both buses.

endmenu
