{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "I2C",
  "router_key": 2,
  "alias": "I2C bus diagnostics (I2C Bus Diagnostics)",
  "description": "Scanning addresses on the I2C buses, resetting a bus, and direct access to the registers of chips (raw read / write).",
  "category": "system",
  "commands": [
    {
      "id": "SCAN",
      "op": 2,
      "symbol": "SYS_I2C_OP_SCAN",
      "label": "Scan an I2C bus",
      "description": "Scans the addresses 0x08..0x77 on the given bus and returns a 128-bit mask of the addresses that answered ACK.",
      "read": {
        "args": {
          "struct": "sys_i2c_bus_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus index",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "Number of the I2C bus (0 or 1)"
            }
          ]
        },
        "returns": {
          "struct": "sys_i2c_scan_t",
          "description": "Mask of the addresses found",
          "fields": [
            {
              "id": "found_0",
              "label": "Addresses 0x00..0x1F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 0
            },
            {
              "id": "found_1",
              "label": "Addresses 0x20..0x3F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 4
            },
            {
              "id": "found_2",
              "label": "Addresses 0x40..0x5F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 8
            },
            {
              "id": "found_3",
              "label": "Addresses 0x60..0x7F",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 12
            }
          ]
        }
      }
    },
    {
      "id": "RESET",
      "op": 3,
      "symbol": "SYS_I2C_OP_RESET",
      "label": "Reset an I2C bus",
      "description": "Resets the bus (SCL clock pulses) to free a chip that holds the SDA line.",
      "write": {
        "args": {
          "struct": "sys_i2c_bus_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus index",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            }
          ]
        }
      }
    },
    {
      "id": "RAW",
      "op": 4,
      "symbol": "SYS_I2C_OP_RAW",
      "label": "Raw register",
      "description": "Bytes of a register of the device at a 7-bit address: the write writes them, the read reads `len` of them and answers the address with the bytes.",
      "read": {
        "description": "Reads a number of bytes from a register of the device at the given 7-bit I2C address.",
        "args": {
          "struct": "sys_i2c_raw_read_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "addr",
              "label": "7-bit address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "reg",
              "label": "Register address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2
            },
            {
              "id": "len",
              "label": "Number of bytes",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 3
            }
          ]
        },
        "returns": {
          "struct": "sys_i2c_raw_write_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "addr",
              "label": "7-bit address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "reg",
              "label": "Register address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2
            },
            {
              "id": "data",
              "label": "Data to write",
              "type": "string",
              "raw_type": "bytes",
              "description": "Bytes to write (runs to the end of the frame)"
            }
          ],
          "description": "Bytes read from the register"
        }
      },
      "write": {
        "description": "Writes data to the given register of the device at a 7-bit I2C address.",
        "args": {
          "struct": "sys_i2c_raw_write_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "I2C bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            },
            {
              "id": "addr",
              "label": "7-bit address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1
            },
            {
              "id": "reg",
              "label": "Register address",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2
            },
            {
              "id": "data",
              "label": "Data to write",
              "type": "string",
              "raw_type": "bytes",
              "description": "Bytes to write (runs to the end of the frame)"
            }
          ]
        }
      }
    },
    {
      "id": "BUS_CREATE",
      "op": 5,
      "symbol": "SYS_I2C_OP_BUS_CREATE",
      "label": "Create a bus",
      "description": "An I2C bus on two pins of the ESP32-S3: its write creates it (its GPIO device must exist), its read answers what it was created with.",
      "write": {
        "args": {
          "struct": "sys_i2c_bus_cfg_t",
          "fields": [
            {
              "id": "bus",
              "label": "Bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The bus to create (0 or 1)"
            },
            {
              "id": "sda",
              "label": "SDA",
              "type": "pin",
              "raw_type": "bytes",
              "size": 3,
              "offset": 1,
              "pin_ref": true,
              "requires": "output",
              "description": "A pin of the ESP32-S3 itself"
            },
            {
              "id": "scl",
              "label": "SCL",
              "type": "pin",
              "raw_type": "bytes",
              "size": 3,
              "offset": 4,
              "pin_ref": true,
              "requires": "output",
              "description": "A pin of the ESP32-S3 itself"
            },
            {
              "id": "pullup",
              "label": "Internal pull-ups",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 7,
              "description": "1: the ESP32-S3's internal pull-ups on"
            }
          ]
        }
      },
      "read": {
        "args": {
          "struct": "sys_i2c_bus_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "Bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The bus to create (0 or 1)"
            }
          ]
        },
        "returns": {
          "struct": "sys_i2c_bus_cfg_t",
          "description": "What the bus was created with",
          "fields": [
            {
              "id": "bus",
              "label": "Bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The bus to create (0 or 1)"
            },
            {
              "id": "sda",
              "label": "SDA",
              "type": "pin",
              "raw_type": "bytes",
              "size": 3,
              "offset": 1,
              "pin_ref": true,
              "requires": "output",
              "description": "A pin of the ESP32-S3 itself"
            },
            {
              "id": "scl",
              "label": "SCL",
              "type": "pin",
              "raw_type": "bytes",
              "size": 3,
              "offset": 4,
              "pin_ref": true,
              "requires": "output",
              "description": "A pin of the ESP32-S3 itself"
            },
            {
              "id": "pullup",
              "label": "Internal pull-ups",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 7,
              "description": "1: the ESP32-S3's internal pull-ups on"
            }
          ]
        }
      }
    },
    {
      "id": "BUS_REMOVE",
      "op": 6,
      "symbol": "SYS_I2C_OP_BUS_REMOVE",
      "label": "Remove a bus",
      "description": "Removes an I2C bus and frees its pins (refused while a device is on it).",
      "write": {
        "args": {
          "struct": "sys_i2c_bus_args_t",
          "fields": [
            {
              "id": "bus",
              "label": "Bus",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The bus to remove (0 or 1)"
            }
          ]
        }
      }
    }
  ]
}
