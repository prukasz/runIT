{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "SESSION",
  "router_key": 44,
  "alias": "Sessions",
  "description": "This board's id and its sessions: the providers attached to a peer, each a port of the data matrix with a sub-port per module it shows.",
  "category": "system",
  "commands": [
    {
      "id": "ID",
      "op": 1,
      "symbol": "SESSION_OP_ID",
      "label": "Board id",
      "description": "This board's place in the project, kept in NVS; a new one takes effect at the next start.",
      "read": {
        "returns": {
          "struct": "sys_session_id_args_t",
          "description": "The board id",
          "fields": [
            {
              "id": "board_id",
              "label": "Board id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0: none given, 1..0xEF",
              "min": 0,
              "max": 239
            }
          ]
        }
      },
      "write": {
        "args": {
          "struct": "sys_session_id_args_t",
          "fields": [
            {
              "id": "board_id",
              "label": "Board id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0: none, 1..0xEF; from the next start",
              "min": 0,
              "max": 239,
              "default": 0
            }
          ]
        }
      }
    },
    {
      "id": "PEERS",
      "op": 2,
      "symbol": "SESSION_OP_PEERS",
      "label": "List the sessions",
      "description": "Returns every session.",
      "read": {
        "returns": {
          "struct": "sys_session_info_t",
          "array": true,
          "lead": {
            "id": "count",
            "raw_type": "u8",
            "label": "Number of sessions"
          },
          "description": "One row per session",
          "fields": [
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "The provider it runs over"
            },
            {
              "id": "open",
              "label": "Open",
              "type": "boolean",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Both hellos passed"
            },
            {
              "id": "peer_id",
              "label": "Peer id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "description": "Its id from its hello; CMD_SRC_NONE before it"
            },
            {
              "id": "safety",
              "label": "Safety",
              "type": "boolean",
              "raw_type": "u8",
              "size": 1,
              "offset": 3,
              "description": "Its end is a safety event"
            },
            {
              "id": "build_id",
              "label": "Build",
              "type": "integer",
              "raw_type": "u32",
              "size": 4,
              "offset": 4,
              "description": "Its firmware's build, from its hello; 0 from a client"
            },
            {
              "id": "deadman_ms",
              "label": "Dead-man",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 8,
              "description": "The silence that ends it; 0: none",
              "unit": "ms"
            },
            {
              "id": "role",
              "label": "Role",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 10,
              "description": "session_flag SYS_SESSION_SLAVE or SYS_SESSION_MASTER: the peer is a board (below / above this one); 0: a client"
            }
          ]
        }
      }
    },
    {
      "id": "ATTACH",
      "op": 3,
      "symbol": "SESSION_OP_ATTACH",
      "label": "Attach a session",
      "description": "Makes a framed provider's peer a session: its port, linked with the provider both ways, and a sub-port per module listed; with the slave or master flag the sub-ports and their links are the board's. The same again changes nothing.",
      "write": {
        "args": {
          "struct": "sys_session_attach_args_t",
          "fields": [
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "A framed provider, id below 0x80",
              "min": 0,
              "max": 127
            },
            {
              "id": "flags",
              "label": "Flags",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "session_flag: bit 0 its end is a safety event; bit 1 the peer is a slave board, bit 2 the peer is the master board (then no modules follow: its sub-ports and their links are the board's)"
            },
            {
              "id": "deadman_ms",
              "label": "Dead-man",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 2,
              "unit": "ms",
              "description": "0: none, else 150..60000: the silence that ends it"
            },
            {
              "id": "modules",
              "label": "Modules",
              "type": "string",
              "raw_type": "bytes",
              "description": "The module of each sub-port, a u8 each (0x23: the commands); runs to the end of the frame; none for a slave's or a master's session"
            }
          ]
        }
      }
    },
    {
      "id": "DETACH",
      "op": 4,
      "symbol": "SESSION_OP_DETACH",
      "label": "Detach a session",
      "description": "Ends the session on a provider and takes its ports out of the data matrix.",
      "write": {
        "args": {
          "struct": "sys_session_detach_args_t",
          "fields": [
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "min": 0,
              "max": 127
            }
          ]
        }
      }
    }
  ]
}
