{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "SESSION",
  "router_key": 14,
  "alias": "Sessions",
  "description": "This board's id and its sessions: the providers attached to a peer, each a port of the data matrix with a sub-port per module it shows.",
  "category": "system",
  "commands": [
    {
      "id": "ID",
      "op": 1,
      "symbol": "SESSION_OP_ID",
      "label": "Board id",
      "description": "This board's place in the project, kept in NVS; a new one takes effect at the next start.",
      "read": {
        "returns": {
          "struct": "sys_session_id_args_t",
          "description": "The board id",
          "fields": [
            {
              "id": "board_id",
              "label": "Board id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0: none given, 1..0xEF",
              "min": 0,
              "max": 239
            }
          ]
        }
      },
      "write": {
        "args": {
          "struct": "sys_session_id_args_t",
          "fields": [
            {
              "id": "board_id",
              "label": "Board id",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0: none, 1..0xEF; from the next start",
              "min": 0,
              "max": 239
            }
          ]
        }
      }
    },
    {
      "id": "PEERS",
      "op": 2,
      "symbol": "SESSION_OP_PEERS",
      "label": "List the sessions",
      "description": "Returns every session.",
      "read": {
        "returns": {
          "type": "u8",
          "label": "Number of sessions",
          "description": "Then per session (sys_session_info_t, 10 B): provider u8, open u8, peer id u8, safety u8, build id u32, deadman_ms u16."
        }
      }
    },
    {
      "id": "ATTACH",
      "op": 3,
      "symbol": "SESSION_OP_ATTACH",
      "label": "Attach a session",
      "description": "Makes a framed provider's peer a session: its port, linked with the provider both ways, and a sub-port per module listed. The same again changes nothing.",
      "write": {
        "args": {
          "struct": "sys_session_attach_args_t",
          "fields": [
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "A framed provider, id below 0x80",
              "min": 0,
              "max": 127
            },
            {
              "id": "flags",
              "label": "Flags",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "description": "Bit 0: its end is a safety event"
            },
            {
              "id": "deadman_ms",
              "label": "Dead-man",
              "type": "integer",
              "raw_type": "u16",
              "size": 2,
              "offset": 2,
              "unit": "ms",
              "description": "0: none, else 150..60000: the silence that ends it"
            },
            {
              "id": "modules",
              "label": "Modules",
              "type": "string",
              "raw_type": "bytes",
              "description": "The module of each sub-port, a u8 each (0x23: the commands); runs to the end of the frame"
            }
          ]
        }
      }
    },
    {
      "id": "DETACH",
      "op": 4,
      "symbol": "SESSION_OP_DETACH",
      "label": "Detach a session",
      "description": "Ends the session on a provider and takes its ports out of the data matrix.",
      "write": {
        "args": {
          "struct": "sys_session_detach_args_t",
          "fields": [
            {
              "id": "provider",
              "label": "Provider",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "min": 0,
              "max": 127
            }
          ]
        }
      }
    }
  ]
}
