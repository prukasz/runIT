menu "sys_session"

    config SYS_SESSION_MAX
        int "Sessions"
        default 4
        range 1 16
        help
          Sessions: providers with a peer on them, a board or a client.

    config SYS_SESSION_BOARD_ID_DEFAULT
        int "Board id until the app sets one"
        default 0
        range 0 239
        help
          The board's id when none is kept in NVS (ID). Two boards of one
          project need different ids: the app sets them with ID.

endmenu
