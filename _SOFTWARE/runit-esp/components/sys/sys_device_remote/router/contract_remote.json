{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "REMOTE",
  "router_key": 47,
  "alias": "Remote devices",
  "description": "Subscriptions to this board's devices: a subscriber gets a device's events and errors outside a command, in the remote devices' channel: [channel][id][kind][data].",
  "category": "system",
  "commands": [
    {
      "id": "SUBSCRIBE",
      "op": 1,
      "symbol": "REMOTE_OP_SUBSCRIBE",
      "label": "Follow a device",
      "description": "Subscribes the sender to a device of this board: its events and its errors outside a command come to the sender until UNSUBSCRIBE or the sender is gone.",
      "write": {
        "args": {
          "struct": "sys_device_remote_ref_t",
          "fields": [
            {
              "id": "id",
              "label": "Device",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "A device of this board"
            }
          ]
        }
      }
    },
    {
      "id": "UNSUBSCRIBE",
      "op": 2,
      "symbol": "REMOTE_OP_UNSUBSCRIBE",
      "label": "Stop following a device",
      "description": "Ends the sender's subscription to a device of this board.",
      "write": {
        "args": {
          "struct": "sys_device_remote_ref_t",
          "fields": [
            {
              "id": "id",
              "label": "Device",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "A device of this board"
            }
          ]
        }
      }
    }
  ]
}
