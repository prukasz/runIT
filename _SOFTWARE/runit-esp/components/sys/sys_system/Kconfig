menu "sys_system"

    config SYS_SYSTEM_DEADMAN_DEFAULT_MS
        int "Dead-man timeout at boot (ms, 0 = off)"
        default 0
        range 0 60000
        help
          0, or the clients' sessions' timeout (150..60000): their end enters
          the safe state. Changed at runtime with the sys DEADMAN command;
          not stored.

endmenu
