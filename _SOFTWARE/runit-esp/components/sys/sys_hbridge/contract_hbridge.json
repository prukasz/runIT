{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "contract-definition",
  "id": "HBRIDGE",
  "contract_id": 9,
  "alias": "H-bridge",
  "description": "A motor driver: drive, brake, coast, current and its faults",
  "category": "motor",
  "commands": [
    {
      "id": "SET_DRIVE",
      "op": 0,
      "invasive": true,
      "label": "Drive",
      "description": "Drives a motor channel; out of range is an error.",
      "symbol": "HBRIDGE_OP_SET_DRIVE",
      "args": {
        "fields": [
          {
            "id": "channel",
            "label": "Channel",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "The motor channel"
          },
          {
            "id": "drive",
            "label": "Drive",
            "type": "number",
            "raw_type": "i16",
            "size": 2,
            "offset": 1,
            "description": "PWM steps: -4095 full reverse to 4095 full forward (a half bridge 0 to 4095)",
            "min": -4095,
            "max": 4095
          }
        ],
        "struct": "hbridge_drive_args_t"
      }
    },
    {
      "id": "BRAKE",
      "op": 1,
      "invasive": true,
      "label": "Brake",
      "description": "Shorts the motor terminals.",
      "symbol": "HBRIDGE_OP_BRAKE",
      "args": {
        "fields": [
          {
            "id": "channel",
            "label": "Channel",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "The motor channel"
          }
        ],
        "struct": "hbridge_channel_args_t"
      }
    },
    {
      "id": "COAST",
      "op": 2,
      "invasive": true,
      "label": "Coast",
      "description": "Releases the motor: the outputs are off.",
      "symbol": "HBRIDGE_OP_COAST",
      "args": {
        "fields": [
          {
            "id": "channel",
            "label": "Channel",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "The motor channel"
          }
        ],
        "struct": "hbridge_channel_args_t"
      }
    },
    {
      "id": "GET_CURRENT",
      "op": 3,
      "label": "Read current",
      "description": "Reads the current of a channel.",
      "symbol": "HBRIDGE_OP_GET_CURRENT",
      "args": {
        "fields": [
          {
            "id": "channel",
            "label": "Channel",
            "type": "pin",
            "raw_type": "u8",
            "size": 1,
            "offset": 0,
            "description": "The motor channel"
          }
        ],
        "struct": "hbridge_channel_args_t"
      },
      "returns": {
        "type": "i32",
        "label": "Current",
        "unit": "mA"
      }
    }
  ],
  "events": [
    {
      "id": "OVERCURRENT",
      "event": 0,
      "code": 2304,
      "label": "Over-current",
      "description": "The channel drew more than its current limit",
      "notify": true,
      "symbol": "HBRIDGE_EV_OVERCURRENT"
    },
    {
      "id": "THERMAL_OR_UVLO",
      "event": 1,
      "code": 2305,
      "label": "Overheat or low supply",
      "description": "The chip overheated or its supply dropped: every channel stopped",
      "notify": true,
      "symbol": "HBRIDGE_EV_THERMAL_OR_UVLO"
    },
    {
      "id": "EXTERNAL",
      "event": 2,
      "code": 2306,
      "label": "External fault",
      "description": "An external fault input fired",
      "notify": true,
      "symbol": "HBRIDGE_EV_EXTERNAL"
    }
  ]
}
