{
  "$schema": "../../../../templates/contract.schema.json",
  "schemaVersion": 3,
  "kind": "service-definition",
  "scope": "system",
  "id": "LOG",
  "router_key": 41,
  "alias": "Logs and errors",
  "description": "What ESP_LOG prints, whether also to the console, whether reported error chains are traced, and the board's ring buffer of latest error records.",
  "category": "system",
  "record": "SYS_ACTIONS_ID_LOG",
  "commands": [
    {
      "id": "CONFIG",
      "op": 1,
      "symbol": "LOG_OP_CONFIG",
      "label": "Log and error output options",
      "description": "Read or update the three log output options: level, serial console mirror and error log tracing.",
      "read": {
        "returns": {
          "struct": "sys_log_cfg_t",
          "fields": [
            {
              "id": "level",
              "label": "Log level",
              "description": "How much the board logs: a line of this level or a more severe one goes out. Above the firmware's maximum (CONFIG_LOG_MAXIMUM_LEVEL) is refused.",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "options": [
                {
                  "label": "None",
                  "value": 0
                },
                {
                  "label": "Error",
                  "value": 1
                },
                {
                  "label": "Warn",
                  "value": 2
                },
                {
                  "label": "Info",
                  "value": 3
                },
                {
                  "label": "Debug",
                  "value": 4
                },
                {
                  "label": "Verbose",
                  "value": 5
                }
              ]
            },
            {
              "id": "mirror_serial",
              "label": "Mirror to serial",
              "description": "On: the log lines are also printed on the console UART / USB-Serial-JTAG; off: only out of the LOGS port.",
              "type": "choice",
              "control": "switch",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "options": [
                {
                  "label": "Off",
                  "value": 0
                },
                {
                  "label": "On",
                  "value": 1
                }
              ]
            },
            {
              "id": "trace_errors",
              "label": "Trace errors to logs",
              "description": "On: every reported error chain is also printed as log lines; off: only its error record.",
              "type": "choice",
              "control": "switch",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "options": [
                {
                  "label": "Off",
                  "value": 0
                },
                {
                  "label": "On",
                  "value": 1
                }
              ]
            }
          ]
        }
      },
      "write": {
        "args": {
          "struct": "sys_log_cfg_t",
          "fields": [
            {
              "id": "level",
              "label": "Log level",
              "description": "How much the board logs: a line of this level or a more severe one goes out. Above the firmware's maximum (CONFIG_LOG_MAXIMUM_LEVEL) is refused.",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "options": [
                {
                  "label": "None",
                  "value": 0
                },
                {
                  "label": "Error",
                  "value": 1
                },
                {
                  "label": "Warn",
                  "value": 2
                },
                {
                  "label": "Info",
                  "value": 3
                },
                {
                  "label": "Debug",
                  "value": 4
                },
                {
                  "label": "Verbose",
                  "value": 5
                }
              ],
              "default": 3
            },
            {
              "id": "mirror_serial",
              "label": "Mirror to serial",
              "description": "On: the log lines are also printed on the console UART / USB-Serial-JTAG; off: only out of the LOGS port.",
              "type": "choice",
              "control": "switch",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "options": [
                {
                  "label": "Off",
                  "value": 0
                },
                {
                  "label": "On",
                  "value": 1
                }
              ],
              "default": 0
            },
            {
              "id": "trace_errors",
              "label": "Trace errors to logs",
              "description": "On: every reported error chain is also printed as log lines; off: only its error record.",
              "type": "choice",
              "control": "switch",
              "raw_type": "u8",
              "size": 1,
              "offset": 2,
              "options": [
                {
                  "label": "Off",
                  "value": 0
                },
                {
                  "label": "On",
                  "value": 1
                }
              ],
              "default": 1
            }
          ]
        }
      }
    },
    {
      "id": "ERRORS",
      "op": 2,
      "symbol": "LOG_OP_ERRORS",
      "label": "Read error history",
      "description": "Returns [u8 total][error record] for the kept error record at index (0 = oldest); returns only [u8 total] when index >= total.",
      "read": {
        "args": {
          "struct": "sys_log_errors_args_t",
          "fields": [
            {
              "id": "index",
              "label": "Index",
              "type": "integer",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "description": "0 = the oldest kept error record"
            }
          ]
        },
        "returns": {
          "type": "bytes",
          "label": "Total count and error record",
          "description": "u8 total kept count followed by the packed error record (up to ERR_RECORD_MAX bytes), or just u8 total if index is past the end."
        }
      }
    }
  ]
}
