menu "device_esp32s3_uart"

    config ESP32S3_UART_ISR_RX_BUF
        int "ESP-IDF UART RX driver buffer size (bytes)"
        default 4096
        range 256 16384
        help
          Per-port RX ring buffer allocated by esp_driver_uart (> 128 B HW FIFO)
          so flash writes / NVS pauses do not overflow RX.

    config ESP32S3_UART_EVT_QUEUE_LEN
        int "ESP-IDF UART event queue length"
        default 16
        range 8 64
        help
          Queue entries allocated by esp_driver_uart for UART_DATA and error
          interrupt notifications.

    config ESP32S3_UART_TX_QUEUE
        int "TX queue per port (bytes)"
        default 4096
        range 1088 16384
        help
          Must be a multiple of 4 and hold at least two max frames
          (2 * 524 = 1048 B). SPARE sends fail with ERR_UART_BUSY once past half.

    config ESP32S3_UART_RX_QUEUE
        int "RECEIVE queue per port (bytes)"
        default 2048
        range 544 16384
        help
          Messages kept for RECEIVE / TRANSACT while the port has no reader
          (when full, the oldest goes). A multiple of 4, at least one
          512-byte message (520 B).

    config ESP32S3_UART_RX_TASK_STACK
        int "RX task stack size (bytes)"
        default 4096
        range 2048 16384

    config ESP32S3_UART_TX_TASK_STACK
        int "TX task stack size (bytes)"
        default 3072
        range 2048 16384

    config ESP32S3_UART_RX_TASK_PRIO
        int "RX task priority"
        default 10
        range 1 24

    config ESP32S3_UART_TX_TASK_PRIO
        int "TX task priority"
        default 5
        range 1 24

endmenu
