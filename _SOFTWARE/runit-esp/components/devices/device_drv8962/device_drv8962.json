{
  "$schema": "../../../../templates/device.schema.json",
  "schemaVersion": 3,
  "kind": "device-definition",
  "id": "drv8962",
  "alias": "DRV8962 motor driver",
  "description": "Dual full-bridge (or four half-bridge) motor driver controlled through the PWM and GPIO pins of other devices, with one current limit (VREF), current sensing (IPROPI) and a fault input.",
  "type_id": 73,
  "type": {
    "symbol": "SYS_DEVICE_TYPE_DRV8962",
    "id": 73
  },
  "protocols": [
    "pwm"
  ],
  "tags": [
    "motor",
    "driver",
    "h-bridge",
    "pwm"
  ],
  "datasheet": "https://www.ti.com/lit/ds/symlink/drv8962.pdf",
  "config": {
    "struct": "drv8962_cfg_t",
    "size": 71,
    "fields": [
      {
        "id": "topology",
        "label": "Topology",
        "description": "How the four half bridges are used: the channels follow it (two full bridges: 2 channels, four half bridges: 4)",
        "offset": 0,
        "size": 1,
        "type": "enum",
        "enum": "drv8962_topology_e",
        "raw_type": "u8",
        "default": 0
      },
      {
        "id": "pin",
        "label": "Pins",
        "description": "Every signal of the chip is a pin of another device",
        "offset": 1,
        "size": 45,
        "type": "pin",
        "raw_type": "bytes",
        "pin_ref": true,
        "requires": "output",
        "optional": true
      },
      {
        "id": "pwm_freq_Hz",
        "label": "PWM frequency",
        "description": "0 selects 20 kHz; a PCA9685 channel takes at most 1526 Hz",
        "offset": 46,
        "size": 4,
        "type": "number",
        "raw_type": "u32",
        "default": 20000,
        "unit": "Hz",
        "min": 0,
        "max": 100000
      },
      {
        "id": "ripropi_ohms",
        "label": "IPROPI resistor",
        "description": "The current-sense resistor of each half bridge (OUT1..OUT4); 0 selects 3090",
        "offset": 50,
        "size": 16,
        "type": "number",
        "raw_type": "u32",
        "unit": "ohm",
        "min": 0,
        "max": 100000
      },
      {
        "id": "current_limit_mA",
        "label": "Current limit",
        "description": "The chip's chopping limit, every channel: the chip has one reference (VREF). 0 means no limit",
        "offset": 66,
        "size": 4,
        "type": "number",
        "raw_type": "u32",
        "unit": "mA",
        "min": 0,
        "max": 10000,
        "control": "slider",
        "default": 0
      },
      {
        "id": "turn_off_at_ocp",
        "label": "Brake on over-current",
        "description": "A channel over the limit is braked",
        "offset": 70,
        "size": 1,
        "type": "choice",
        "control": "switch",
        "raw_type": "u8",
        "options": [
          {
            "label": "No",
            "value": 0
          },
          {
            "label": "Yes",
            "value": 1
          }
        ],
        "default": 1
      }
    ]
  },
  "contracts": [
    "DEVICE",
    "HBRIDGE",
    "POWER_MONITOR"
  ],
  "commands": [
    {
      "id": "current_limit",
      "op": 0,
      "symbol": "DRV8962_OP_CURRENT_LIMIT",
      "pin_scoped": false,
      "label": "Current limit",
      "description": "Sets the chopping current limit of the chip, every channel (VREF)",
      "write": {
        "args": {
          "struct": "drv8962_limit_t",
          "fields": [
            {
              "id": "limit_mA",
              "label": "Current limit",
              "description": "Chopping current limit in mA, every channel (0 = no limit)",
              "type": "number",
              "raw_type": "u32",
              "size": 4,
              "offset": 0,
              "unit": "mA",
              "min": 0,
              "max": 10000,
              "control": "slider"
            }
          ]
        }
      }
    },
    {
      "id": "clear_fault",
      "op": 1,
      "symbol": "DRV8962_OP_CLEAR_FAULT",
      "pin_scoped": true,
      "label": "Clear fault",
      "description": "Clears fault latches with an nSLEEP reset pulse; the channel brakes",
      "write": {
        "args": {
          "struct": "hbridge_channel_args_t",
          "fields": [
            {
              "id": "channel",
              "label": "Channel",
              "description": "The motor channel (its topology says which)",
              "type": "pin",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            }
          ]
        }
      }
    },
    {
      "id": "fault",
      "op": 2,
      "symbol": "DRV8962_OP_FAULT",
      "pin_scoped": true,
      "label": "Fault",
      "description": "Reads whether a channel has a fault, and why",
      "read": {
        "args": {
          "struct": "hbridge_channel_args_t",
          "fields": [
            {
              "id": "channel",
              "label": "Channel",
              "description": "The motor channel (its topology says which)",
              "type": "pin",
              "raw_type": "u8",
              "size": 1,
              "offset": 0
            }
          ]
        },
        "returns": {
          "struct": "drv8962_fault_t",
          "label": "Fault info",
          "description": "Channel fault status and reason",
          "fields": [
            {
              "id": "fault",
              "label": "Fault",
              "description": "1 = fault present, 0 = no fault",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 0,
              "options": [
                {
                  "label": "No",
                  "value": 0
                },
                {
                  "label": "Yes",
                  "value": 1
                }
              ]
            },
            {
              "id": "reason",
              "label": "Reason",
              "description": "Fault reason (sys_hbridge_fault_reason_e)",
              "type": "choice",
              "raw_type": "u8",
              "size": 1,
              "offset": 1,
              "options": [
                {
                  "label": "None",
                  "value": 0
                },
                {
                  "label": "Overcurrent",
                  "value": 1
                },
                {
                  "label": "Thermal or UVLO",
                  "value": 2
                },
                {
                  "label": "External",
                  "value": 3
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "settings",
      "op": 3,
      "symbol": "DRV8962_OP_SETTINGS",
      "label": "Settings",
      "description": "The settings create takes that change live: the topology, the current limit, braking on over-current. The read answers them.",
      "read": {
        "returns": {
          "struct": "drv8962_settings_t",
          "label": "Settings",
          "fields": [
            {
              "id": "topology",
              "label": "Topology",
              "description": "How the four half bridges are used: the channels follow it (two full bridges: 2 channels, four half bridges: 4)",
              "offset": 0,
              "size": 1,
              "type": "enum",
              "enum": "drv8962_topology_e",
              "raw_type": "u8"
            },
            {
              "id": "current_limit_mA",
              "label": "Current limit",
              "description": "The chip's chopping limit, every channel: the chip has one reference (VREF). 0 means no limit",
              "offset": 1,
              "size": 4,
              "type": "number",
              "raw_type": "u32",
              "unit": "mA",
              "min": 0,
              "max": 10000,
              "control": "slider"
            },
            {
              "id": "turn_off_at_ocp",
              "label": "Brake on over-current",
              "description": "A channel over the limit is braked",
              "offset": 5,
              "size": 1,
              "type": "choice",
              "control": "switch",
              "raw_type": "u8",
              "options": [
                {
                  "label": "No",
                  "value": 0
                },
                {
                  "label": "Yes",
                  "value": 1
                }
              ]
            }
          ]
        }
      },
      "write": {
        "description": "Changes them; a new topology coasts every channel, then brakes every channel of the new one.",
        "args": {
          "struct": "drv8962_settings_t",
          "fields": [
            {
              "id": "topology",
              "label": "Topology",
              "description": "How the four half bridges are used: the channels follow it (two full bridges: 2 channels, four half bridges: 4)",
              "offset": 0,
              "size": 1,
              "type": "enum",
              "enum": "drv8962_topology_e",
              "raw_type": "u8"
            },
            {
              "id": "current_limit_mA",
              "label": "Current limit",
              "description": "The chip's chopping limit, every channel: the chip has one reference (VREF). 0 means no limit",
              "offset": 1,
              "size": 4,
              "type": "number",
              "raw_type": "u32",
              "unit": "mA",
              "min": 0,
              "max": 10000,
              "control": "slider"
            },
            {
              "id": "turn_off_at_ocp",
              "label": "Brake on over-current",
              "description": "A channel over the limit is braked",
              "offset": 5,
              "size": 1,
              "type": "choice",
              "control": "switch",
              "raw_type": "u8",
              "options": [
                {
                  "label": "No",
                  "value": 0
                },
                {
                  "label": "Yes",
                  "value": 1
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "provides": {
    "pins": {
      "count": 2,
      "modes": [
        "output"
      ],
      "labels": [
        "Bridge A (OUT1+OUT2)",
        "Bridge B (OUT3+OUT4)"
      ],
      "by_config": {
        "field": "topology",
        "variants": [
          {
            "value": 0,
            "count": 2,
            "labels": [
              "Bridge A (OUT1+OUT2)",
              "Bridge B (OUT3+OUT4)"
            ]
          },
          {
            "value": 1,
            "count": 4,
            "labels": [
              "OUT1",
              "OUT2",
              "OUT3",
              "OUT4"
            ]
          }
        ]
      }
    }
  },
  "power_pins": [
    {
      "name": "VM",
      "kind": "vin",
      "voltage_mV": {
        "min": 4500,
        "max": 65000,
        "nominal": 12000
      }
    },
    {
      "name": "GND",
      "kind": "gnd"
    }
  ],
  "electrical": {
    "supply_voltage_mV": {
      "min": 4500,
      "max": 65000,
      "nominal": 12000
    },
    "logic_voltage_mV": 3300,
    "max_current_mA": 10000
  }
}
