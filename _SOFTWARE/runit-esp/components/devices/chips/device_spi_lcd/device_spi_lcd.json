{
  "$schema": "../../../../../templates/device.schema.json",
  "schemaVersion": 3,
  "kind": "device-definition",
  "id": "spi_lcd",
  "alias": "SPI colour display",
  "description": "A colour TFT display module on SPI (ILI9341 or ST7789 controller): the board's screen engine draws on it; its backlight is dimmable by PWM.",
  "protocols": [
    "spi"
  ],
  "tags": [
    "spi",
    "display",
    "lcd",
    "tft",
    "screen",
    "module"
  ],
  "type_id": 80,
  "type": {
    "symbol": "SPI_LCD_TYPE",
    "id": 80
  },
  "bus": {
    "type": "spi",
    "spi": {
      "mode": 0,
      "max_speed_hz": 40000000
    }
  },
  "config": {
    "struct": "display_cfg_t",
    "size": 27,
    "fields": [
      {
        "id": "bus",
        "label": "SPI bus",
        "description": "The SPI bus the display is on",
        "type": "device",
        "raw_type": "u8",
        "size": 1,
        "offset": 0,
        "requires_contract": "SPI"
      },
      {
        "id": "spi_mode",
        "label": "SPI mode",
        "type": "enum",
        "enum": "sys_spi_mode_e",
        "raw_type": "u8",
        "size": 1,
        "offset": 1,
        "default": "SYS_SPI_MODE_0",
        "description": "Clock polarity and phase; mode 0 for most modules"
      },
      {
        "id": "freq_hz",
        "label": "SPI clock",
        "type": "number",
        "raw_type": "u32",
        "size": 4,
        "offset": 2,
        "min": 1000000,
        "max": 80000000,
        "default": 40000000,
        "unit": "Hz",
        "description": "Lower it when the picture is garbled on long wires"
      },
      {
        "id": "cs",
        "label": "CS pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 6,
        "pin_ref": true,
        "requires": "output",
        "optional": true,
        "description": "Chip select, an ESP32-S3 GPIO; leave unwired when the module ties it low"
      },
      {
        "id": "dc",
        "label": "DC pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 8,
        "pin_ref": true,
        "requires": "output",
        "description": "Data or command select"
      },
      {
        "id": "reset",
        "label": "Reset pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 10,
        "pin_ref": true,
        "requires": "output",
        "optional": true,
        "description": "Panel reset; leave unwired for a software reset"
      },
      {
        "id": "backlight",
        "label": "Backlight pin",
        "type": "pin",
        "raw_type": "bytes",
        "size": 2,
        "offset": 12,
        "pin_ref": true,
        "requires": "pwm",
        "optional": true,
        "description": "Backlight PWM; leave unwired when the backlight is always on"
      },
      {
        "id": "brightness_default",
        "label": "Brightness at start",
        "type": "number",
        "raw_type": "u16",
        "size": 2,
        "offset": 14,
        "min": 0,
        "max": 4095,
        "default": 4095,
        "control": "slider",
        "description": "Backlight duty after start and resume: 0 dark, 4095 full"
      },
      {
        "id": "width",
        "label": "Width",
        "type": "number",
        "raw_type": "u16",
        "size": 2,
        "offset": 16,
        "min": 1,
        "max": 240,
        "default": 240,
        "unit": "px",
        "description": "Native width of the glass (orientation 0)"
      },
      {
        "id": "height",
        "label": "Height",
        "type": "number",
        "raw_type": "u16",
        "size": 2,
        "offset": 18,
        "min": 1,
        "max": 320,
        "default": 320,
        "unit": "px",
        "description": "Native height of the glass (orientation 0)"
      },
      {
        "id": "offset_x",
        "label": "Offset X",
        "type": "number",
        "raw_type": "u16",
        "size": 2,
        "offset": 20,
        "min": 0,
        "max": 239,
        "default": 0,
        "unit": "px",
        "description": "Where the glass starts in the controller's memory, across (a glass smaller than the controller)"
      },
      {
        "id": "offset_y",
        "label": "Offset Y",
        "type": "number",
        "raw_type": "u16",
        "size": 2,
        "offset": 22,
        "min": 0,
        "max": 319,
        "default": 0,
        "unit": "px",
        "description": "Where the glass starts in the controller's memory, down"
      },
      {
        "id": "panel",
        "label": "Controller",
        "type": "choice",
        "raw_type": "u8",
        "size": 1,
        "offset": 24,
        "options": [
          {
            "label": "ILI9341",
            "value": 0
          },
          {
            "label": "ST7789",
            "value": 1
          }
        ],
        "default": 0,
        "description": "The display's controller chip"
      },
      {
        "id": "orientation",
        "label": "Orientation",
        "type": "enum",
        "enum": "sys_display_orientation_e",
        "raw_type": "u8",
        "size": 1,
        "offset": 25,
        "default": "SYS_DISPLAY_ORIENTATION_0",
        "description": "How the picture is turned at start"
      },
      {
        "id": "flags",
        "label": "Module options",
        "type": "bitmask",
        "raw_type": "u8",
        "size": 1,
        "offset": 26,
        "default": 0,
        "bits": [
          {
            "bit": 0,
            "label": "BGR colour order"
          },
          {
            "bit": 1,
            "label": "Inverted colours"
          },
          {
            "bit": 2,
            "label": "Mirror left to right"
          },
          {
            "bit": 3,
            "label": "Mirror top to bottom"
          },
          {
            "bit": 4,
            "label": "Backlight active low"
          },
          {
            "bit": 5,
            "label": "Readable (SDO wired)"
          }
        ],
        "description": "How the module differs from the controller's defaults"
      }
    ]
  },
  "presets": [
    {
      "id": "ili9341_240x320",
      "label": "ILI9341 240x320",
      "description": "The common 2.4 or 2.8 inch ILI9341 module",
      "values": {
        "panel": 0,
        "width": 240,
        "height": 320,
        "offset_x": 0,
        "offset_y": 0,
        "flags": 0
      }
    },
    {
      "id": "st7789_240x320",
      "label": "ST7789 240x320",
      "description": "2.0 inch ST7789 IPS module",
      "values": {
        "panel": 1,
        "width": 240,
        "height": 320,
        "offset_x": 0,
        "offset_y": 0,
        "flags": 2
      }
    },
    {
      "id": "st7789_240x240",
      "label": "ST7789 240x240",
      "description": "Square 1.3 or 1.54 inch ST7789 IPS module",
      "values": {
        "panel": 1,
        "width": 240,
        "height": 240,
        "offset_x": 0,
        "offset_y": 0,
        "flags": 2
      }
    },
    {
      "id": "st7789_135x240",
      "label": "ST7789 135x240",
      "description": "1.14 inch ST7789 IPS module (the glass sits at 52, 40)",
      "values": {
        "panel": 1,
        "width": 135,
        "height": 240,
        "offset_x": 52,
        "offset_y": 40,
        "flags": 2
      }
    },
    {
      "id": "st7789_170x320",
      "label": "ST7789 170x320",
      "description": "1.9 inch ST7789 IPS module (the glass sits at 35, 0)",
      "values": {
        "panel": 1,
        "width": 170,
        "height": 320,
        "offset_x": 35,
        "offset_y": 0,
        "flags": 2
      }
    }
  ],
  "contracts": [
    "DEVICE",
    "DISPLAY"
  ]
}
